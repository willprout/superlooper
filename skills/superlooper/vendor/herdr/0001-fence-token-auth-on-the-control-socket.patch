+//! Token auth for the control socket — superlooper's carried fence (issue #305).
+//!
+//! Upstream herdr deliberately exposes every capability twice (CLI + newline-JSON socket) so that
+//! scripts and agents drive it exactly like a human. That is correct for herdr's attended user,
+//! and wrong for an unattended fleet: superlooper runs untrusted worker sessions inside the panes,
+//! and stock herdr gives every one of them the whole control surface.
+//!
+//! Three facts make env hygiene alone insufficient, which is why this is a token and not a
+//! `env_remove` in the launcher:
+//!
+//! 1. the socket path is deterministic (`data_dir/herdr.sock`) AND injected into every pane;
+//! 2. the protocol is plain newline-JSON, so a pane needs no `herdr` binary to drive the fleet —
+//!    ten lines of python and a socket is enough;
+//! 3. `SOCKET_PERMISSION_MODE` (0o600) keeps out OTHER unix users, and workers are not another
+//!    user — they run as the same uid as the server.
+//!
+//! So the enforcement point is the socket itself: an unauthenticated connection is refused in
+//! `handle_connection` BEFORE dispatch, and therefore before any method can act.
+//!
+//! **Fail-open when unconfigured, by design.** With neither env var set, `expected()` is `None` and
+//! every connection is authorized — stock herdr behaviour, so upstream's own test suite still
+//! passes with this patch applied (that is the cheap signal the re-apply procedure leans on). The
+//! fence being UP is therefore not something a reader may assume; it is something superlooper
+//! proves by probing, which is what the negative test in
+//! `skills/superlooper/tests/test_fence_token_auth.py` exists to do.
+//!
+//! **Where the token may live — and why the ENV is the better of the two.** Under this threat
+//! model the reader we care about runs as the SAME uid, so "who can read it" is decided by the
+//! kernel, not by file permissions:
+//!
+//! * `HERDR_API_TOKEN` in the server's environment is NOT readable by a worker — macOS refuses a
+//!   same-uid process another process's environment (measured: `ps -Eww` returns nothing at all).
+//!   Panes would inherit it, which is what the `pane.rs` scrub exists to prevent.
+//! * `HERDR_API_TOKEN_FILE` points at an ordinary file. A worker that discovers the path can just
+//!   read it — `0600` does not exclude the same uid. It is offered for operators who have somewhere
+//!   genuinely out of a worker's reach to put it, and it is NOT the default recommendation.
+//!
+//! An earlier draft of this patch had that backwards, reasoning about inheritance while ignoring
+//! readability; the pane scrub already closes the inheritance path for both.
+
+use std::sync::OnceLock;
+
+/// The token, presented by a client on each request and held by the server. Read by BOTH sides.
+pub const API_TOKEN_ENV_VAR: &str = "HERDR_API_TOKEN";
+/// A file holding the token (trailing newlines trimmed). NOT the default recommendation — an
+/// ordinary file is readable by the same uid, which is the worker. See the module note.
+pub const API_TOKEN_FILE_ENV_VAR: &str = "HERDR_API_TOKEN_FILE";
+
+/// The JSON member a client puts the token in. Deliberately a top-level sibling of `id`/`method`
+/// so the check never has to parse, and never has to trust, the request body.
+pub const AUTH_FIELD: &str = "auth";
+
+/// What a client passes as the VALUE of `--env HERDR_API_TOKEN=…` to ask the server to give this
+/// new pane the token. It is not the secret; it is a request for the secret.
+///
+/// This exists because of a measured asymmetry on macOS: a same-uid reader is refused another
+/// process's environment but is served its argv. `workspace create --env K=V` becomes argv, so a
+/// client passing the real token would publish it to precisely the workers being fenced out. See
+/// `apply_pane_launch_env` in `pane.rs`, which is where the substitution happens.
+pub const GRANT_SENTINEL: &str = "@superlooper-fence-grant";
+
+/// The ONE method a caller may reach with no credential at all (superlooper issue #331).
+///
+/// This is the agent's own `SessionStart` state report — the call the vendor's carried hook script
+/// makes, over this same socket, to tell the server which session id to `--resume` after a crash.
+/// The hook is herdr's asset carried byte-for-byte and it presents no token, because upstream herdr
+/// has no token concept; `i<N>` worker panes deliberately hold none either. Without this allowance
+/// a fenced host captures no session id and `persist.restore` brings a crashed pane back as a bare
+/// shell — silently, because a session that cannot report its id still runs perfectly.
+///
+/// **Owner ruling, 2026-08-04:** admit this method, refuse every other one before dispatch exactly
+/// as before. Chosen over a runner-side re-report and over leaving the seam open, at the least
+/// owned code and surface.
+///
+/// **The accepted exposure, stated plainly.** A tokenless caller — any worker pane — can set the
+/// recorded session ref of ANY pane, not only its own. What that buys it is bounded by what the
+/// method does: `handle_pane_report_agent_session` writes in-memory bookkeeping that herdr later
+/// turns into `claude --resume <value>` on restore. It is not a shell string (`shell_quote` in
+/// `app/agent_resume.rs` escapes every argument) and control characters are already refused by
+/// `valid_session_id`, so the reach is "choose a revived pane's resume argument", not "run a
+/// command". Superlooper bounds the rest by doctrine rather than by more code: the host's
+/// bookkeeping is advisory (muscle, never truth), the runner's own minted-id ledger (#298) is the
+/// loop's identity truth, and a revived pane passes the same state/liveness verification as any
+/// other before the loop trusts it.
+pub const STATE_REPORT_METHOD: &str = "pane.report_agent_session";
+
+/// The error code an unauthenticated caller gets back. Callers match on this exact string.
+pub const UNAUTHORIZED_CODE: &str = "unauthorized";
+
+/// Deliberately says nothing about whether a token was presented, whether it was the wrong length,
+/// or which methods exist. A refused caller learns only that it was refused.
+pub const UNAUTHORIZED_MESSAGE: &str = "unauthorized: this socket requires a token";
+
+/// What this server was configured to expect.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Expectation {
+    /// Neither variable set: stock herdr, every connection allowed. See the module note.
+    Unconfigured,
+    /// A token this server will honour.
+    Token(String),
+    /// Explicitly pointed at a token file that could not be read, or that was empty.
+    ///
+    /// This is its own state rather than collapsing into `Unconfigured`, and the distinction is a
+    /// security one: an operator who set `HERDR_API_TOKEN_FILE` asked for a fence, and silently
+    /// downgrading their typo to "no auth at all" would leave the socket wide open at exactly the
+    /// moment they believed they had closed it. Auth stays REQUIRED and nothing can satisfy it, so
+    /// the misconfiguration is loud (every call refused) instead of invisible.
+    Misconfigured,
+}
+
+fn read_configured_token() -> Expectation {
+    // PRESENT-BUT-EMPTY IS NOT ABSENT. Throughout this function, a variable that exists is read as
+    // intent to fence, so an empty or unreadable one lands in Misconfigured rather than falling
+    // back to "no auth". The distinction only ever bites a machine whose operator meant to switch
+    // the fence ON, which is the one direction a mistake here must not go quietly.
+    if let Some(path) = std::env::var_os(API_TOKEN_FILE_ENV_VAR) {
+        if path.is_empty() {
+            return Expectation::Misconfigured;
+        }
+        return match std::fs::read_to_string(&path) {
+            // trim_end only: a leading space is a token character, a trailing newline is how
+            // every editor and `printf` ends a file.
+            Ok(contents) => vet(contents.trim_end_matches(['\r', '\n'])),
+            Err(_) => Expectation::Misconfigured,
+        };
+    }
+    match std::env::var_os(API_TOKEN_ENV_VAR) {
+        None => Expectation::Unconfigured,
+        // Non-UTF-8 is not a token anybody could present over a JSON socket, so it is a broken
+        // configuration rather than an absent one.
+        Some(raw) => match raw.to_str() {
+            Some(token) => vet(token),
+            None => Expectation::Misconfigured,
+        },
+    }
+}
+
+/// A candidate token, judged. Empty is a typo, not a secret — and the grant sentinel is PUBLIC
+/// (it travels in argv by design), so a server configured to expect it would accept the whole
+/// fleet's worth of workers as authenticated. Refuse both.
+fn vet(candidate: &str) -> Expectation {
+    match candidate {
+        "" | GRANT_SENTINEL => Expectation::Misconfigured,
+        token => Expectation::Token(token.to_string()),
+    }
+}
+
+/// What this server expects, resolved ONCE per process.
+///
+/// Once, not per connection, for two reasons: the environment of a running process does not change
+/// under it, and rotating the token is a deliberate event (restart the server) rather than a thing
+/// that should quietly take effect mid-flight on whichever connection happens to arrive next.
+pub fn expectation() -> &'static Expectation {
+    static EXPECTED: OnceLock<Expectation> = OnceLock::new();
+    EXPECTED.get_or_init(read_configured_token)
+}
+
+/// The token itself, for the one caller that must hand it onward: the pane grant in `pane.rs`.
+pub fn expected() -> Option<&'static str> {
+    match expectation() {
+        Expectation::Token(token) => Some(token.as_str()),
+        _ => None,
+    }
+}
+
+/// The token a CLIENT should present, read fresh — client processes are short-lived and a cached
+/// answer would only ever be staler than the environment they were launched with.
+pub fn client_token() -> Option<String> {
+    match read_configured_token() {
+        Expectation::Token(token) => Some(token),
+        // Nothing to present. The server will refuse, which is the correct visible outcome for a
+        // client whose token file is broken — better than presenting something that is not a token.
+        Expectation::Unconfigured | Expectation::Misconfigured => None,
+    }
+}
+
+/// Is `presented` good enough for `expected`?
+///
+/// Pure, and separated from the env reads above precisely so the decision can be tested without
+/// mutating process environment from test threads.
+pub fn authorize(expected: &Expectation, presented: Option<&str>) -> bool {
+    match expected {
+        // Unconfigured: stock herdr, everything is allowed. See the module note.
+        Expectation::Unconfigured => true,
+        // Configured and broken: nothing is allowed. Fail closed, loudly.
+        Expectation::Misconfigured => false,
+        Expectation::Token(expected) => match presented {
+            None => false,
+            Some(presented) => constant_time_eq(expected.as_bytes(), presented.as_bytes()),
+        },
+    }
+}
+
+/// The smallest thing that can be read out of a request line in order to judge it: who is asking
+/// (`id`, echoed back so a refused caller can still correlate), what they presented (`auth`), and
+/// what they are asking for (`method`, for the one allowance below).
+///
+/// Unknown members are ignored BY DESIGN — this must parse every valid request without knowing the
+/// method surface, and must never become a second place where method spellings are maintained. It
+/// lives here rather than in `server.rs` for the same reason the rest of this file does: everything
+/// in a new file is a hunk that can never conflict at a version bump, and its decisions can be
+/// unit-tested without standing up a socket.
+#[derive(Debug, Default, PartialEq, Eq, serde::Deserialize)]
+pub struct Envelope {
+    #[serde(default)]
+    pub id: Option<String>,
+    #[serde(default)]
+    pub auth: Option<String>,
+    #[serde(default)]
+    pub method: Option<String>,
+}
+
+/// Read the envelope out of a request line. A line that is not a well-formed request object at all
+/// yields the DEFAULT envelope — no token, no method — which `admit` refuses. Fail closed: garbage
+/// must never be a way past the check.
+pub fn envelope(line: &str) -> Envelope {
+    serde_json::from_str::<Envelope>(line).unwrap_or_default()
+}
+
+/// May this request run at all? The whole fence decision, in one place.
+///
+/// Two ways in, and only two: present the token, or ask for the one method that is open to
+/// everybody (`STATE_REPORT_METHOD` — see its note for the ruling and the accepted exposure).
+///
+/// The allowance does NOT vary with `Expectation`, deliberately. It is a statement about that one
+/// method's blast radius, not about the credential, so a `Misconfigured` server admits the state
+/// report exactly as a `Token` one does. That does not soften the fail-closed rule the
+/// `Misconfigured` state exists for: every verb an operator or the runner actually drives is still
+/// refused, so a typo in the token configuration is still loud.
+pub fn admit(expected: &Expectation, envelope: &Envelope) -> bool {
+    authorize(expected, envelope.auth.as_deref()) || is_state_report(envelope.method.as_deref())
+}
+
+/// Exact match, and nothing clever. No trimming, no case folding, no prefix: the vendor's hook
+/// sends this one spelling, and every variation a caller invents is somebody probing.
+fn is_state_report(method: Option<&str>) -> bool {
+    method == Some(STATE_REPORT_METHOD)
+}
+
+/// Does this server require a token at all? Used to decide whether to run the check.
+pub fn is_enforcing() -> bool {
+    !matches!(expectation(), Expectation::Unconfigured)
+}
+
+/// Compares without an early exit on the first differing byte.
+///
+/// The length check DOES leak the token's length, which is accepted: the token is a random secret
+/// of fixed length whose length is not the secret, and the alternative (hashing both sides to
+/// equalise) buys nothing against a local attacker who can already see the socket.
+fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    let mut diff = 0u8;
+    for (x, y) in a.iter().zip(b.iter()) {
+        diff |= x ^ y;
+    }
+    diff == 0
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn token(value: &str) -> Expectation {
+        Expectation::Token(value.to_string())
+    }
+
+    #[test]
+    fn unconfigured_allows_everything() {
+        assert!(authorize(&Expectation::Unconfigured, None));
+        assert!(authorize(&Expectation::Unconfigured, Some("anything")));
+    }
+
+    #[test]
+    fn a_broken_configuration_allows_nothing() {
+        // The whole point of the Misconfigured state: an operator who asked for a fence and got a
+        // typo must not silently end up with an open socket.
+        assert!(!authorize(&Expectation::Misconfigured, None));
+        assert!(!authorize(&Expectation::Misconfigured, Some("anything")));
+        assert!(!authorize(&Expectation::Misconfigured, Some("")));
+    }
+
+    #[test]
+    fn configured_refuses_a_caller_that_presents_nothing() {
+        assert!(!authorize(&token("secret"), None));
+    }
+
+    #[test]
+    fn configured_refuses_a_wrong_token() {
+        assert!(!authorize(&token("secret"), Some("guess")));
+        assert!(!authorize(&token("secret"), Some("")));
+        // A prefix must not pass: the comparison is over the whole value, not a starts_with.
+        assert!(!authorize(&token("secret"), Some("secr")));
+        assert!(!authorize(&token("secret"), Some("secretsecret")));
+    }
+
+    #[test]
+    fn configured_accepts_the_exact_token() {
+        assert!(authorize(&token("secret"), Some("secret")));
+    }
+
+    #[test]
+    fn the_grant_sentinel_is_not_a_usable_token() {
+        // It travels in argv, which any same-uid process can read. If it were ever accepted as a
+        // credential the fence would be decorative.
+        assert!(!authorize(&token("secret"), Some(GRANT_SENTINEL)));
+    }
+
+    #[test]
+    fn a_server_cannot_be_configured_to_expect_the_public_sentinel() {
+        // The other end of the same hole: expecting the sentinel would authenticate everybody.
+        assert_eq!(vet(GRANT_SENTINEL), Expectation::Misconfigured);
+    }
+
+    #[test]
+    fn an_empty_token_is_a_broken_configuration_not_an_absent_one() {
+        assert_eq!(vet(""), Expectation::Misconfigured);
+        assert!(!authorize(&vet(""), Some("")));
+        assert!(!authorize(&vet(""), None));
+    }
+
+    #[test]
+    fn a_real_token_survives_vetting() {
+        assert_eq!(vet("s3cret"), Expectation::Token("s3cret".to_string()));
+    }
+
+    // ---- the one method a tokenless caller may reach (issue #331) ---------------------------
+
+    fn asking(method: &str) -> Envelope {
+        Envelope { id: None, auth: None, method: Some(method.to_string()) }
+    }
+
+    #[test]
+    fn a_tokenless_state_report_is_admitted() {
+        // The ruling. The vendor's SessionStart hook has no token to present and never will.
+        assert!(admit(&token("secret"), &asking(STATE_REPORT_METHOD)));
+    }
+
+    #[test]
+    fn a_tokenless_caller_can_reach_nothing_else() {
+        // The other half, and the half that matters more: the allowance is one method wide.
+        for method in [
+            "ping", "server.stop", "workspace.create", "agent.start", "agent.prompt",
+            "pane.run", "pane.read", "events.subscribe", "pane.report_agent",
+            "pane.report_metadata", "pane.release_agent",
+        ] {
+            assert!(!admit(&token("secret"), &asking(method)), "{method} was admitted");
+        }
+        // …including asking for nothing at all.
+        assert!(!admit(&token("secret"), &Envelope::default()));
+    }
+
+    #[test]
+    fn only_the_exact_spelling_is_admitted() {
+        // Nothing is trimmed, folded or prefix-matched, so none of these is a way in.
+        for near_miss in [
+            " pane.report_agent_session",
+            "pane.report_agent_session ",
+            "PANE.REPORT_AGENT_SESSION",
+            "Pane.Report_Agent_Session",
+            "pane.report_agent_session2",
+            "pane.report_agent_sessio",
+            "pane.report_agent",
+            "\tpane.report_agent_session",
+        ] {
+            assert!(!admit(&token("secret"), &asking(near_miss)), "{near_miss:?} was admitted");
+        }
+    }
+
+    #[test]
+    fn the_allowance_does_not_depend_on_how_the_token_was_configured() {
+        // It is a statement about the METHOD, not about the credential. A server whose token file
+        // is broken still lets an agent report its session id — and still refuses every verb its
+        // operator drives, which is what makes the misconfiguration loud.
+        assert!(admit(&Expectation::Misconfigured, &asking(STATE_REPORT_METHOD)));
+        assert!(!admit(&Expectation::Misconfigured, &asking("ping")));
+    }
+
+    #[test]
+    fn a_presented_token_still_opens_everything() {
+        assert!(admit(&token("secret"), &Envelope {
+            id: None, auth: Some("secret".into()), method: Some("server.stop".into()),
+        }));
+    }
+
+    #[test]
+    fn a_line_that_is_not_a_request_object_is_refused() {
+        // Fail closed on garbage: no envelope, no method, no way past.
+        for line in ["", "   ", "not json", "[]", "\"pane.report_agent_session\"", "null", "7",
+                     "{\"method\":7}", "{\"method\":null}", "{"] {
+            assert_eq!(envelope(line), Envelope::default(), "{line:?} parsed as something");
+            assert!(!admit(&token("secret"), &envelope(line)), "{line:?} was admitted");
+        }
+    }
+
+    #[test]
+    fn the_envelope_ignores_everything_it_does_not_need() {
+        let parsed = envelope(
+            "{\"id\":\"7\",\"method\":\"pane.report_agent_session\",\"params\":{\"pane_id\":\"w1:p1\"},\
+             \"auth\":\"secret\",\"unknown\":{\"nested\":[1,2,3]}}");
+        assert_eq!(parsed.id.as_deref(), Some("7"));
+        assert_eq!(parsed.auth.as_deref(), Some("secret"));
+        assert_eq!(parsed.method.as_deref(), Some(STATE_REPORT_METHOD));
+    }
+
+    #[test]
+    fn the_admitted_method_is_the_one_that_would_actually_dispatch() {
+        // THE test this allowance rests on. The line is parsed TWICE — once here to judge it, and
+        // once by `server.rs` as a `Request` to run it. If those two could ever disagree about
+        // which method a line names, the allowance would be a way to smuggle a different verb past
+        // the fence: judged as the harmless report, dispatched as something else.
+        //
+        // So: for every line below that gets admitted WITHOUT a token, whatever the dispatcher
+        // makes of it must be the state report or nothing at all.
+        let report = "\"method\":\"pane.report_agent_session\"";
+        let params = "\"params\":{\"pane_id\":\"w1:p1\",\"source\":\"herdr:claude\",\
+                      \"agent\":\"claude\",\"agent_session_id\":\"x\"}";
+        let lines = [
+            // the honest one
+            format!("{{\"id\":\"1\",{report},{params}}}"),
+            // the method named twice, both orders — a duplicate key is where two parsers most
+            // easily part company
+            format!("{{\"id\":\"1\",{report},\"method\":\"server.stop\",{params}}}"),
+            format!("{{\"id\":\"1\",\"method\":\"server.stop\",{report},{params}}}"),
+            // the allowed spelling hidden somewhere the dispatcher will not look
+            format!("{{\"id\":\"1\",\"method\":\"server.stop\",\"params\":{{{report}}}}}"),
+            format!("{{\"id\":\"1\",\"method\":\"server.stop\",\"auth\":{report}}}"),
+        ];
+        for line in &lines {
+            if !admit(&token("secret"), &envelope(line)) {
+                continue;                       // refused: there is nothing to disagree about
+            }
+            let Ok(request) = serde_json::from_str::<crate::api::schema::Request>(line) else {
+                continue;                       // the dispatcher will refuse it as invalid_request
+            };
+            let rendered = serde_json::to_value(&request).expect("a Request re-serializes");
+            assert_eq!(
+                rendered.get("method").and_then(|m| m.as_str()),
+                Some(STATE_REPORT_METHOD),
+                "admitted as the state report but dispatches as something else: {line}");
+        }
+    }
+
+    #[test]
+    fn constant_time_eq_agrees_with_equality() {
+        assert!(constant_time_eq(b"", b""));
+        assert!(constant_time_eq(b"abc", b"abc"));
+        assert!(!constant_time_eq(b"abc", b"abd"));
+        assert!(!constant_time_eq(b"abc", b"ab"));
+    }
+}
