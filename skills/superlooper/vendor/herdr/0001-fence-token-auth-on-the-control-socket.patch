--- a/src/pane.rs
+++ b/src/pane.rs
@@ -111,7 +111,32 @@ impl PaneLaunchEnv {
 
 fn apply_pane_launch_env(cmd: &mut CommandBuilder, launch_env: &PaneLaunchEnv) {
     cmd.env_remove("CODEX_THREAD_ID");
+    // superlooper fence (#305). A pane inherits the SERVER's environment — everything below only
+    // ever ADDS to it — so a server holding the control-socket token in its own env would hand
+    // that token to every pane it spawned, workers included. Scrub it here, BEFORE the `extra`
+    // loop, so inheritance alone can never grant it.
+    cmd.env_remove(crate::api::auth::API_TOKEN_ENV_VAR);
+    cmd.env_remove(crate::api::auth::API_TOKEN_FILE_ENV_VAR);
     for (key, value) in &launch_env.extra {
+        if key == crate::api::auth::API_TOKEN_ENV_VAR {
+            // The GRANT, and the reason a caller may not simply pass the token itself.
+            //
+            // `workspace create --env K=V` becomes process ARGV, and on macOS a same-uid reader
+            // is refused a process's environment but served its argv (measured both ways while
+            // building this). A client that put the real token on that command line would publish
+            // it to exactly the workers the fence exists to keep out, for the lifetime of the
+            // call. So the client sends only a SENTINEL and the server substitutes the secret it
+            // already holds — the token never leaves this process.
+            //
+            // A literal value is dropped rather than honoured: nothing a caller supplies should be
+            // able to choose what this pane's credential is.
+            if value == crate::api::auth::GRANT_SENTINEL {
+                if let Some(token) = crate::api::auth::expected() {
+                    cmd.env(key, token);
+                }
+            }
+            continue;
+        }
         cmd.env(key, value);
     }
     cmd.env(crate::HERDR_ENV_VAR, crate::HERDR_ENV_VALUE);
