 fn write_request(stream: &mut LocalStream, request: &Request) -> Result<(), ApiClientError> {
-    stream.write_all(serde_json::to_string(request)?.as_bytes())?;
+    stream.write_all(serialize_request(request)?.as_bytes())?;
     stream.write_all(b"\n")?;
     stream.flush()?;
     Ok(())
 }
 
+/// superlooper fence (#305). One choke point, so that EVERY client path — `herdr agent start`,
+/// `herdr workspace create`, the status probe, all of it — presents the token without any of them
+/// having to know the token exists.
+///
+/// The token rides as a top-level `auth` member added to the serialized object rather than as a
+/// field on `Request`, which keeps this carried patch off the ~260 `Request { … }` literal sites
+/// upstream maintains. A request that is somehow not a JSON object is passed through untouched:
+/// this function's job is to attach a credential, never to become a second opinion about the wire
+/// format.
+fn serialize_request(request: &Request) -> Result<String, ApiClientError> {
+    let Some(token) = crate::api::auth::client_token() else {
+        return Ok(serde_json::to_string(request)?);
+    };
+    let mut value = serde_json::to_value(request)?;
+    let Some(object) = value.as_object_mut() else {
+        return Ok(serde_json::to_string(request)?);
+    };
+    object.insert(
+        crate::api::auth::AUTH_FIELD.to_string(),
+        serde_json::Value::String(token),
+    );
+    Ok(serde_json::to_string(&value)?)
+}
+
