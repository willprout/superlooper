# Session-close settings, kept in step with runner.py: `tidy` goes through the same doorway and the
# same exit->kill ladder as the runner's own `_close_pane`, it does not invent a second one (#334).
# PER CONTROL CALL, not per lane and not per run: a teardown makes several, and `--all` sweeps every
# terminal lane, so against a wedged host the owner can wait meaningfully longer than this number
# suggests. Bounding the whole sweep would mean leaving a half-torn-down lane, which is worse.
_CLOSE_TIMEOUT = 15

# The §C.2 label set (LABELS) and the runner-managed subset (runner_managed_labels /
# missing_runner_labels) now live in lib/labels.py and are imported above. They moved there for
# issue #160: the runner's boot migration self-heals a missing runner-managed label by CREATING it
# at boot, and it cannot import this extensionless CLI script — so the label vocabulary lives in a
# pure lib module both build on. `adopt` still owns creating + verifying the WHOLE set; the runner
# only self-heals the runner-managed subset (`in-progress` / `needs-owner` / `parked`), the labels
# the RUNNER writes as machinery whose absence storms (issue #108 / the 2026-07-13 bounce storm).

_CHECKS_REQUIREMENT = (
    "REQUIREMENT: `required_checks` must name at least one CI check that runs this repo's\n"
    "tests. A repo with no required check has NO mechanical ship gate (§4.3) — the loop would\n"
    "merge on vibes. Add the check to .superlooper/config.json AND to the branch protection.")

# Issue #26: a `required_checks` entry naming a check the repo never reports (a name typo, or a
# check reporting on PRs but never on the dev branch) reads as "pending" forever — it keeps a green
# PR gating with no merge, no park, no memo. The doctor cross-checks every name against what recent
# PRs and the dev branch have ACTUALLY reported and fails at adoption time, before 3am.
_CHECKS_NAMES_REQUIREMENT = (
    "REQUIREMENT: every `required_checks` name must EXACTLY match a check the repo actually\n"
    "reports (GitHub matches required checks by exact name — 'quality-gate' != 'Quality Gate').\n"
    "A name it never reports reads as pending forever: a green PR gates with no merge, no park.\n"
    "Fix the name in .superlooper/config.json, or wire the check to report (for the dev-branch\n"
    "case, ensure its workflow triggers on push to the dev branch, not only on pull_request).")

_STANDING_RULES_START = "<!-- loop-standing-rules:start -->"
_STANDING_RULES_END = "<!-- loop-standing-rules:end -->"
_STANDING_RULES_BLOCK = f"""\
{_STANDING_RULES_START}
## Loop Standing Rules

- Approval is the repo owner's word. `agent-ready` is never applied by an agent without that approval.
- Read the parked-issue memo before re-approving a parked issue; the memo is part of the current request.
- Reviews are performed by a fresh agent that wrote none of the code. Review prompts must name the known defect classes: shared mutable defaults; fail-open on wrong-typed input.
- No metered or paid spend without explicit owner confirmation in the current conversation.
- Never work in the loop's own checkout; work only in the target repo checkout for the approved issue.
{_STANDING_RULES_END}"""
_STANDING_RULES_START_BYTES = _STANDING_RULES_START.encode("utf-8")
_STANDING_RULES_END_BYTES = _STANDING_RULES_END.encode("utf-8")
_STANDING_RULES_BLOCK_BYTES = _STANDING_RULES_BLOCK.encode("utf-8")


def _read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def _load_config(repo_path):
    """config load + the D1 repo pin: every gh call this process makes must target config.repo,
    never whatever repo the operator's cwd happens to sit in (live dry-run 2026-07-03: a runner
    started outside the adopted repo silently talked to the wrong repo — or none). Every command
    that loads a config loads it through here."""
    cfg = config_lib.load(repo_path)
    gh.set_repo(cfg.get("repo"))
    return cfg


def _origin_repo(repo_path):
    """owner/name from the git origin remote, or None (adopt falls back to the placeholder)."""
    try:
        r = subprocess.run(["git", "-C", repo_path, "remote", "get-url", "origin"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    m = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?/?$", r.stdout.strip())
    return m.group(1) if m else None


def _seed_standing_rules(repo_path):
    """Create or update the target repo's CLAUDE.md standing-rules block."""
    path = os.path.join(repo_path, "CLAUDE.md")
    try:
        with open(path, "rb") as f:
            existing = f.read()
    except OSError:
        with open(path, "wb") as f:
            f.write(_STANDING_RULES_BLOCK_BYTES)
            f.write(b"\n")
        return "created"

    start = existing.find(_STANDING_RULES_START_BYTES)
    end = existing.find(_STANDING_RULES_END_BYTES, start + len(_STANDING_RULES_START_BYTES))
    if start >= 0 and end >= 0:
        end += len(_STANDING_RULES_END_BYTES)
        updated = existing[:start] + _STANDING_RULES_BLOCK_BYTES + existing[end:]
        if updated != existing:
            with open(path, "wb") as f:
                f.write(updated)
        return "updated"

    if existing == b"":
        sep = b""
    elif existing.endswith(b"\r\n\r\n") or existing.endswith(b"\n\n"):
        sep = b""
    elif existing.endswith(b"\r\n"):
        sep = b"\r\n"
    elif existing.endswith(b"\n"):
        sep = b"\n"
    else:
        sep = b"\r\n\r\n" if b"\r\n" in existing else b"\n\n"
    with open(path, "wb") as f:
        f.write(existing)
        f.write(sep)
        f.write(_STANDING_RULES_BLOCK_BYTES)
        f.write(b"\n")
    return "appended"


# ------------------------------- the runner's process home (issue #306) -------------------------

# The name the boot preflight asks the session host about. It is a QUESTION, never an agent: the
# only thing wanted from it is whether the host's server ANSWERS at all, and a name nothing ever
# spawns is the cheapest way to ask that without touching a live session. Reserved by shape — real
# lanes are i<N>/d<N>, so nothing can ever collide with it.
_HOST_PROBE_NAME = "slhomeprobe"


def _launchctl_bin():
    """SL_LAUNCHCTL overrides — same convention (and same reason) as SL_CMUX/SL_GH/SL_CLAUDE: it is
    what lets the test suite point every lookup at a stub instead of the real service manager, which
    can start and stop the owner's own jobs."""
    return os.environ.get("SL_LAUNCHCTL") or "/bin/launchctl"


def _launchd_dir():
    """Where user LaunchAgents live. SL_LAUNCHD_DIR overrides so an install can be exercised in a
    sandbox without writing into the real ~/Library/LaunchAgents (the same seam the dashboard's own
    installer uses)."""
    return os.environ.get("SL_LAUNCHD_DIR") or os.path.expanduser("~/Library/LaunchAgents")


def _home_uid():
    """The uid whose gui domain the job lives in: THIS process's own, and there is no way to say
    otherwise.

    There was briefly an ``SL_UID`` override here so tests could pin a uid. A fresh-agent review
    called it blocking and was right: these verbs bootstrap, bootout and kickstart launchd JOBS, so
    an override — ambient, exported for debugging, or simply wrong — points them at another user's
    login session. The keychain rule that says gui/$UID is the whole reason this home exists, and a
    rule with a runtime escape hatch is not a rule. Tests read the same uid this does.
    """
    return os.getuid()


def _resolve_command(name):
    """Resolve one of the runner's own commands the way the RUNNER resolves it — honouring the same
    SL_* override — so the PATH baked into the plist matches what the loop will actually run.

    An override that names something unrunnable resolves to NOTHING rather than falling through to
    PATH. Same rule as the coding-agent pin (#303): a pin that cannot be run is a broken pin, and
    silently using a different binary than the one the operator named is how the loop ends up
    running something nobody configured.
    """
    override = {"gh": "SL_GH"}.get(name)
    pinned = os.environ.get(override) if override else None
    if pinned:
        return pinned if os.path.isfile(pinned) and os.access(pinned, os.X_OK) else None
    return shutil.which(name)


def _manager_name():
    """What `launchctl managername` calls this process's session ("Aqua" for both an interactive
    shell and a gui/$UID LaunchAgent). "" when it cannot be asked — which the preflight refuses,
    because this home is launchd-hosted by definition."""
    try:
        proc = subprocess.run([_launchctl_bin(), "managername"], capture_output=True, text=True,
                              timeout=10)
    except (OSError, subprocess.SubprocessError):
        return ""
    return (proc.stdout or "").strip() if proc.returncode == 0 else ""


def _host_answered():
    """Did the session host's server answer — asked THROUGH THE WRAPPER, never around it?

    ``state`` is the read-only verb, and it is the whole probe: it returns ``name_resolves=False``
    when the host SPOKE (a structured "no such agent" for our reserved name) and ``None`` when the
    call never got through at all. That distinction is exactly the question, and asking it this way
    means the runner's boot needs no second door to the host.

    True or None, never False. Both non-True answers refuse the boot, but they refuse it with
    different words, and only one of them is honest here: everything this function can observe —
    a timeout, a missing binary, the wrapper itself raising — is "we got no answer", never
    "something answered and said no". Reporting the wrong one sends the operator looking at the
    wrong end of the connection (fresh-agent review).
    """
    try:
        import session_host
        spoke = session_host.SessionHost().state(_HOST_PROBE_NAME).name_resolves is not None
    except Exception:
        # The wrapper raising here would take the boot down with the host it was asking about.
        return None
    return True if spoke else None


def _login_item_facts():
    """Everything the login-item preflight judges, read once. Impure by design — the verdict itself
    is pure and lives in ``runner_home.preflight``."""
    found, missing = runner_home.resolve_commands(_resolve_command)
    return {"found": found,
            "manager": _manager_name(),
            "missing": missing,
            # gh.probe() is the engine's own "reachable AND authenticated right now" read and it is
            # free (`api rate_limit` is exempt from rate limiting). None only when gh is not there
            # at all — which `missing` has already named, so the message does not repeat itself.
            "gh_ok": gh.probe() if "gh" not in missing else None,
            "host_answered": _host_answered()}


def _login_item_preflight():
    facts = _login_item_facts()
    ok, why = runner_home.preflight(manager=facts["manager"], missing=facts["missing"],
                                    gh_ok=facts["gh_ok"], host_answered=facts["host_answered"])
    return ok, why, facts


def _runner_plist_path(job_label):
    return os.path.join(_launchd_dir(), job_label + ".plist")


def cmd_runner_home(args):
    """Report — and, with --install, create — the runner's own process home (issue #306).

    Read-only by default. The two flags are deliberately separate verbs in one place:

    ``--install`` renders the LaunchAgent for the login-item home and PLACES it, then prints the one
    command that activates it (``--load`` runs that command too). It refuses the pane home outright:
    there is no job to install for a home that IS a visible tab, and quietly rendering one would
    re-create exactly the impossible mode issue #33 deleted.

    ``--verify`` runs the same preflight ``superlooper run`` runs at boot, and nothing else. That is
    what makes it useful from INSIDE the job — bootstrap a one-shot agent that runs this and you
    have read the context the runner will actually get, keychain and PATH included, rather than the
    one your terminal has.
    """
    cfg = _load_config(args.repo)
    home = runner_home.kind(cfg)
    if home != runner_home.LOGIN_ITEM:
        print("runner_home: %s — this repo's runner lives in a visible tab that a person opens; "
              "its pane is the launch anchor every worker session is born in." % home)
        print("  Start it with: superlooper run --repo %s (from inside that tab)"
              % os.path.abspath(args.repo))
        if args.install or args.verify:
            print("FATAL: there is no launchd job to install or verify for the `pane` home. Set "
                  "`runner_home: \"login-item\"` in .superlooper/config.json first.",
                  file=sys.stderr)
            return 2
        return 0

    job_label = runner_home.label(cfg["repo"])
    uid = _home_uid()
    plist = _runner_plist_path(job_label)

    if args.verify:
        ok, why, facts = _login_item_preflight()
        print("runner_home: %s\n  %s" % (home, why))
        return 0 if ok else 2

    if args.install:
        found, missing = runner_home.resolve_commands(_resolve_command)
        if missing:
            # Refuse rather than bake launchd's own four entries into the plist: the job would come
            # up, look alive, and fail every GitHub read. An install that cannot be honest about
            # PATH is worse than no install.
            print("FATAL: cannot resolve %s on this PATH, so there is no honest PATH to record in "
                  "the job. Install them (or set SL_GH), then re-run." % ", ".join(missing),
                  file=sys.stderr)
            return 2
        state = str(config_lib.state_home(cfg))
        os.makedirs(os.path.join(state, "logs"), exist_ok=True)
        os.makedirs(_launchd_dir(), exist_ok=True)
        text = runner_home.render_plist(
            label=job_label, superlooper_bin=os.path.abspath(__file__),
            repo_path=os.path.abspath(args.repo), state_home=state,
            path=runner_home.launch_path(sorted({os.path.dirname(p) for p in found.values()})),
            # A relocated state base must ride along, or the job builds a second, empty state home
            # under the default while its own log still points at this one (found by driving it).
            state_base=os.environ.get("SL_HOME") or None)
        # tmp + replace, like every other write in this engine: a half-written plist in
        # LaunchAgents is a job launchd may try to parse.
        tmp = plist + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, plist)
        print("wrote %s" % plist)
        for name, path in sorted(found.items()):
            print("  PATH carries %-4s from %s" % (name, os.path.dirname(path)))
        argv = runner_home.bootstrap_argv(_launchctl_bin(), uid, plist)
        if args.load:
            subprocess.run(runner_home.bootout_argv(_launchctl_bin(), uid, job_label),
                           capture_output=True, text=True, timeout=30)
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=30)
            if proc.returncode != 0:
                print("FATAL: %s\n%s" % (" ".join(argv[1:]), (proc.stderr or proc.stdout).strip()),
                      file=sys.stderr)
                return 2
            print("loaded — the runner starts now and at every login.")
            return 0
        print("to activate:  %s" % " ".join(argv[1:]))
        print("to stop:      %s" % " ".join(runner_home.bootout_argv(
            _launchctl_bin(), uid, job_label)[1:]))
        return 0

    print("runner_home: %s\n  job:   %s\n  domain: %s\n  plist: %s%s"
          % (home, job_label, runner_home.domain(uid), plist,
             "" if os.path.exists(plist) else "  (not installed — run with --install)"))
    proc = subprocess.run(runner_home.print_argv(_launchctl_bin(), uid, job_label),
                          capture_output=True, text=True, timeout=15)
    # Same three-way answer the doctor gives, and for the same reason (confirmation review): a
    # status line that prints "not running" about a job it could not READ is how a dark runner
    # comes to look merely idle. Only the service's own word earns that phrase.
    if proc.returncode != 0:
        # Only launchd NAMING this service absent means absent — the same rule (and the same
        # measured rcs) as _service_view. A domain error, an I/O error or a timeout all exit
        # nonzero and say nothing about the job, and "not loaded" is the reassuring direction.
        out = (proc.stdout or "") + (proc.stderr or "")
        live = ("not loaded in %s" % runner_home.domain(uid) if _NO_SUCH_SERVICE_RE.search(out)
                else "unknown — launchctl could not be read (%s); ask it yourself: %s"
                     % (out.strip().splitlines()[-1] if out.strip() else "rc %d" % proc.returncode,
                        " ".join(runner_home.print_argv("launchctl", uid, job_label))))
    else:
        pid = runner_home.service_pid(proc.stdout)
        if pid:
            live = "pid %d" % pid
        elif runner_home.service_is_idle(proc.stdout) is True:
            live = "not running (the job says so)"
        else:
            live = ("unknown — the job reported neither a pid nor a state this build recognises; "
                    "read it with: %s"
                    % " ".join(runner_home.print_argv("launchctl", uid, job_label)[1:]))
    print("  live:  %s" % live)
    return 0


# ------------------------------- fleet -------------------------------

def _state_base():
    return os.environ.get("SL_HOME") or os.path.expanduser("~/.superlooper")


def _arm_machine_env(announce=True):
    """Give THIS process the environment the machine's own build-up declares (issue #355).

    The launch pre-flight (#326) reads `SL_FLEET_FENCE` off the runner's process, and until this
    existed nothing in the engine set it — so the gate shipped correct and INERT on the fleet
    machine it was built for, and arming it was a step someone had to remember. This is the seam
    that removes the remembering: the build-up writes `<prefix>/environment`, and a runner booting
    on that machine picks it up. `_run_script` merges the launcher's env OVER `os.environ`, so
    every launch this runner makes inherits it.

    **Both homes, one mechanism.** Which home a runner lives in (`runner_home`: a visible pane
    today, a login item optionally) is a per-repo decision and explicitly not this seam's to make.
    Baking the switch into a LaunchAgent would arm exactly one of them and leave today's default
    silently unarmed — which is this issue's own failure mode wearing a different hat.

    Silent on a machine that never ran the build-up: no file, no switch, no gate, and no new line
    explaining a fence that workstation does not have. ``announce=False`` silences the stdout line
    for a caller whose stdout is a MACHINE-readable answer (`superlooper resume --json`) — warnings
    still go to stderr, where they belong either way.

    **It never raises.** This runs before `_load_config` on a process whose whole job is to keep
    running, and the thing it reads is a text file the docs invite an operator to hand-edit — so
    an undecodable byte or any other surprise must become a warned, fail-CLOSED arming rather than
    a traceback that stops the runner from starting at all and then repeats on every resurrect
    (fresh-agent review, P0).
    """
    try:
        _apply_machine_env(announce)
    except _MachineEnvApplied:
        # The declaration ALREADY landed and something after it — a print onto a closed stdout, say
        # — blew up. Stamping the fail-closed default here would overwrite a machine that had just
        # successfully declared `off` (fresh-agent review round 2), so this path stops at the
        # warning below and changes nothing.
        print("WARNING: this machine's fleet environment was applied, but reporting it failed.",
              file=sys.stderr)
    except Exception as e:                                                   # noqa: BLE001
        # Fail CLOSED, but only for a machine that actually declared something. The existence of
        # the file is the declaration, so a dev workstation stays exactly as unarmed as it was even
        # when this path is reached for a reason that has nothing to do with the file — arming one
        # would refuse every launch on a machine that never opted in.
        #
        # LITERALS, not `session_host.FENCE_REQUIRED_VAR` (same review): a handler whose own first
        # act is an import cannot be the handler for an import that failed, and "it never raises"
        # has to hold without conditions on the way a runner's boot goes wrong.
        path = os.path.join(_state_base(), "fleet", "environment")
        if not os.path.exists(path):
            print("WARNING: could not read this machine's fleet environment (%s); nothing declared "
                  "one, so nothing was armed." % e, file=sys.stderr)
            return
        os.environ["SL_FLEET_FENCE"] = "required"
        print("WARNING: %s could not be applied (%s) — arming the launch gate anyway "
              "(SL_FLEET_FENCE=required) rather than starting a runner whose posture is unknown."
              % (path, e), file=sys.stderr)


class _MachineEnvApplied(Exception):
    """Raised when the machine's declaration is already in `os.environ` and the failure came after.

    Not a control-flow flourish: the difference decides whether the fail-closed stamp above
    overwrites a machine that deliberately, and successfully, declared itself `off`.
    """


def _apply_machine_env(announce=True):
    import fleet
    import session_host

    prefix = fleet.prefix(_state_base())
    assignments, problem, ignored = fleet.load_machine_env(stack_doctor.Probe(), prefix)
    if not assignments:
        return
    applied = {}
    try:
        # INSIDE the guard, so a PARTIAL apply is already "the declaration landed" (fresh-agent
        # review). With one variable in ENV_VARS this cannot happen — the single assignment either
        # lands or it does not — but the day a second one is added, a half-applied file taking the
        # generic handler's path would stamp `required` over a machine that had just declared off.
        applied, replaced = fleet.apply_machine_env(os.environ, assignments)
        path = fleet.env_file(prefix)
        # Read BACK out of this process's environment, through the PRE-FLIGHT's own parser rather
        # than from the file we just read. The line is then evidence about what a launch will
        # actually see — which is the question — instead of a restatement of what a file says.
        required, unrecognised = session_host.fence_required(os.environ)
        value = os.environ.get(session_host.FENCE_REQUIRED_VAR)
        if announce:
            print("fleet machine: %s=%s (from %s) — %s"
                  % (session_host.FENCE_REQUIRED_VAR, value, path,
                     "an i<N> launch probes the session host's control socket first and refuses an "
                     "unfenced one" if required else
                     "the launch pre-flight is DISARMED on this machine, deliberately and in "
                     "writing"))
        if problem:
            print("  WARNING: %s %s" % (path, problem), file=sys.stderr)
        if unrecognised:
            print("  WARNING: %r is not a value this engine recognises — it reads as %r, because a "
                  "switch typo that read as 'off' would be a silently disarmed fence."
                  % (unrecognised, session_host.FENCE_REQUIRED), file=sys.stderr)
        for key, was in sorted(replaced.items()):
            # The machine's own declaration beats an ambient variable (see apply_machine_env), and
            # it says so: an operator who exported that value has to be able to see it lose. On a
            # caller whose stdout is a machine-readable answer this goes to STDERR rather than
            # being dropped (fresh-agent review) — "a variable that lost is never a variable that
            # vanished" has to hold on every path, not only the one with a human reading it.
            print("  note: this process arrived carrying %s=%r; the machine's own file wins."
                  % (key, was), file=sys.stdout if announce else sys.stderr)
        if ignored and announce:
            print("  note: %s also names %s, which a runner never applies (it may set only %s)."
                  % (path, ", ".join(sorted(set(ignored))), ", ".join(fleet.ENV_VARS)))
    except Exception:                                                        # noqa: BLE001
        # The declaration is already applied (or partly so); everything else in the block is
        # REPORTING. Say which side of that boundary the failure fell on, so the caller does not
        # undo a good apply — and re-raise untouched when nothing landed at all.
        if applied:
            raise _MachineEnvApplied()
        raise


def _write_once(path, text, marker, what, merge_text=None):
    """Write `text` to `path` unless somebody else's file is already there.

    The build-up writes into the HOST's own config directory, which is shared with whatever
    sessions the operator already runs on this machine — so an install that simply overwrote would
    silently delete their settings. A file carrying our marker is ours to rewrite (that is what
    makes `--install` idempotent); anything else is refused with its content named, and the doctor
    block for it stays red until a person decides.

    Returns "wrote", "kept" or "refused".
    """
    existing = None
    try:
        with open(path) as f:
            existing = f.read()
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        # NOT absence (fresh-agent review). A file we could not READ is a file we could not prove
        # we own, and treating the failure as "nothing is there" turns a permissions problem, an
        # ACL or a broken symlink into permission to overwrite somebody else's file.
        # `ValueError` covers the undecodable one: every file this writes is text an operator may
        # edit, and one editor round-trip through a non-UTF-8 encoding used to take the whole
        # command down with a traceback instead of refusing the one file (#355 review).
        print("  REFUSED %s: %s exists but could not be read (%s), so it cannot be shown to be "
              "ours to rewrite." % (what, path, e))
        return "refused"
    if existing is not None and marker not in existing:
        print("  REFUSED %s: %s already exists and was not written by superlooper, so it is "
              "not ours to rewrite — merge these lines into it by hand:" % (what, path))
        # `merge_text`, not `text` (fresh-agent review round 2). `text` carries the ownership
        # marker, and printing it invites the operator to paste the marker into a file they
        # maintain — after which the NEXT install would read it as ownership and replace the whole
        # thing. What a refusal hands over is the SETTINGS; the file stays theirs, and the block
        # for it stays red until they say otherwise.
        for line in (merge_text or text).rstrip("\n").splitlines():
            print("    | %s" % line)
        print("    (superlooper will keep refusing to manage this file, which is the point — the "
              "block for it stays red until you decide it is done.)")
        return "refused"
    if existing == text:
        return "kept"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # A UNIQUE temp name in the same directory, not `<path>.tmp` (fresh-agent review): a fixed
    # sidecar is itself a file this command promised not to clobber, and `<config>.tmp` is exactly
    # what a hand-merge or an editor recovery leaves lying around. Same directory so the replace
    # stays atomic (a cross-filesystem rename is not).
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".sl-fleet-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return "wrote"


def cmd_fleet(args):
    """Report — and, with --install, create — the fleet machine's build-up (issue #309).

    Read-only by default, and the default is the point: every property the build-up has to satisfy
    is one that is silently wrong while the machine still looks alive (an unfenced socket answers,
    a host one release off the pin starts, a fleet config dir spelled with a trailing slash simply
    reports logged-out). So `superlooper fleet` is a judge with an exit code, and `--install` is the
    separate act that makes it green.

    What `--install` deliberately does NOT do: build the host (that needs the source checkout and a
    Rust toolchain — `vendor/herdr/build.sh`), overwrite a config file somebody else wrote, or
    register the viewer. The viewer is a terminal program, so it cannot be a LaunchAgent, and since
    #302 measured the pinned build restoring hosted agents with no client attached it is no longer
    load-bearing — it ships as an artefact the owner may register, never as something an install
    silently adds to their login.
    """
    import fleet
    import session_host

    probe = stack_doctor.Probe()
    state_base = _state_base()
    prefix = fleet.prefix(state_base)
    host_config_dir = session_host.config_dir()
    host_state_dir = session_host.state_dir()
    # The dir a LAUNCH would actually assign, read through the same function the spawn seam uses
    # (#314) — never a default invented here. A judge that fell back to `~/.claude-fleet` when the
    # machine names nothing would report a green identity for a directory no worker will ever be
    # pointed at, which is the same confident lie in reverse. Unconfigured is a RED line with the
    # variable named in its fix, because the fleet machine is supposed to name it.
    fleet_config_dir, _dir_problem = fleet.identity.worker_config_dir(os.environ)
    if _dir_problem:
        # Judge the RAW value, not the None a refused canonicalisation returns: "no fleet config
        # dir is configured" for a variable that IS configured — just not canonically — would send
        # the operator to set something they already set.
        fleet_config_dir = os.environ.get(fleet.identity.FLEET_DIR_VAR)
    uid = _home_uid()
    home = os.path.expanduser("~")

    if args.install:
        # Judged BEFORE anything is written or loaded (fresh-agent review round 2). The report at
        # the end would catch a stock or wrong-version binary — but only after --load had already
        # started it, which is a real open control socket on a real machine for as long as it takes
        # somebody to read the red line. Fail-closed means refusing before the launch.
        binary = fleet.host_binary(prefix)
        ready = fleet.check_host_binary(probe, prefix)
        if not ready.ok:
            print("FATAL: %s\n  Fix: %s\n"
                  "Nothing was written or started. `vendor/herdr/build.sh` is what produces a host "
                  "this command will configure; it needs the SOURCE checkout, because the fence "
                  "patch is a build input and never ships inside the published payload."
                  % (ready.detail, ready.fix or "build it first"), file=sys.stderr)
            return 2
        print("superlooper fleet --install")
        for d in (os.path.join(prefix, "bin"), fleet.log_dir(prefix)):
            os.makedirs(d, exist_ok=True)

        token = fleet.token_file(prefix)
        if not os.path.lexists(token):
            # 0600 before the secret is in it: creating world-readable and then chmod-ing leaves a
            # window where the fence's whole secret is readable. O_EXCL so a race cannot land the
            # secret in a file that appeared underneath us.
            fd = os.open(token, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            minted = secrets.token_urlsafe(32) + "\n"
            with os.fdopen(fd, "w") as f:
                f.write(minted)
            # The digest, never the secret — the sidecar exists to prove origin, not to hold a
            # second copy of the thing the fence protects.
            with open(fleet.token_provenance_file(prefix), "w") as f:
                f.write(fleet.token_provenance(minted) + "\n")
            print("  minted %s (0600)" % token)
        elif not os.path.islink(token) and os.path.isfile(token):
            with open(token) as f:
                held = f.read()
            recorded = None
            try:
                with open(fleet.token_provenance_file(prefix)) as f:
                    recorded = f.read().strip()
            except OSError:
                pass
            if recorded != fleet.token_provenance(held):
                # An UNVOUCHED or CHANGED token is refused rather than adopted: a file left here by
                # an aborted install, by an older prefix, or by anything else becomes the fence's
                # secret otherwise, without anyone deciding it should. This is an integrity record,
                # NOT authentication — see token_provenance_file, and #342 for the real question.
                print("FATAL: %s does not match the token this build-up minted (no matching record "
                      "at %s, or the file has changed since). Rather than adopt a secret nobody "
                      "chose, this refuses: move it aside and re-run to mint a fresh one."
                      % (token, fleet.token_provenance_file(prefix)), file=sys.stderr)
                return 2
            os.chmod(token, 0o600)
            print("  kept %s (0600, minted here)" % token)
        else:
            # `lexists` above, `islink` here (fresh-agent review round 2): a SYMLINK at this path
            # would have `os.path.exists` follow it, `chmod` change the permissions of whatever it
            # points at, and launchd hand the server a secret of somebody else's choosing. The
            # token's provenance is the fence's whole basis, so an unexpected object here is
            # refused rather than adopted.
            print("FATAL: %s is not a regular file (it is a symlink or a directory). The fence "
                  "token's provenance is the fence itself — move it aside and re-run."
                  % token, file=sys.stderr)
            return 2

        # The machine's own declaration that its runners enforce the fence (issue #355). Written
        # before the host config because it is the one artefact here that changes what a LAUNCH
        # does rather than what the server is, and an operator reading this output top to bottom
        # should meet it beside the token it is the other half of.
        env_path = fleet.env_file(prefix)
        # KEEPING a value the machine already declared, rather than stamping `required` back over
        # it (fresh-agent review): the file and docs offer exactly one supported edit — change it
        # to `off` — and a re-install is a build-up step after a version bump, not a decision about
        # this machine's posture. An install that silently reverted the edit would make the
        # instruction false the first time anybody followed it.
        held = None
        try:
            with open(env_path) as f:
                held = f.read()
        except (OSError, ValueError):
            pass
        wrote = _write_once(env_path,
                            fleet.render_env_file(fleet.keep_declared_fence(held)),
                            fleet.ENV_MARKER, "runner environment",
                            # SETTINGS only in a refusal, exactly as the host config does: the
                            # rendered file's first line IS the ownership marker, and inviting an
                            # operator to paste it into a file they maintain would have the NEXT
                            # install read it as ownership and replace the whole thing.
                            merge_text="%s=%s\n" % (session_host.FENCE_REQUIRED_VAR,
                                                    fleet.keep_declared_fence(held)))
        if wrote != "refused":
            print("  %s %s (%s the launch pre-flight for every runner on this machine)"
                  % (wrote, env_path,
                     "arms" if fleet.keep_declared_fence(held) == "required" else "DISARMS"))

        cfg_path = fleet.host_config_path(host_config_dir)
        wrote = _write_once(cfg_path, fleet.render_host_config(), fleet.CONFIG_MARKER, "config",
                            merge_text=fleet.host_config_settings())
        if wrote != "refused":
            print("  %s %s" % (wrote, cfg_path))

        source = probe.read_text(session_host.remote_manifest_path(host_state_dir, args.agent))
        override = fleet.override_path(host_config_dir, args.agent)
        if source is None:
            print("  SKIPPED %s: the host has no cached manifest for %r to snapshot. Start the "
                  "host once so it fetches one, then re-run — the `screen fallback` block below "
                  "stays red until then." % (override, args.agent))
        else:
            wrote = _write_once(override, fleet.render_manifest_override(source),
                                fleet.CATCHALL_RULE_ID, "manifest override")
            if wrote != "refused":
                print("  %s %s" % (wrote, override))

        plist = fleet.server_plist_path(home)
        found, missing = runner_home.resolve_commands(_resolve_command)
        if missing:
            # Refuse rather than bake launchd's own four entries in: the server would come up, look
            # alive, and hand every pane it spawns a PATH with no Homebrew and no ~/.local/bin.
            print("FATAL: cannot resolve %s on this PATH, so there is no honest PATH to record in "
                  "the job." % ", ".join(missing), file=sys.stderr)
            return 2
        os.makedirs(_launchd_dir(), exist_ok=True)
        text = fleet.render_server_plist(
            binary=binary, session=fleet.SESSION_NAME, token_file=token,
            log_dir=fleet.log_dir(prefix),
            path=runner_home.launch_path(sorted({os.path.dirname(p) for p in found.values()})))
        # Through the SAME door as the shared config (fresh-agent review): our launchd label is
        # not proof the plist under it is ours. An operator's own experiment, or a hand-tuned job,
        # is exactly what "never clobber a file it did not write" has to protect.
        wrote = _write_once(plist, text, fleet.PLIST_MARKER, "server job")
        if wrote == "refused":
            return 2
        print("  %s %s" % (wrote, plist))

        viewer = fleet.viewer_command(prefix)
        wrote = _write_once(viewer, fleet.render_viewer_command(binary=binary,
                                                                session=fleet.SESSION_NAME),
                            fleet.VIEWER_MARKER, "viewer script")
        if wrote != "refused":
            os.chmod(viewer, 0o755)
            print("  %s %s (register it as a Login Item yourself if you want the window)"
                  % (wrote, viewer))

        argv = runner_home.bootstrap_argv(_launchctl_bin(), uid, plist)
        if args.load:
            subprocess.run(runner_home.bootout_argv(_launchctl_bin(), uid, fleet.SERVER_LABEL),
                           capture_output=True, text=True, timeout=30)
            # A bounded retry, found by driving this for real: launchd answers a bootstrap issued
            # while it is still tearing the old job down with `Input/output error` (5), which reads
            # like a broken plist and is not one. One retry after a beat is the whole cure.
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=30)
            if proc.returncode != 0:
                time.sleep(2)
                proc = subprocess.run(argv, capture_output=True, text=True, timeout=30)
            if proc.returncode != 0:
                print("FATAL: %s\n%s" % (" ".join(argv[1:]),
                                         (proc.stderr or proc.stdout).strip()), file=sys.stderr)
                return 2
            print("  loaded — the host starts now and at every login.")
            # A server that has not finished binding is UNREACHABLE, and the fence block is right
            # to refuse to read that as anything good — so wait for its first answer rather than
            # print a red line this command created one second earlier.
            fleet.wait_for_fence(fleet.socket_path(host_config_dir))
        else:
            print("  to activate:  %s" % " ".join(argv[1:]))
            print("  to stop:      %s" % " ".join(runner_home.bootout_argv(
                _launchctl_bin(), uid, fleet.SERVER_LABEL)[1:]))
        print()

    print("superlooper fleet: %s" % prefix)
    results = fleet.check_fleet(probe, state_base=state_base, host_config_dir=host_config_dir,
                                fleet_config_dir=fleet_config_dir, uid=uid, home=home,
                                agent=args.agent,
                                live_manifest_version=fleet.manifest_version(
                                    probe.read_text(session_host.remote_manifest_path(
                                        host_state_dir, args.agent))))
    for line in stack_doctor.format_results(results):
        print(line)
    failures = [r.name for r in results if not r.ok]
    if failures:
        print("\nFLEET NOT READY: %s" % ", ".join(failures))
        return 1
    warnings = [r.name for r in results if getattr(r, "warn", False)]
    print("\nfleet build-up complete%s"
          % (" (warnings: %s)" % ", ".join(warnings) if warnings else ""))
    return 0


# ------------------------------- run -------------------------------

def cmd_run(args):
    from runner import Runner, preflight_pane, detect_self_anchor
    # BEFORE anything else this process does (issue #355): the machine's own declaration is part of
    # this runner's environment, and every launch it makes inherits that environment. A dev
    # workstation that never ran the fleet build-up is untouched by this call.
    #
    # HERE, at the LIVE runner's process entrypoint — not in `Runner.__init__` — for exactly the
    # reason `gh.set_telemetry` sits on the next lines rather than in the constructor: this mutates
    # process-global state, and only the long-lived runner should carry it. A Runner built inside a
    # unit test or a one-shot CLI command must not silently acquire a machine's launch posture.
    _arm_machine_env()
    cfg = _load_config(args.repo)
    fetch_usage = None
    fake = os.environ.get("SL_FAKE_USAGE")
    if fake:
        # test/simulation seam (Task 15's offline harness): never touch the Keychain/endpoint
        fetch_usage = lambda: json.loads(fake)
    agent = args.agent or cfg.get("agent", "claude")
    if runner_home.kind(cfg) == runner_home.LOGIN_ITEM:
        # The login-item home (issue #306). No anchor is detected and none is wanted: this runner
        # is an ordinary gui/$UID process, and asking the multiplexer to identify a tab it is not in
        # would answer "" and then fail a preflight that has nothing to do with this home's health.
        r = Runner(repo=args.repo, config=cfg, pane="", agent=agent, fetch_usage=fetch_usage)
        gh.set_telemetry(r.home)
        print(f"superlooper run: repo={args.repo} state={r.home} home=login-item agent={r.agent}")
        # The port of the pane home's D7 refusal, one line below where that refusal lives. The
        # faults are different — a non-Aqua session, launchd's four-entry PATH, a dead gh login, a
        # silent session host — but the rule is the same one, paid for the same way: a runner that
        # starts wrong aborts every launch and burns every issue's retry cap while looking alive.
        ok, why = _login_item_preflight()[:2]
        if not ok:
            print("FATAL: %s" % why, file=sys.stderr)
            print("Check the job with: superlooper runner-home --repo %s --verify"
                  % os.path.abspath(args.repo), file=sys.stderr)
            return 2
        print("  %s" % why)
        return r.run(max_ticks=args.ticks)
    # Anchor resolution (owner request 2026-07-06 — never hardcode a pane): one cmux `identify`
    # names the tab THIS `superlooper run` is executing in — its pane (the `new-surface` target) and
    # the workspace/window it lives in. An explicit --pane / $SL_PANE still wins for the pane; the
    # workspace/window come from identify regardless (they describe where the runner actually IS).
    # Empty only when started outside cmux with no override — preflight then fails hard.
    anchor = detect_self_anchor()
    pane = args.pane or os.environ.get("SL_PANE") or anchor["pane"]
    src = ("--pane" if args.pane else "$SL_PANE" if os.environ.get("SL_PANE")
           else "this cmux tab" if pane else "(none)")
    r = Runner(repo=args.repo, config=cfg, pane=pane, agent=agent,
               workspace=anchor["workspace"], window=anchor["window"], fetch_usage=fetch_usage)
    # GitHub API-burn telemetry (issue #15): enable it here, at the LIVE runner's process entrypoint —
    # not in Runner.__init__ — so the sole long-lived per-repo gh writer records its burn while
    # one-shot CLI commands (doctor/status/adopt) and Runner unit tests stay silent. Every gh
    # subprocess the tick loop runs then lands one bounded row under `<state_home>/gh-telemetry-runner.jsonl`.
    gh.set_telemetry(r.home)
    # Anchor identity in the boot line (issue #33): the pane is WHAT worker tabs are born in;
    # workspace/window name WHERE — so a runner started in the wrong cmux window (the 2026-07-09
    # focused-window misplacement) is visible at a glance, not an opaque pane UUID that fits any
    # window. Show whichever of workspace/window cmux resolved; omit the rest (no empty noise).
    loc = "".join(f" {k}={v}" for k, v in (("workspace", r.workspace), ("window", r.window)) if v)
    print(f"superlooper run: repo={args.repo} state={r.home} pane={r.pane or '(unset)'} "
          f"[{src}]{loc} agent={r.agent}")
    # D7: fail HARD before the loop if cmux is unreachable or the pane won't resolve. A quiet
    # warning here once let a mis-started runner silently abort every launch and burn every
    # issue's retry cap (live dry-run 2026-07-03/04) — so this refuses to start instead.
    ok, why = preflight_pane(r.pane)
    if not ok:
        print(f"FATAL: {why}", file=sys.stderr)
        print("Start `superlooper run` INSIDE a visible cmux tab — it targets that tab's own pane "
              "automatically (no --pane needed). Only pass --pane / $SL_PANE to override.",
              file=sys.stderr)
        return 2
    # Runner-managed label migration + every other pending per-repo migration is applied INSIDE
    # run() at boot (issue #160, extending #108's direction): the runner CREATES a missing
    # runner-managed label — an already-approved, already-installed migration step, not new code
    # execution — instead of #108's fail-loud refusal, and it applies the #58 needs-william ->
    # needs-owner rename. It HOLDS with a legible systemic hold + one notification only if a
    # migration cannot be applied, rather than letting the loop run against an un-migrated repo and
    # storm a failing write every tick. It lives in run() (after the singleton is won) so only the
    # LIVE runner ever mutates labels — a duplicate/preflight-failing start never does.
    return r.run(max_ticks=args.ticks)


# ------------------------------- request-restart (issue #116) -------------------------------

def _emit_restart(args, result):
    """Print a request-restart result: one JSON object when ``--json`` (for a local ops UI over the
    loop to parse), else a plain human line for a terminal operator."""
    if getattr(args, "json", False):
        sys.stdout.write(json.dumps(result) + "\n")
        return
    if result.get("requested"):
        sys.stdout.write("restart requested — the live runner (pid %s) will %s after the current "
                         "tick.\n" % (result.get("pid"), result.get("how", "restart itself")))
    elif result.get("running"):
        sys.stdout.write("a runner is live for this repo (pid %s).\n" % result.get("pid"))
    else:
        sys.stdout.write("no runner is live for this repo — nothing to restart.\n  %s\n"
                         % result.get("manual"))


def cmd_request_restart(args):
    """Ask the LIVE runner to restart ITSELF in its own cmux tab (issue #116). A local ops UI over
    the loop shells this (exactly as it shells ``superlooper tidy``); it can also be run by hand.

    It NEVER launches or places a tab: it only drops a request marker in the state home that a
    RUNNING runner honors between ticks by re-exec'ing in place (a fresh process image that reloads
    the installed engine and clears in-memory episode state). With no live runner it makes no attempt
    to resurrect one — resurrecting a dead loop is out, because a runner must run in a visible cmux
    tab a human opened and automated tab placement is owner-ruled out (2026-07-09). It refuses and
    names the one-line manual start instead.

    ``--check`` reports whether a live runner exists and writes NOTHING (the button's preflight);
    ``--json`` emits one JSON object for the dashboard; ``--operator``/``--source`` are audit fields
    recorded in the marker (the runner journals them when it honors the restart)."""
    from runner import live_runner_pid, write_restart_request
    cfg = _load_config(args.repo)
    state_dir = os.path.join(str(config_lib.state_home(cfg)), "state")
    # The manual remedy and the description of what a restart DOES are both home-dependent (issue
    # #306), and printing the wrong one is the D12 defect class this engine has already paid for:
    # an ops instruction that names a tab, read at 3am on a machine whose runner is a launchd job.
    if runner_home.kind(cfg) == runner_home.LOGIN_ITEM:
        job_label = runner_home.label(cfg["repo"])
        manual = "restart the login-item job: %s" % " ".join(
            runner_home.kickstart_argv(_launchctl_bin(), _home_uid(), job_label)[1:])
        how = "exit cleanly and be restarted by its supervisor"
    else:
        manual = "open a cmux tab and run: superlooper run --repo %s" % os.path.abspath(args.repo)
        how = "restart itself in its own cmux tab"
    pid = live_runner_pid(state_dir)                      # None ⇒ stale/absent pidfile ⇒ no live runner
    running = pid is not None

    if getattr(args, "check", False):                    # preflight only — never writes the marker
        _emit_restart(args, {"ok": True, "verb": "request-restart", "running": running,
                             "pid": pid, "requested": False, "manual": manual, "how": how})
        return 0

    if not running:                                      # dead-runner case — launch/place NOTHING
        _emit_restart(args, {"ok": False, "verb": "request-restart", "running": False, "pid": None,
                             "requested": False, "manual": manual, "how": how,
                             "error": "no runner is live for this repo — nothing to restart"})
        return 1

    # Bind the marker to the pid we just saw live, so a runner that dies before honoring it can't
    # have a freshly-started replacement (a new pid) spuriously honor it (fresh-agent review).
    write_restart_request(state_dir, {"requested_at": int(time.time()), "target_pid": pid,
                                      "source": args.source or "cli", "operator": args.operator})
    _emit_restart(args, {"ok": True, "verb": "request-restart", "running": True, "pid": pid,
                         "requested": True, "manual": manual, "how": how})
    return 0


# ------------------------------- stop / start (issue #239) -------------------------------
#
# The deliberate off switch, and the deliberate way back on.
#
# `request-restart` above is a request to a runner that is UP. This pair is about a runner that
# should be DOWN, which in the login-item home is a different problem entirely: there is no tab to
# Ctrl+C, launchd's KeepAlive restarts even a clean exit, and the watchdog's resurrection path
# restarts anything that slips past launchd. Exiting the process is therefore not a stop — it is a
# restart with extra steps. A stop has to say two things at once, and both halves live here:
#
#   1. the SUPERVISOR is held. The job is booted OUT of the gui domain, because launchd cannot
#      restart a job it no longer has. (Deliberately not `launchctl disable`: that writes to a
#      per-user override database outside the state home, survives an engine reinstall, and would
#      make a later `runner-home --install --load` fail with a message about a service nobody
#      remembers disabling. The cost of not using it is bounded and stated in `stop`'s own output:
#      the job is bootstrapped again at the owner's next LOGIN.)
#   2. the GUARDIANS are told. A stop marker in the state home records that this was deliberate —
#      who and when — and the watchdog reads it and stands down. Without it, a stop is exactly the
#      shape of a crash (stale heartbeat, no live runner), and the watchdog is built to fix that
#      shape at 3am.
#
# The marker is written BEFORE anything is taken down, and cleared by any runner that boots
# (runner.py's run()), so the switch can neither miss its own window nor latch permanently.

# The WHOLE take-down's budget — one deadline shared by the bootout call, the wait for the job to
# leave the domain, and the wait for the process to go. Shared rather than one window each, because
# these are three views of a single event and separate windows put them out of order: `bootout`
# BLOCKS until the service is torn down, and the service cannot leave the domain until the process
# exits, so a job window shorter than the process window reports "the job is still loaded" about a
# job that is mid-teardown (fresh-agent review).
#
# The runner honours SIGTERM at the safe point BETWEEN ticks, so the budget covers one sleep
# (TICK_SECONDS) plus the tail of a tick already in flight. THIS verb never escalates to SIGKILL —
# but launchd does (fresh-agent review): the shipped job sets no `ExitTimeOut`, so a login-item
# runner that has not exited within launchd's own default is hard-killed, well inside a long tick.
# That is survivable by construction — the runner reconciles from GitHub and disk on every boot,
# which is the same guarantee a crash already rests on — and it is stated here rather than promised
# away, because "it stops at the end of its tick" is not something this verb can honestly offer in
# the home it exists for.
_STOP_WAIT_SECONDS = 30
# launchd's own EINPROGRESS: a boot-out is UNDER WAY rather than refused — the answer to a second
# `stop` while the first is still tearing down. It does not mean "launchd will restart this", which
# is the only thing this verb's failure verdict is about, so it is not a failed stop.
#
# Our OWN timeout (124) is deliberately NOT in here (fresh-agent review). It is not something
# launchd said — it is us giving up on the read — and reading it as "a teardown is under way" would
# print "runner stopped" over a wedged launchd that never started one, after which KeepAlive
# restarts the runner and the reborn runner clears the marker. The off switch, silently defeated,
# behind a success message. 124 is unknown, and unknown is not held.
_BOOTOUT_IN_PROGRESS = 36
# How long the JOB's own state is polled for after the boot-out returns. Short, because by then
# launchd has already done the work — `bootout` blocks through the teardown — so this is a
# confirmation, not a wait. The exception is an in-progress teardown, which gets the whole budget
# because that is the case where the answer genuinely changes.
_JOB_CONFIRM_SECONDS = 5

# launchd naming THIS service as absent — the ONLY reading that means "the job is not loaded". See
# _service_view for why nothing weaker qualifies.
_NO_SUCH_SERVICE_RE = re.compile(r"could not find service", re.I)
# How long `start` waits for the bootstrapped job to report a pid before saying so.
_START_WAIT_SECONDS = 20


def _launchctl(argv, timeout=30):
    """Run one launchctl verb. ``(rc, text)`` — rc 126 for "could not even be run", so a caller
    never mistakes an unreachable service manager for a service that answered."""
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, "%s timed out after %ds" % (" ".join(argv[1:]), timeout)
    except OSError as e:
        return 126, "could not run %s (%s)" % (argv[0], e)
    return proc.returncode, ((proc.stdout or "") + (proc.stderr or "")).strip()


def _service_view(job_label):
    """``(loaded, pid)`` for a runner job, where BOTH may be ``None`` for "could not be read".

    The three-way answer is the same one the doctor and `runner-home` give, and for the same reason:
    a stop that reports "the job is gone" because it could not ASK is the fabricated history this
    codebase treats as its cardinal sin. Only launchctl's own word earns that phrase.

    Which makes the DOMAIN failure its own answer (fresh-agent review). ``print`` exits 113 both for
    "no such service in this domain" — the fact we want — and for "could not find domain", which is
    what a run from outside the Aqua session gets, and which says nothing at all about the service.
    Reading the second as the first turns "I could not reach launchd" into "your runner is stopped",
    reported to an owner going to bed."""
    rc, out = _launchctl(runner_home.print_argv(_launchctl_bin(), _home_uid(), job_label),
                         timeout=15)
    if rc in (124, 126):
        return None, None
    if rc != 0:
        # POSITIVE-ONLY, and the polarity is the whole point (fresh-agent review). Measured on
        # macOS 25.2: a missing SERVICE is rc 113 with `Could not find service "<label>" in domain
        # for user gui: <uid>`, while a missing DOMAIN is rc 112 with `Could not find domain for
        # user gui: <uid>` — and beyond those two there is an open set (an I/O error, a permissions
        # refusal, a future wording). Treating "not rc 0" as "the job is gone" turns every one of
        # them into "your runner is stopped", told to an owner going to bed. So only launchd
        # naming THIS SERVICE as absent counts; everything else is unknown.
        if _NO_SUCH_SERVICE_RE.search(out or ""):
            return False, None
        return None, None
    return True, runner_home.service_pid(out)


def _wait_pid_gone(pid, seconds):
    """Poll until that ONE recorded pid is gone, or the window closes. By pid, never by name or
    pattern: a pattern that matches the owner's own processes is how a stop becomes an incident."""
    end = time.time() + seconds
    while True:
        if not _pid_alive(pid):
            return True
        if time.time() >= end:
            return False
        time.sleep(0.25)


def _process_age_seconds(pid):
    """How long that pid has been running, per ``ps -o etime=``, or None when it cannot be read.

    ``[[DD-]HH:]MM:SS`` is the POSIX shape. None is UNKNOWN and every caller here treats it as
    such — this is corroboration, not a gate, and a `ps` that cannot be read must not turn into a
    refusal to stop a perfectly real runner."""
    try:
        proc = subprocess.run(["/bin/ps", "-o", "etime=", "-p", str(pid)],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    text = (proc.stdout or "").strip()
    if proc.returncode != 0 or not text:
        return None
    days, _, rest = text.rpartition("-")
    parts = rest.split(":")
    if not all(p.strip().isdigit() for p in parts) or not 2 <= len(parts) <= 3:
        return None
    if days and not days.strip().isdigit():
        return None
    secs = 0
    for p in parts:
        secs = secs * 60 + int(p)
    return secs + (int(days) * 86400 if days else 0)


# How much younger than its own pidfile a process may be and still be believed to be the runner
# that wrote it. The runner writes the lock immediately after start, so the honest gap is under a
# second; the window is only here so a slow boot or a clock nudge cannot refuse a real stop. A
# RECYCLED pid is typically hours or days younger, which is what this catches. Kept SMALL on a
# fresh-agent review: nothing rewrites runner.lock after the singleton is won, so every extra
# second of slack is a second of the very window this exists to close.
_PID_AGE_SLACK = 30


def _stop_signalable(state_dir, pid):
    """``(ok, why)`` — may this verb SIGTERM that recorded pid?

    `stop` is the first path in this engine that SIGNALS the pidfile's number rather than merely
    reading it, and a pidfile outlives a hard crash: after a SIGKILL or a power cut the lock still
    names a pid the OS is free to hand to something else. Signalling it then kills whatever the
    owner happens to be running — the 2026-07-07 collateral kill, arrived at from a different
    direction. So the number has to be corroborated first, the way this repo corroborates everywhere
    else (stack_doctor's anchor rule, the dashboard's product claim): a pid alone is a number
    anything could hold.

    Two independent facts, and both must fail to reach a refusal:

      * the runner's OWN record. ``runner.home.json`` is a positive self-claim ("I am a runner, my
        pid is N"), written only while the singleton is held and removed on clean exit;
      * the process's AGE. A runner is never younger than the pidfile naming it. A recycled pid is.
        Unreadable age is UNKNOWN and does not refuse on its own — corroboration, not a gate.
    """
    rec = _read_json_file(os.path.join(state_dir, "runner.home.json"), None)
    claimed = rec.get("pid") if isinstance(rec, dict) else None
    if claimed != pid:
        return False, ("the runner's own record does not claim pid %s (runner.home.json says %s) — "
                       "that pidfile outlived its runner, and the pid may belong to something else "
                       "now" % (pid, claimed if claimed is not None else "nothing"))
    age = _process_age_seconds(pid)
    if age is not None:
        try:
            lock_age = time.time() - os.path.getmtime(os.path.join(state_dir, "runner.lock"))
        except OSError:
            lock_age = None
        if lock_age is not None and age + _PID_AGE_SLACK < lock_age:
            return False, ("pid %s has only been running %ds but the pidfile naming it is %ds old — "
                           "the runner died and the OS handed its pid to something else"
                           % (pid, age, int(lock_age)))
    return True, None


def _stop_journal(home, record):
    """Journal one stop/start record, swallowing a write failure — `_debug_journal`'s posture, for
    the same reason: this call sits AFTER a stop that already happened, and turning it into a
    traceback with no result body would tell the owner the loop is still running when it is not."""
    try:
        journal.append(home, record)
    except (OSError, ValueError):
        print("stop: could not write the journal record (the stop itself stands)", file=sys.stderr)


def _emit_stop(args, result):
    if getattr(args, "json", False):
        sys.stdout.write(json.dumps(result) + "\n")
        return
    if not result.get("ok"):
        sys.stdout.write("STOP INCOMPLETE — %s\n" % result.get("error"))
        if result.get("marker"):
            # Deliberately NOT "so the watchdog will not resurrect it": the watchdog honours the
            # marker only about a runner that is actually gone, and this branch is the case where it
            # is not. Reassurance here would be the fabrication the failure itself is about. The
            # record OUTLIVING the failure is said out loud for the same reason — it takes effect
            # the moment this runner does go down, including if it goes down by crashing.
            sys.stdout.write("  the stop is still RECORDED (%s): a runner that is still running is "
                             "still watched, but once this one does go down — for any reason — the "
                             "record stands and the watchdog will not restart it. "
                             "`superlooper start` withdraws it.\n" % result.get("marker"))
        if result.get("job_state") == "gone":
            # The half that DID work, said out loud: a stop that booted the job out and then
            # declined to signal a pid is not the same failure as one that changed nothing.
            sys.stdout.write("  the job %s IS booted out of %s — launchd is not the problem here.\n"
                             % (result.get("job"), result.get("domain")))
        sys.stdout.write("  %s\n" % result.get("remedy", ""))
        return
    sys.stdout.write("runner stopped.\n" if result.get("process_gone")
                     else "stop recorded — the runner has not gone yet.\n")
    sys.stdout.write("  marker:   %s  (deliberate — the watchdog stands down while it is there)\n"
                     % result.get("marker"))
    if result.get("job"):
        sys.stdout.write("  job:      " + {
            "gone": "%s is booted out of %s — launchd has nothing to restart until your next login",
            "tearing_down": "launchd is still tearing %s out of %s — it is on its way out, and a "
                            "job being removed is not a job that gets restarted",
            "loaded": "%s is STILL loaded in %s — this stop did not hold it",
            "unconfirmed": "the boot-out of %s from %s was accepted, but launchctl could not be "
                           "read back to confirm the job is gone",
        }[result.get("job_state", "unconfirmed")] % (result["job"], result.get("domain")) + "\n")
    if not result.get("was_running"):
        sys.stdout.write("  process:  no runner was live for this repo — the stop is recorded "
                         "anyway, which is the half that keeps it down\n")
    elif result.get("process_gone"):
        sys.stdout.write("  process:  pid %s is gone\n" % result.get("pid"))
    elif result.get("signal_refused"):
        sys.stdout.write("  process:  pid %s was NOT signalled — %s\n"
                         % (result.get("pid"), result["signal_refused"]))
    else:
        sys.stdout.write("  process:  pid %s is still finishing its current tick — it stops at the "
                         "end of it, and nothing will start it again\n" % result.get("pid"))
    sys.stdout.write("  start it again with: %s\n" % result.get("start"))


def cmd_stop(args):
    """Stop this repo's runner ON PURPOSE, and make it stay stopped (issue #239).

    Three things happen, in this order, and the order is the design:

      1. the stop marker goes down FIRST, before anything can die. The gap between "the runner is
         gone" and "the reason is on disk" is exactly the gap in which a watchdog check restarts it
         and texts the owner about an outage they created — checks fire minutes apart, and this verb
         can wait half a minute for a tick to finish;
      2. the supervisor is held (login-item: the job is booted out of gui/$UID). The pane home has
         no supervisor — the runner IS the foreground process of a tab — so there is nothing to hold;
      3. the process is stopped: launchd's bootout signals it, and anything still alive after that
         gets a SIGTERM by its RECORDED pid — corroborated first — which the runner honours between
         ticks.

    It exits nonzero for two failures, and only two: launchd can still restart the job, or something
    alive holds the pidfile and this verb would not signal it. A runner still finishing a long tick
    is NEITHER — it is the designed clean stop, reported as exactly that. The whole take-down shares
    one deadline, because a job cannot leave the domain before its process exits and separate
    windows put those two facts out of order.
    """
    from runner import live_runner_pid, write_stop_marker
    try:
        cfg = _load_config(args.repo)
    except (OSError, ValueError) as e:
        # A --json caller must never get a traceback (it is a UI's only channel), and a config this
        # verb cannot read is a repo it cannot address: nothing was attempted, so nothing is
        # recorded — the marker is never written on this path.
        _emit_stop(args, {"ok": False, "verb": "stop", "home": None, "was_running": None,
                          "pid": None, "job": None, "domain": None, "held": False,
                          "job_state": None, "job_pid": None, "process_gone": False,
                          "signal_refused": None, "marker": None, "start": None,
                          "error": "this repo's .superlooper/config.json could not be read (%s), so "
                                   "nothing was taken down and no stop was recorded" % e,
                          "remedy": "fix the config, then re-run"})
        return 2
    state_home = str(config_lib.state_home(cfg))
    state_dir = os.path.join(state_home, "state")
    os.makedirs(state_dir, exist_ok=True)
    home = runner_home.kind(cfg)
    pid = live_runner_pid(state_dir)
    # Every field a --json consumer branches on is present from the start, whatever path this takes:
    # a key that appears only on some outcomes is a key a caller reads as False on the others.
    # `held` starts True for the pane home, which has no supervisor to hold and so cannot fail to.
    result = {"ok": True, "verb": "stop", "home": home, "was_running": pid is not None,
              "pid": pid, "job": None, "domain": None, "held": True, "job_state": None,
              "job_pid": None, "process_gone": pid is None, "signal_refused": None, "marker": None,
              "start": "superlooper start --repo %s" % os.path.abspath(args.repo)}
    try:
        result["marker"] = write_stop_marker(state_dir, {
            "stopped_at": int(time.time()), "operator": args.operator,
            "source": args.source or "cli", "home": home, "pid": pid})
    except OSError as e:
        # Refuse BEFORE taking anything down. A stop whose marker did not land is the shape this
        # whole verb exists to prevent — the loop goes away and the guardians read it as a crash —
        # so an unwritable state home stops the verb, not the runner. Reported through the same
        # result body as every other failure, because a --json caller must never get a traceback.
        result.update(ok=False, held=False, process_gone=False,
                      error="the deliberate-stop marker could not be written (%s), so nothing was "
                            "taken down — a stop the guardians cannot read is a crash to them" % e,
                      remedy="fix the state home at %s, then re-run" % state_dir)
        _emit_stop(args, result)
        return 1

    deadline = time.time() + _STOP_WAIT_SECONDS      # ONE budget for the whole take-down

    def _left(floor=1):
        return max(floor, deadline - time.time())

    if home == runner_home.LOGIN_ITEM:
        try:
            job = runner_home.label(cfg["repo"])
        except (KeyError, TypeError, ValueError):
            # Belt-and-braces: `config.load` above already refuses every slug this could fail on, so
            # today this is unreachable — it is here because `label()` is DOCUMENTED to raise rather
            # than sanitize, and a future caller that skips that door must not get a traceback. If it
            # ever does fire, NOTHING was attempted, so the marker comes back off: a record of a stop
            # that never reached the runner would stand on disk and quietly stand the watchdog down
            # the next time this loop dies for real.
            from runner import clear_stop_marker
            try:
                clear_stop_marker(state_dir)
            except OSError:
                pass                       # reported below either way; never a traceback to --json
            result.update(ok=False, held=False, marker=None,
                          error="cannot derive this repo's job label from `repo`, so the launchd "
                                "job cannot be addressed and nothing was taken down",
                          remedy="fix `repo` in .superlooper/config.json (owner/name), then re-run")
            _emit_stop(args, result)
            return 1
        uid = _home_uid()
        result["job"], result["domain"] = job, runner_home.domain(uid)
        # The bootout BLOCKS until the service is torn down, and the runner only honours SIGTERM
        # between ticks — so this call is given the whole remaining budget rather than a default
        # timeout that expires mid-teardown and reads as a refusal.
        rc, out = _launchctl(runner_home.bootout_argv(_launchctl_bin(), uid, job),
                             timeout=_left(5))
        # The JOB'S OWN STATE is the fact; the bootout rc is only evidence about it. They come apart
        # in both directions and the service's word wins either way: rc 113 can land on a job that
        # is already gone, and rc 36/124 mean a teardown UNDER WAY — which is not the failure this
        # verb's verdict is about. The only failure is "launchd can restart this", and launchd
        # cannot restart a job it is in the middle of removing.
        in_flight = rc == _BOOTOUT_IN_PROGRESS
        # The long budget goes where the answer can still CHANGE the verdict (fresh-agent review):
        # an accepted boot-out (rc 0) whose service has not left the domain yet is the only case
        # where waiting turns a hard failure into the truth. An in-flight teardown is already held
        # whatever the poll says, and a refused one is not going to un-refuse itself.
        # ...and it never eats the whole budget: the process wait is the other half of this verb's
        # answer, and a job poll that consumed the deadline made `stop` report "the runner has not
        # gone yet" about a process that had (fresh-agent review).
        job_deadline = min(deadline - _JOB_CONFIRM_SECONDS,
                           time.time() + (_STOP_WAIT_SECONDS if rc == 0 or in_flight
                                          else _JOB_CONFIRM_SECONDS))
        while True:
            loaded, job_pid = _service_view(job)
            if loaded is False or time.time() >= job_deadline:
                break
            time.sleep(0.25)
        result["held"] = (loaded is False) or in_flight or (loaded is None and rc in (0, 3))
        # Three different true things, said as three different sentences: launchd no longer has the
        # job / launchd is in the middle of removing it / the bootout returned ok but launchctl
        # could not be read back to confirm. Only the first has earned "booted out".
        result["job_state"] = ("gone" if loaded is False else
                               "tearing_down" if in_flight else
                               "loaded" if loaded is True else "unconfirmed")
        if not result["held"]:
            result.update(ok=False,
                          error=("the job %s is STILL loaded in %s (bootout rc=%d%s) — launchd can "
                                 "restart it, so this is not a stop"
                                 if loaded is True else
                                 "the job %s could not be confirmed gone from %s (bootout rc=%d%s, "
                                 "and launchctl could not be read back) — launchd may still restart "
                                 "it, so this cannot be called a stop")
                                % (job, result["domain"], rc, ": " + out if out else ""),
                          remedy="take it down by hand: %s" % " ".join(
                              runner_home.bootout_argv("launchctl", uid, job)))
            if job_pid:
                # Its OWN key: `pid` is the runner's, read from the pidfile, and overwriting it with
                # launchd's produced JSON that said `was_running: false, pid: 4242` in one breath.
                result["job_pid"] = job_pid
            _stop_journal(state_home, {"act": "runner_stop", "outcome": "stop_failed", "home": home,
                                       "job": job, "rc": rc, "operator": args.operator,
                                       "source": args.source or "cli"})
            _emit_stop(args, result)
            return 1

    if pid is not None:
        # Whatever budget is left goes to the process. In the login-item home launchd has already
        # sent its own SIGTERM (that is what the bootout above did and waited on), so anything still
        # alive here is a tick in flight — or a pidfile launchd is not supervising at all, which is
        # the case this verb's own signal exists for.
        gone = _wait_pid_gone(pid, 0)
        if not gone:
            may, why = _stop_signalable(state_dir, pid)
            if not may:
                result["signal_refused"] = why
            else:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    # Gone between the poll and the signal, or ours to see but not to signal. Either
                    # way the next poll is the honest answer, so nothing is claimed here.
                    pass
                gone = _wait_pid_gone(pid, _left(_JOB_CONFIRM_SECONDS))
        result["process_gone"] = gone
        if not gone and result.get("signal_refused"):
            # Something ALIVE holds the pidfile and this verb would not signal it. In the pane home
            # that is the entire take-down, so "runner stopped." over it would be a plain untruth —
            # and `ok` is the field a button reads (fresh-agent review).
            result.update(ok=False,
                          error="pid %s is alive and holds the pidfile, but it was not signalled: %s"
                                % (pid, why),
                          remedy="check what that process is; if the runner really is gone, remove "
                                 "the stale %s" % os.path.join(state_dir, "runner.lock"))
            _stop_journal(state_home, {"act": "runner_stop", "outcome": "stop_failed", "home": home,
                                       "job": result["job"], "pid": pid,
                                       "reason": "signal_refused", "operator": args.operator,
                                       "source": args.source or "cli"})
            _emit_stop(args, result)
            return 1

    _stop_journal(state_home, {"act": "runner_stop", "outcome": "stopped", "home": home,
                               "operator": args.operator, "source": args.source or "cli",
                               "pid": pid, "job": result["job"],
                               "process_gone": result["process_gone"]})
    _emit_stop(args, result)
    return 0


def _clear_stop(result, state_dir):
    """Withdraw the stop, marking `result` failed if the marker will not go.

    A marker that cannot be deleted is the off switch LATCHED — the watchdog declines to restart
    this runner from here on, silently and forever — so this is the one bookkeeping failure that
    must reach the caller rather than being swallowed (fresh-agent review)."""
    from runner import clear_stop_marker
    try:
        return clear_stop_marker(state_dir) is not None
    except OSError as e:
        result.update(ok=False, started=False,
                      error="the runner is up, but the deliberate-stop marker could not be removed "
                            "(%s) — while it is there the watchdog will not restart this runner" % e,
                      remedy="delete it by hand: %s" % os.path.join(state_dir, "runner.stopped"))
        return False


def _emit_start(args, result):
    if getattr(args, "json", False):
        sys.stdout.write(json.dumps(result) + "\n")
        return
    if not result.get("ok"):
        sys.stdout.write("START FAILED — %s\n  %s\n" % (result.get("error"),
                                                        result.get("remedy", "")))
        return
    if result.get("cleared"):
        sys.stdout.write("the deliberate stop is cleared — the watchdog watches this runner again.\n")
    if result.get("manual"):
        sys.stdout.write("  %s\n" % result["manual"])
        return
    if result.get("already_running") and result.get("job_loaded"):
        sys.stdout.write("  a runner is already live for this repo (pid %s) and its job is loaded "
                         "in %s — nothing to start.\n" % (result.get("pid"), result.get("domain")))
        return
    sys.stdout.write("  job:      %s bootstrapped into %s%s\n"
                     % (result.get("job"), result.get("domain"),
                        " (its runner was already live — launchd had lost the job)"
                        if result.get("already_running") else ""))
    sys.stdout.write("  process:  %s\n"
                     % ("pid %s" % result["pid"] if result.get("pid") else
                        "the job is loaded; it had not reported a pid yet — check `superlooper "
                        "status` in a moment"))


def cmd_start(args):
    """Clear a deliberate stop and start this repo's runner again (issue #239).

    The other half of `stop`. The marker is cleared only once something is PROVABLY RUNNING —
    never on the way in — because until then the marker is simply true, and a start that failed with
    a cleared marker is the worst state this issue can produce: a loop that is down, with its
    guardians re-armed, heading for a 3am text about an outage the owner created on purpose.

    The pane home is asymmetric because it has to be: a runner there must live in a visible tab a
    human opened, and automated tab placement is owner-ruled out (2026-07-09). So this hands back the
    one line to type, and the runner clears the stop itself when it boots.
    """
    from runner import live_runner_pid, read_stop_marker
    try:
        cfg = _load_config(args.repo)
    except (OSError, ValueError) as e:
        _emit_start(args, {"ok": False, "verb": "start", "home": None, "cleared": False,
                           "started": False, "job": None, "domain": None, "pid": None,
                           "job_loaded": None, "already_running": False, "manual": None,
                           "error": "this repo's .superlooper/config.json could not be read "
                                    "(%s), so nothing was started and any recorded stop stands" % e,
                           "remedy": "fix the config, then re-run"})
        return 2
    state_home = str(config_lib.state_home(cfg))
    state_dir = os.path.join(state_home, "state")
    os.makedirs(state_dir, exist_ok=True)
    home = runner_home.kind(cfg)
    # `started` is the field a UI branches on: True only when something is PROVABLY running. `ok`
    # alone is not enough, because the pane home succeeds at what it can do (clear the way and hand
    # back the one line) while starting nothing at all (fresh-agent review).
    result = {"ok": True, "verb": "start", "home": home, "cleared": False, "started": False,
              "job": None, "domain": None, "pid": None, "job_loaded": None,
              "already_running": False, "manual": None}

    job = plist = uid = None
    if home == runner_home.LOGIN_ITEM:
        try:
            job = runner_home.label(cfg["repo"])
        except (KeyError, TypeError, ValueError):
            result.update(ok=False,
                          error="cannot derive this repo's job label from `repo`",
                          remedy="fix `repo` in .superlooper/config.json (owner/name), then re-run")
            _emit_start(args, result)
            return 2
        uid = _home_uid()
        plist = _runner_plist_path(job)
        result["job"], result["domain"] = job, runner_home.domain(uid)
        if not os.path.exists(plist):
            # Refuse without touching the marker: the loop is off, there is no job to turn on, and a
            # cleared stop would only mean the watchdog starts trying to kickstart a job that is not
            # installed — a failed restart notification every check, about a machine that was never
            # set up.
            result.update(ok=False,
                          error="no LaunchAgent is installed for this repo at %s" % plist,
                          remedy="install it first: superlooper runner-home --repo %s --install "
                                 "--load" % os.path.abspath(args.repo))
            _emit_start(args, result)
            return 2

    if home != runner_home.LOGIN_ITEM:
        # The pane home gets no clear here WHEN THERE IS NOTHING RUNNING. This verb cannot start
        # anything — automated tab placement is owner-ruled out — so clearing would swap a respected
        # stop for a watchdog episode about a loop that is still down, which is exactly the 3am text
        # #239 exists to kill. The marker is still TRUE until a runner boots, and the runner clears
        # it itself the moment one does.
        #
        # A LIVE runner is the exception, and it has to be: `superlooper run` refuses the singleton
        # to a second instance and returns BEFORE it would clear the marker, so a stop that failed
        # to stop a pane runner leaves a marker that nothing on any path can withdraw — `status`
        # reads STOP NOT TAKEN forever, and the watchdog stands down the moment that runner finally
        # dies, over a stop the owner already withdrew (fresh-agent review). A running runner makes
        # the marker false; that is the same fact `Runner.run` clears on.
        #
        # And "a runner is live" means the SAME thing it means to `stop`: a pid its own record
        # claims, of the right age. A bare pidfile is not enough here either — `stop` refuses to
        # signal an uncorroborated pid, and a `start` that withdrew the off switch on the very
        # number `stop` had just called untrustworthy would leave the loop down with its guardians
        # re-armed, seconds apart, out of the same two files (fresh-agent review).
        pid = live_runner_pid(state_dir)
        trusted, why = _stop_signalable(state_dir, pid) if pid is not None else (False, None)
        if trusted:
            result.update(already_running=True, started=True, pid=pid)
            result["cleared"] = _clear_stop(result, state_dir)
            if result["ok"] is False:
                _emit_start(args, result)
                return 1
        result["manual"] = (
            "a runner is already live in its tab (pid %d) — nothing to start." % pid
            if trusted else
            "the pidfile names pid %d, but %s — so this changes nothing. Check what that process "
            "is; if the runner really is gone, remove the stale %s and start it in a visible cmux "
            "tab." % (pid, why, os.path.join(state_dir, "runner.lock"))
            if pid is not None else
            "now start the runner in a visible cmux tab: superlooper run --repo %s"
            " — the stop clears when it boots" % os.path.abspath(args.repo))
        _emit_start(args, result)
        return 0

    # THE JOB is what this verb starts, so the job is what it decides on (fresh-agent review). A
    # live PROCESS is not enough: `stop` deliberately decouples the two — it boots the job out and
    # may leave the runner finishing a tick — so short-circuiting on the process alone left the loop
    # running with launchd holding nothing, the marker withdrawn, and the watchdog re-armed to
    # kickstart a service that is not there. Only a job that launchd actually has counts as started.
    loaded, _job_pid = _service_view(job)
    pid = live_runner_pid(state_dir)
    if loaded is True and pid is not None:
        result.update(already_running=True, started=True, pid=pid, job_loaded=True)
        result["cleared"] = _clear_stop(result, state_dir)
        _emit_start(args, result)
        return 0 if result["ok"] else 1
    if loaded is None and pid is not None:
        # UNKNOWN is not False, and here the difference is destructive (fresh-agent review). Falling
        # through would bootstrap, be refused because the job IS loaded, and then `kickstart -k` —
        # whose `-k` HARD-KILLS the running service. That is `superlooper start` SIGKILLing a
        # perfectly healthy runner mid-tick because launchctl took too long to answer. So an
        # unreadable job state acts on nothing. The marker still goes, because a live runner is what
        # makes it false and that fact was read from the runner's own pidfile, not from launchd.
        result.update(already_running=True, pid=pid, job_loaded=None)
        result["cleared"] = _clear_stop(result, state_dir)
        result["manual"] = ("a runner is live (pid %d), but launchd could not be asked whether its "
                            "job is loaded — nothing was started, because the only way to act on "
                            "that guess is to restart the job, and `kickstart -k` would kill this "
                            "runner. Read it yourself: %s"
                            % (pid, " ".join(runner_home.print_argv("launchctl", uid, job))))
        _emit_start(args, result)
        return 0 if result["ok"] else 1

    # Read the marker BEFORE starting anything, but do not clear it yet: it is the truth until a
    # runner is up, and a start that fails must leave the loop exactly as off — and as respected —
    # as it was. (The booting runner clears it itself, so the clear below is belt-and-braces and
    # must tolerate finding nothing.)
    was = read_stop_marker(state_dir)
    result["already_running"] = pid is not None

    rc, out = _launchctl(runner_home.bootstrap_argv(_launchctl_bin(), uid, plist))
    if rc != 0 and pid is not None:
        # NEVER kickstart while a runner is ALIVE (fresh-agent review). The fallback below passes
        # `-k`, which HARD-KILLS the running service — that is what makes it the right remedy for a
        # job loaded around a dead or wedged process, and the wrong one for anything else. A
        # bootstrap can be refused for reasons that have nothing to do with the job already being
        # there (launchd's own I/O errors, a permissions refusal), and `superlooper start` reaching
        # for a SIGKILL of a healthy runner on the strength of a refused bootstrap is the single
        # most destructive thing this verb could do. The marker still goes: a live runner is what
        # makes it false, and that fact came from the runner's own pidfile, not from launchd.
        result["cleared"] = _clear_stop(result, state_dir)
        if result["ok"]:
            # Only when the clear did NOT already fail: a marker that will not delete is the
            # latched off switch, and overwriting that diagnosis with this one loses the more
            # important of the two (fresh-agent review).
            result.update(ok=False, started=False, already_running=True,
                          error="launchd would not load %s in %s (rc=%d%s) and a runner is already "
                                "live (pid %d) — this will not kickstart the job, because that "
                                "would kill it. The loop is running, but launchd is not holding it."
                                % (job, result["domain"], rc, ": " + out if out else "", pid),
                          remedy="read the job (%s); once you know why it will not load, restart "
                                 "the loop with `superlooper stop` then `superlooper start`."
                                 % " ".join(runner_home.print_argv("launchctl", uid, job)))
        result.update(started=False, already_running=True)
        _emit_start(args, result)
        return 1
    if rc != 0:
        # Already loaded around a dead or wedged process is the ordinary case here (a stop that was
        # never a bootout, someone else's `launchctl load`), and kickstart is exactly its remedy —
        # with nothing alive for its `-k` to kill.
        rc, out = _launchctl(runner_home.kickstart_argv(_launchctl_bin(), uid, job))
        if rc != 0:
            result.update(ok=False,
                          error="launchd refused to start %s in %s (rc=%d%s)"
                                % (job, result["domain"], rc, ": " + out if out else ""),
                          remedy="read the job: %s" % " ".join(
                              runner_home.print_argv("launchctl", uid, job)))
            _emit_start(args, result)
            return 1
    # A start is only a start when something is RUNNING. Poll for either proof — the job reporting a
    # pid, or the runner's own pidfile naming a live one — and treat the window closing as a
    # FAILURE, not as a slow success (fresh-agent review). Exiting 0 here would tell the button
    # wired to this verb that the loop is back when nothing came up, and would clear the stop marker
    # over a loop that is still down.
    end = time.time() + _START_WAIT_SECONDS
    while True:
        # The RUNNER's own pidfile first when one was already live: after bootstrapping over an
        # incumbent, launchd's fresh instance is the one about to lose the singleton and exit, and
        # reporting (and journaling) its pid would name the process that is going away.
        running = live_runner_pid(state_dir)
        loaded, job_pid = _service_view(job)
        if running is not None and result["already_running"]:
            result["pid"] = running
            break
        if job_pid:
            result["pid"] = job_pid
            break
        if running is not None:
            result["pid"] = running
            break
        if loaded is False:
            # `bootstrap` is synchronous: when it returns success the job IS loaded. A service that
            # is not there a moment later did not fail to start slowly — it started and died, and
            # waiting out the window would only delay saying so.
            break
        if time.time() >= end:
            break
        time.sleep(0.5)
    if result["pid"] is None:
        result.update(ok=False,
                      error="%s was accepted by launchd but nothing is running %ss later (the job "
                            "%s)" % (job, _START_WAIT_SECONDS,
                                     "is not loaded" if loaded is False else
                                     "reports no pid" if loaded is True else
                                     "could not be read"),
                      remedy="the stop is still recorded, so the loop stays respected-off; read the "
                             "job's log and %s" % " ".join(
                                 runner_home.print_argv("launchctl", uid, job)))
        _emit_start(args, result)
        return 1
    # Proven up. NOW the stop is over, and only now is `started` an honest journal record.
    result["started"] = True
    result["job_loaded"] = True
    cleared_here = _clear_stop(result, state_dir)
    if not result["ok"]:
        _emit_start(args, result)
        return 1
    result["cleared"] = cleared_here or was is not None
    if cleared_here:
        # Only when THIS call is the one that cleared it. The booting runner clears the marker and
        # journals the same landing itself, and racing it would double-count the start in the
        # journal the morning report reads.
        _stop_journal(state_home, {"act": "runner_stop", "outcome": "started", "home": home,
                                   "operator": args.operator, "source": args.source or "cli",
                                   "stopped_at": (was or {}).get("stopped_at"),
                                   "pid": result["pid"]})
    _emit_start(args, result)
    return 0


# ------------------------------- status -------------------------------

def _status_runner_line(state_dir, home):
    """WHY the runner is or is not running, in words the other states cannot produce (issue #239).

    Five answers, and the point of the verb is that they are five and not two:

      running           a live pid holds the singleton, and nobody asked for it to stop;
      STOP NOT TAKEN    a live pid AND a stop marker. Reported as the contradiction it is: a stop
                        can time out on a long tick or fail at the bootout, and rendering it as
                        "stopped" over a loop that is still merging is the fabrication this verb
                        exists to prevent (fresh-agent review);
      STOPPED BY OWNER  the marker is there and nothing is running. Checked before CRASHED, because
                        a stopped runner has exactly a crash's shape — stale heartbeat, no live
                        process — and reading the owner's own instruction as a fault is the defect
                        this closes;
      CRASHED           the pidfile names a pid that is gone, and nobody asked for that;
      not running       no pidfile at all — a clean exit nobody recorded a reason for.
    """
    from runner import live_runner_pid, read_stop_marker
    stop = read_stop_marker(state_dir)
    pid = live_runner_pid(state_dir)
    if stop is not None:
        when = stop.get("stopped_at")
        when = (time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(when))
                if isinstance(when, (int, float)) and not isinstance(when, bool) else "(unrecorded)")
        who = stop.get("operator") or stop.get("source") or "the owner"
        if pid is not None:
            return ("STOP NOT TAKEN — `superlooper stop` by %s at %s, but pid %d is STILL RUNNING. "
                    "It may be finishing a tick; if this persists the stop did not take and the "
                    "loop is still going (the watchdog still watches it)" % (who, when, pid))
        held = ("launchd will not restart it and " if home == runner_home.LOGIN_ITEM else "")
        return ("STOPPED BY OWNER — `superlooper stop` by %s at %s. %sthe watchdog will not "
                "resurrect it; `superlooper start` undoes this" % (who, when, held))
    if pid is not None:
        return "running (pid %d)" % pid
    lock = os.path.join(state_dir, "runner.lock")
    recorded = (_read(lock) or "").strip()
    if recorded.isdigit():
        return ("DOWN — CRASHED: the recorded pid %s is gone and no stop was requested" % recorded)
    if os.path.exists(lock):
        return ("DOWN — the pidfile %s holds no readable pid, so nothing can be said about how "
                "this runner ended" % lock)
    return "not running (no pidfile, and no deliberate stop was recorded)"


def cmd_status(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    state_dir = os.path.join(home, "state")
    import runner as runner_mod
    hb = _read(os.path.join(state_dir, "runner.heartbeat"))
    has_state = os.path.exists(os.path.join(state_dir, "issues.json"))
    stopped = os.path.exists(runner_mod.stop_marker_path(state_dir))
    if hb is None and not has_state and not stopped:
        print(f"no runner has ever run for this repo (state home: {home})")
        return 0
    print(f"runner: {_status_runner_line(state_dir, runner_home.kind(cfg))}")
    if hb is None:
        print(f"        no heartbeat yet   state home: {home}")
    else:
        age = int(time.time() - int(hb.strip() or 0))
        print(f"        last heartbeat {age}s ago   state home: {home}")
    alert = _read(os.path.join(home, "state", "ALERT"))
    print(f"ALERT: {alert.strip()}" if alert else "ALERT: none")
    frozen = _read(os.path.join(home, "state", "merges_frozen.json"))
    if frozen:
        try:
            reason = json.loads(frozen).get("reason")
        except ValueError:
            reason = "(unreadable marker)"
        print(f"merges: FROZEN — {reason}")
    else:
        print("merges: flowing")

    try:
        st = loopstate.load(os.path.join(home, "state", "issues.json"))
    except (OSError, ValueError):
        st = {"issues": {}}
    issues = st.get("issues") if isinstance(st.get("issues"), dict) else {}
    # The runner's OWN notion of an occupied lane, never a hand-copied set: a duplicate here
    # silently drifts from actions.py the moment the taxonomy changes (it did — the retired
    # `blocked` status, #194 — and this copy kept counting a status the runner no longer has).
    lanes = [(i, d) for i, d in sorted(issues.items()) if isinstance(d, dict)
             and d.get("status") in actions_lib.INFLIGHT_STATUSES]
    gate = [(i, d) for i, d in sorted(issues.items()) if isinstance(d, dict)
            and d.get("status") in ("gating", "holding")]
    print(f"\nlanes ({len(lanes)} occupied):")
    for iid, d in lanes or []:
        print(f"  {iid}  {d.get('status'):8}  {d.get('branch') or '-'}  "
              f"retries={d.get('retries', 0)} conflicts={d.get('conflicts', 0)}")
    if not lanes:
        print("  (empty)")
    print(f"gate ({len(gate)}):")
    for iid, d in gate or []:
        print(f"  {iid}  {d.get('status'):8}  {d.get('branch') or '-'}")
    if not gate:
        print("  (empty)")
    terminal = {}
    for i, d in issues.items():
        if isinstance(d, dict) and d.get("status") in ("merged", "parked", "needs_william",
                                                       "bounced"):
            terminal[d["status"]] = terminal.get(d["status"], 0) + 1
    print("terminal: " + (", ".join(f"{v} {k}" for k, v in sorted(terminal.items()))
                          or "(none)"))
    tail = journal.read(home)[-8:]
    print("\nrecent journal:")
    for rec in tail:
        who = rec.get("id") or rec.get("date") or ""
        print(f"  {int(rec.get('ts', 0))}  {rec.get('act'):16} {who:6} "
              f"{rec.get('outcome', '')}")
    if not tail:
        print("  (empty)")
    return 0


# ------------------------------- adopt -------------------------------

def cmd_adopt(args):
    cfg_path = os.path.join(args.repo, ".superlooper", "config.json")
    if os.path.exists(cfg_path):
        print(f"already adopted: {cfg_path} exists — config left untouched.")
    else:
        template = _read(os.path.join(_TEMPLATES, "config.example.json")) or "{}"
        cfg = json.loads(template)
        detected = _origin_repo(args.repo)
        if detected:
            cfg["repo"] = detected
            # issue #28: detect the repo's REAL default branch and write it as dev_branch. Left at
            # the template's "main", a master/develop repo fails every launch at worktree creation
            # (the base ref origin/main does not exist). Pin gh to the detected slug first so the
            # query targets THIS repo, not whatever the cwd resolves. gh unreachable -> None -> keep
            # the template default (doctor is the backstop that FAILs on a wrong guess).
            gh.set_repo(detected)
            default = gh.default_branch()
            if default:
                cfg["dev_branch"] = default
        os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
        with open(cfg_path, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        print(f"wrote {cfg_path}" + ("" if detected else
              ' — EDIT the "repo" field (no github.com origin remote to detect it from)'))

    claude_action = _seed_standing_rules(args.repo)
    print(f"{claude_action} {os.path.join(args.repo, 'CLAUDE.md')} standing-rules block")

    # D1 pin, adopt's own way: the config may be freshly written (not yet loadable through the
    # full validator) — pin gh to whatever repo slug the config carries (detected origin on a
    # fresh adopt, the operator's value on re-adopt). An undetected placeholder ("owner/name")
    # still pins: label creation then fails LOUDLY against the placeholder instead of silently
    # creating labels in whatever repo the cwd happens to be.
    raw_cfg = _read(cfg_path)
    try:
        parsed_cfg = (json.loads(raw_cfg) or {}) if raw_cfg else {}
    except ValueError:
        parsed_cfg = {}
    parsed_cfg = parsed_cfg if isinstance(parsed_cfg, dict) else {}
    slug = parsed_cfg.get("repo")
    gh.set_repo(slug)

    # operator display name (issue #58): the name every stranger-visible label description signs
    # with — an explicit `operator` in the config wins, else the repo owner's GitHub login.
    op = config_lib.operator(parsed_cfg)

    # Migration (issue #58): a repo adopted before this change carries a `needs-william` label.
    # Rename it in place to the neutral `needs-owner` — preserving it on every issue that carries it
    # — so a stranger's own audit trail stops reading another person's name. Idempotent: skipped when
    # the repo already has `needs-owner`, or never had `needs-william`. Runtime reads recognize BOTH
    # (lib/janitor.py, lib/watchdog.py, dashboard), so a repo mid-migration keeps working either way.
    have = gh.labels()
    if "needs-william" in have and "needs-owner" not in have:
        migrated = gh.rename_label("needs-william", "needs-owner")
        print(f"migrating label: {'ok  ' if migrated else 'FAIL'} needs-william -> needs-owner")

    print("creating the label set (idempotent):")
    failed = []
    for name, color, desc in LABELS:
        ok = gh.create_label(name, color, desc.replace("{operator}", op))
        print(f"  {'ok  ' if ok else 'FAIL'} {name}")
        if not ok:
            failed.append(name)

    dev = "main"
    raw = _read(cfg_path)
    if raw:
        try:
            dev = json.loads(raw).get("dev_branch") or "main"
        except ValueError:
            pass
    print(f"""
Branch protection recommendations for `{dev}` (print-only in v1 — apply by hand):
  - require a pull request before merging (the loop only ever merges PRs)
  - require status checks to pass: your `required_checks` list
  - do NOT require branches to be up to date before merging — the loop's merge policy is
    completion-order with a mechanical merge-update ladder (§4.4); a strict up-to-date rule
    just recreates the old merge train
  - keep force pushes blocked (superlooper has no force path at all)

{_CHECKS_REQUIREMENT}""")

    # Issue #29: adopt's GitHub half can fail while its file half succeeds — run before `gh auth
    # login`, every label create fails but the config is already on disk. Exiting 0 there reports
    # a success that never happened: the config names labels the runner cannot apply, and the gap
    # only surfaces later as a mysteriously idle loop (an approved issue that never gets launched).
    # So: any label create/verify failure is a HARD nonzero exit, closing with the mixed state
    # named plainly (config kept, labels pending) and the one action most likely to fix it. adopt
    # stays idempotent, so the memo can honestly promise a clean re-run.
    if failed:
        print(f"""
LABEL SETUP INCOMPLETE — {len(failed)} of {len(LABELS)} label(s) could not be created:
  {', '.join(failed)}
The config IS written and kept ({cfg_path}); the labels are PENDING. Until they exist nobody
can apply them — gh refuses to apply a label that does not exist — so an issue can't even be
marked `agent-ready` to approve it, and the loop looks mysteriously idle rather than erroring.
Most likely cause: gh is not authenticated. Run `gh auth login`, then re-run this exact
command — `superlooper adopt --repo {args.repo}` is idempotent and safe to re-run (existing
labels are updated in place, never duplicated).""")
        return 1
    return 0


# ------------------------------- doctor -------------------------------

def cmd_stack_doctor(args):
    cfg = None
    cfg_error = None
    try:
        cfg = _load_config(args.repo)
    except (FileNotFoundError, ValueError) as e:
        cfg_error = e

    print("superlooper doctor --stack")
    # repo_path feeds the installed-engine drift row: in the dogfood loop args.repo (default: cwd) is
    # itself a superlooper source checkout, which is where publish drift can be measured (issue #39).
    results = stack_doctor.check_stack(cfg, config_error=cfg_error, repo_path=args.repo)
    for line in stack_doctor.format_results(results):
        print(line)
    failures = [r.name for r in results if not r.ok]
    if failures:
        print(f"\nSTACK DOCTOR FAILED: {', '.join(failures)}")
        return 1
    warnings = [r.name for r in results if getattr(r, "warn", False)]
    if warnings:
        # A WARN never fails the stack (exit 0), but naming it in the pass line keeps "all stack
        # checks passed" honest — e.g. a Claude-only machine with no Codex installed (issue #30).
        print(f"\nall stack checks passed (warnings: {', '.join(warnings)})")
        return 0
    print("\nall stack checks passed")
    return 0


# --- the accidental-close audit (issue #229) ----------------------------------------------------
# On 2026-07-16 a ledger DOCUMENTATION commit whose message read "…fixes #189/#190…" auto-closed
# #189 — an approved, priority:high, never-built fix for the previous night's draft-promotion
# regression. The tracker said COMPLETED; worker_hook.py and gate.py were untouched; the regression
# vector stayed open for a day while recorded as fixed, and only a hand audit found it. This block
# is the standing version of that audit: it asks what CLOSED each issue, and names the ones whose
# answer is "a commit message" rather than "a merged PR".
#
# A WARN, deliberately never a FAIL. Two reasons, and they point the same way. (1) `doctor` is also
# the ADOPTION preflight for a foreign repo, and closing issues from commit messages is ordinary
# practice outside this loop — failing every adopting repo's doctor over its own normal history
# would be a false red on a healthy machine, the defect class this repo already refuses elsewhere
# (check_engine_drift, check_superlooper_plugin). (2) Nothing here is a blocker: the loop runs fine
# with a mis-closed issue in it; what was missing on 2026-07-16 was VISIBILITY. The evidence line
# is what separates the two readings — an approved loop fix that was never built leaves no
# sl/i<N> PR and no sl/i<N> branch anywhere, and the block says so per issue.
_ACCIDENTAL_CLOSE_NAME = "accidental issue closes"


# How many flagged issues the block prints in full before it summarizes. A repo that closes issues
# from commit messages as a matter of course can have hundreds, and 3 lines each would bury every
# other doctor block. The cap is STATED with the remainder, never silently applied — the count above
# it is always the true total.
_ACCIDENTAL_CLOSE_LIST_CAP = 20


def _doctor_accidental_closes():
    """Print the accidental-close audit block. Never raises and never fails the doctor — see the
    comment above for why this is a WARN. Costs ONE GraphQL read on a clean repo, plus two list
    reads only when something is actually flagged."""
    read = gh.closed_issue_closers()
    if not read.ok:
        # refused != "nothing was accidentally closed": say which one this is, or a GitHub outage
        # renders as a clean bill of health (the #21/#61 discipline, applied to a human-read line).
        print(f"  WARN {_ACCIDENTAL_CLOSE_NAME} — GitHub refused the closed-issue read; could not "
              "audit for keyword-closed issues this run. Re-run doctor.")
        return
    # Only COMPLETED closes are in scope, so only they may be counted as checked — a NOT_PLANNED
    # close never claimed the work was done and inflating the number with them would overstate
    # what the audit actually looked at.
    completed = sum(1 for r in read.value
                    if isinstance(r, dict) and r.get("stateReason") == closures.COMPLETED)
    # The window is part of the answer: an unqualified "every" is a completeness claim, and this
    # read is bounded. Say which one it is.
    window = (f"the {len(read.value)} most recently updated closed issues (older ones were NOT "
              "checked this run)" if read.truncated else f"all {len(read.value)} closed issues")
    found = closures.flagged(read.value)
    if not found:
        print(f"  ok   {_ACCIDENTAL_CLOSE_NAME} — of {window}, every one of the {completed} "
              "closed as COMPLETED has a merged PR or the owner's own hand behind it")
        return
    print(f"  WARN {_ACCIDENTAL_CLOSE_NAME} — {len(found)} of {window}: closed as COMPLETED by a "
          "bare commit-message keyword, with no merged PR behind them; each reads as fixed while "
          "nothing shipped:")
    # `ok` on BOTH reads is what licenses the evidence line's strongest sentence. A refused or
    # bound-truncated read yields the same empty list as a genuinely PR-less issue, and an
    # unproven "nothing was ever built for it" is the very failure this block exists to catch.
    pr_read, branch_read = gh.sl_head_prs(), gh.remote_branches_health()
    proven = pr_read.ok and branch_read.ok
    for f in found[:_ACCIDENTAL_CLOSE_LIST_CAP]:
        title = f" {f['title'][:60]!r}" if f["title"] else ""
        evidence = closures.evidence(f["num"], prs=pr_read.value,
                                     branches=branch_read.value, proven=proven)
        print(f"         #{f['num']}{title}")
        print(f"           closed by commit {f['commit'][:8]} "
              f"({f['headline'] or 'no commit subject'})")
        print(f"           {evidence}")
    if len(found) > _ACCIDENTAL_CLOSE_LIST_CAP:
        # No pointer to another command here: `janitor --json` shows at most REOPEN_SWEEP_CAP of
        # these, which is FEWER, and sending the owner somewhere thinner to see "the full list"
        # would be a worse lie than the cap. This block is the widest view there is.
        print(f"         …and {len(found) - _ACCIDENTAL_CLOSE_LIST_CAP} more not shown — re-run "
              "doctor after acting on these")
    print("       `superlooper janitor` proposes reopening these, with an audit comment naming "
          f"the closing commit — nothing reopens without your y/N, and it proposes at most "
          f"{janitor_lib.REOPEN_SWEEP_CAP} per sweep.")


def cmd_doctor(args):
    if getattr(args, "stack", False):
        return cmd_stack_doctor(args)

    failures = []

    def check(name, ok, detail=""):
        print(f"  {'ok  ' if ok else 'FAIL'} {name}" + (f" — {detail}" if detail else ""))
        if not ok:
            failures.append(name)

    print(f"superlooper doctor: {args.repo}")
    cfg = None
    try:
        cfg = _load_config(args.repo)
        check("config", True, "valid")
    except (FileNotFoundError, ValueError) as e:
        check("config", False, str(e))

    pr_req, dev_req, rc_union = [], [], []
    if cfg is not None:
        # required_checks may be split by surface (issue #52): the PR set gates PR merges, the dev set
        # gates the freeze/unfreeze. A flat list -> both accessors return it (back-compat).
        pr_req = config_lib.pr_required_checks(cfg)
        dev_req = config_lib.dev_required_checks(cfg)
        rc_union = sorted(set(pr_req) | set(dev_req))
        # The PR set is the mechanical ship gate (§4.3) — adoption requires at least one PR-required
        # check. The dev set MAY be empty (a repo whose CI runs on PRs only, never on dev push).
        if isinstance(cfg.get("required_checks"), dict):
            disp = ("PR: " + (", ".join(pr_req) or "(none)")
                    + " | dev: " + (", ".join(dev_req) or "(none)"))
        else:
            disp = ", ".join(pr_req)
        check("required_checks", bool(pr_req),
              "EMPTY — a repo with no CI check enforcing its tests has no mechanical "
              "ship gate (§4.3); adoption requires at least one PR-required check" if not pr_req
              else disp)

    gh_ok = gh.probe()
    check("gh (reachable + authenticated)", gh_ok)
    if cfg is not None and gh_ok:
        have = gh.labels()
        missing = [n for n, _, _ in LABELS if n not in have]
        check("labels (§C.2 set)", not missing,
              ("missing: " + ", ".join(missing)) if missing else "all present")

    # Issue #28: the worktree base is origin/<dev_branch>. If that branch does not exist on the
    # remote, EVERY launch dies at worktree creation, delivery never verifies, and the issue parks
    # with a misleading "is the launch shim installed?" memo. Catch it here, at adoption time, and
    # NAME the branch. Gated on gh_ok so a full gh outage skips the check entirely; a transient blip
    # DURING the branches call reads conservatively as "missing" (a re-runnable false FAIL on this
    # human-run check — the safe direction, see gh.branch_exists). adopt detects the default branch;
    # this validates whatever dev_branch the config actually holds.
    if cfg is not None and gh_ok:
        dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"
        dev_ok = gh.branch_exists(dev)
        check(f"dev_branch '{dev}' exists on origin", dev_ok,
              "" if dev_ok else
              f"origin has no '{dev}' branch — every worktree bases off origin/{dev}, so launches "
              f"fail before Claude starts. Set dev_branch to the repo's default (superlooper adopt "
              f"detects it) and re-run doctor")

    # Issue #26: cross-check every required_checks NAME against what the repo has actually reported
    # (recent PRs + the dev branch). A name reported nowhere reads as pending forever — a green PR
    # that never merges — and the runner has no way to know it is a typo vs a genuinely-slow check.
    # Catch it here, at adoption time, with a case/shape hint.
    names_failed = False
    if cfg is not None and gh_ok and rc_union:
        dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"
        pr_set, dev_set = set(pr_req), set(dev_req)
        pr_names = gate.check_names(gh.recent_pr_check_entries())
        dev_names = gate.check_names(gh.branch_checks(dev))
        # Audit every DECLARED name (the union of both surfaces) against what each surface reports.
        # Which set a name belongs to then decides whether a single-surface report is a problem or
        # exactly what the split intends (issue #52). audit_required_checks stays surface-symmetric;
        # the doctor owns the set-membership interpretation.
        audit = gate.audit_required_checks(rc_union, pr_names, dev_names)

        def _named(results):
            parts = []
            for r in results:
                hint = f" (did you mean {r['hint']!r}?)" if r.get("hint") else ""
                parts.append(f"{r['name']}{hint}")
            return ", ".join(parts)

        if not audit["observed"]:
            # no CI history to cross-check against (fresh repo, or gh has no PR/dev checks yet):
            # WARN, never a hard FAIL — the names cannot be proven wrong, only unverified.
            print("  WARN required_checks names — no checks observed on recent PRs or the "
                  f"'{dev}' branch yet; cannot verify the names (fresh repo?). Re-run doctor "
                  "after the first CI run.")
        else:
            results = audit["results"]
            # A name reported on NEITHER surface is a typo / never-wired check (FAIL), whatever set.
            unreported = [r for r in results if r["status"] == "unreported"]
            # dev_gap: a DEV-required name that reports on PRs but NEVER on the dev branch (status
            # pr_only) — the dev-side poll reads pending forever, so a mainline freeze never lifts
            # (the 2026-07-09 incident). Under the split a PR-only check EXCLUDED from the dev set is
            # NOT flagged — that exclusion is the whole point of issue #52.
            dev_gap = [r for r in results if r["name"] in dev_set and r["status"] == "pr_only"]
            # pr_gap: a PR-required name that reports on the dev branch but NEVER on a PR (status
            # dev_only) — every PR reads pending forever, so a green PR never merges (Codex R1).
            pr_gap = [r for r in results if r["name"] in pr_set and r["status"] == "dev_only"]
            # Each surface-gap FAILs only when the OTHER surface has reported checks (so the absence
            # is real evidence), else it degrades to a WARN.
            if unreported:
                names_failed = True
                check("required_checks names", False,
                      "reported on NO recent PR or the dev branch: " + _named(unreported))
            if dev_gap and audit["dev_observed"]:
                names_failed = True
                check(f"required_checks on '{dev}'", False,
                      "dev-required but reports on PRs and NEVER on the dev branch: " + _named(dev_gap)
                      + f" — the dev-side check poll reads pending forever; ensure the check's "
                      f"workflow triggers on push to '{dev}' (or drop it from the dev-required set)")
            elif dev_gap:
                print(f"  WARN required_checks on '{dev}' — {_named(dev_gap)} reports on PRs but "
                      f"the '{dev}' branch has no check history yet to confirm it runs there; "
                      "re-check after a dev CI run.")
            if pr_gap and audit["pr_observed"]:
                names_failed = True
                check("required_checks on PRs", False,
                      "PR-required but reports on the dev branch and NEVER on a PR: " + _named(pr_gap)
                      + " — every PR reads pending forever, so a green PR never merges; ensure the "
                      "check's workflow triggers on pull_request")
            elif pr_gap:
                print("  WARN required_checks on PRs — " + _named(pr_gap) + " reports on the "
                      f"'{dev}' branch but no recent PR has reported checks yet to confirm it runs "
                      "there; re-check after a PR CI run.")
            if not (unreported or dev_gap or pr_gap):
                print("  ok   required_checks names — every name reports on its expected surface(s)")

    # Issue #225: the queue lint — the 2026-07-16 audit, made runnable. It found 25 of 35 open
    # issues mechanically unschedulable (16 of them `agent-ready`) for want of a `type:` label or a
    # parseable `## Loop metadata`, and the owner discovered it only by noticing an expedited issue
    # sitting last on the departures board. Nothing is edited here: the lint REPORTS, remediation is
    # the janitor's propose/approve path (issue Boundaries).
    #
    # The red/amber split is the honest one. An APPROVED issue that can never launch is a live
    # wedge — the owner has said go and nothing will ever happen — so it FAILS. Every other open
    # issue with a defect is backlog hygiene: named with its exact fix, but not a broken stack, so
    # it WARNs and the doctor still passes. And an issue whose only defect does not stop a launch
    # (an area name the repo never declared) never turns the doctor red, whatever its labels: the
    # runner launches it, and the gate is what eventually reads that diff as out-of-lane.
    if cfg is not None and gh_ok:
        open_issues = gh.open_issues_all()
        areas = cfg.get("areas")
        touches_required = cfg.get("touches_required")
        wedged, backlog = [], []
        for iss in open_issues:
            defects = queue_lint.lint_issue(iss, areas=areas, touches_required=touches_required)
            if not defects:
                continue
            num = iss.get("number")
            title = iss.get("title") if isinstance(iss.get("title"), str) else ""
            head = "#%s %s" % (num, (title[:60] + "…") if len(title) > 61 else title)
            lines = ["    %s" % head] + ["      - " + queue_lint.describe(d) for d in defects]
            # The engine's own label reader, not an inline set comprehension: some gh queries
            # return labels as bare strings, and under that shape the inline version read NO
            # labels — quietly demoting a genuine `agent-ready` wedge from FAIL to WARN and
            # letting `doctor` exit 0 on a queue that cannot launch (fresh-agent review).
            approved = "agent-ready" in issues_lib._label_names(iss)
            (wedged if (approved and queue_lint.blocking(defects)) else backlog).append(lines)
        if not open_issues:
            # A refused list read and a spotless repo look identical from here, so say neither.
            print("  WARN queue lint — no open issues were readable; the queue could not be "
                  "audited (re-run once gh answers).")
        else:
            total = len(open_issues)
            if wedged:
                check("queue lint", False,
                      "%d APPROVED issue(s) can never launch as written (of %d open) — "
                      "`agent-ready` is on and the runner will never take them:"
                      % (len(wedged), total))
                for block in wedged:
                    print("\n".join(block))
            if backlog:
                print("  WARN queue lint — %d open issue(s) of %d would not launch as written "
                      "(none approved yet, so nothing is stuck today):" % (len(backlog), total))
                for block in backlog:
                    print("\n".join(block))
            if not wedged and not backlog:
                check("queue lint", True, "all %d open issues satisfy the mechanical contract"
                      % total)
        _doctor_accidental_closes()

    cmux = os.environ.get("SL_CMUX", "/Applications/cmux.app/Contents/Resources/bin/cmux")
    check("cmux binary", os.path.exists(cmux), cmux)
    check("jq", shutil.which("jq") is not None, "pretrust.sh needs it")
    shim = os.path.join(os.path.expanduser("~"), ".superlooper", "launch-shim.zsh")
    check("launch shim installed", os.path.exists(shim),
          shim if os.path.exists(shim) else f"{shim} missing — run bin/install-launch-shim.sh")
    settings = _read(os.path.join(os.path.expanduser("~"), ".claude", "settings.json")) or ""
    check("Claude activity hooks registered", "activity-hook.sh" in settings
          and "stop-hook.sh" in settings,
          "~/.claude/settings.json must register activity-hook.sh (PostToolUse) and "
          "stop-hook.sh (Stop) — bin/install.sh does this" if "activity-hook.sh" not in settings
          else "")
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
    codex_hooks = _read(os.path.join(codex_home, "hooks.json")) or ""
    codex_ok = "activity-hook.sh" in codex_hooks and "stop-hook.sh" in codex_hooks
    print("  " + ("ok   " if codex_ok else "WARN ")
          + "Codex activity hooks registered"
          + ("" if codex_ok else
             f" — {codex_home}/hooks.json missing superlooper hooks; needed only for --agent codex "
             "(bin/install.sh registers them)"))

    if failures:
        print(f"\nDOCTOR FAILED: {', '.join(failures)}")
        if "required_checks" in failures:
            print(_CHECKS_REQUIREMENT)
        if names_failed:
            print(_CHECKS_NAMES_REQUIREMENT)
        return 1
    print("\nall checks passed")
    return 0


# ------------------------------- shared report I/O -------------------------------

def _read_json_file(path, default):
    """Tolerant read for the state files the reports consume: missing -> default; present but
    unparseable -> {} (existence still counts, e.g. an unreadable freeze marker reads as frozen)."""
    txt = _read(path)
    if txt is None:
        return default
    try:
        v = json.loads(txt)
    except ValueError:
        return {}
    return v


def _ledger_map(home):
    """The flat accepted-failure map (ledger.json at the state-home root). Fail closed to {}."""
    v = _read_json_file(os.path.join(home, "ledger.json"), {})
    return v if isinstance(v, dict) else {}


_MISSING = object()


def _frozen_view(home):
    # Existence = frozen (fail closed). Distinguish MISSING (flowing) from PRESENT-but-not-a-proper
    # dict (a corrupt/empty/wrong-typed marker still means frozen — matching runner.py's _read_json
    # posture, so the two morning-report entry points agree).
    v = _read_json_file(os.path.join(home, "state", "merges_frozen.json"), _MISSING)
    if v is _MISSING:
        return None
    return v if isinstance(v, dict) and v else {"reason": "merges_frozen.json present but unreadable"}


def _ready_queue():
    """The waiting queue for the report: open `agent-ready` issues not yet claimed. gh reads fail
    closed to [] (a GitHub blip renders an honest empty queue, never a crash)."""
    out = []
    for raw in gh.ready_issues():
        p = issues_lib.parse_issue(raw)
        if "in-progress" not in (p.get("labels") or []):
            out.append({"num": p.get("num"), "title": p.get("title")})
    out.sort(key=lambda q: q["num"] if isinstance(q.get("num"), int) else 1 << 30)
    return out


# ------------------------------- morning-report -------------------------------

def cmd_morning_report(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    date = time.strftime("%Y-%m-%d", time.localtime())
    view = {"date": date, "now": time.time(), "frozen": _frozen_view(home),
            "queue": _ready_queue(), "usage": None,
            # Installed-engine publish drift (issue #39): computed here (git is impure; report.py
            # stays pure). engine_drift never raises and skips cleanly when there is no source
            # checkout, so a plain adopted repo simply carries no drift notice.
            "engine_drift": stack_doctor.engine_drift(
                repo_path=args.repo, dev_branch=cfg.get("dev_branch"))}
    text = report.morning(journal.read(home), view, _ledger_map(home), cfg)
    out_dir = os.path.join(home, "reports")
    os.makedirs(out_dir, exist_ok=True)
    out_path = os.path.join(out_dir, f"morning-{date}.md")
    with open(out_path, "w") as f:
        f.write(text)
    summary = next((ln for ln in text.splitlines()
                    if ln.strip() and not ln.startswith("#")), "morning report ready")
    # The push doubles as the notify-channel canary (issue #164) — send_test sends the SAME message
    # and returns its delivery result, journaled as `notify_canary` so the next report surfaces a
    # silently dead channel. Kept in parity with runner.py's _morning_report_hook.
    r = notify.send_test(cfg, f"superlooper morning report — {date}", summary)
    try:
        journal.append(home, {"act": "notify_canary", "date": date, "ok": bool(r.ok),
                              "channel": r.channel, "rc": r.rc,
                              "detail": (r.stderr or "")[:200], "outcome": "ok"}, time.time())
    except (OSError, ValueError):
        pass
    outcome = ("log-only" if r.channel == "log-only"
               else "sent via %s" % r.channel if r.ok
               else "%s send failed (rc=%s)" % (r.channel, r.rc))
    print(f"wrote {out_path}\nnotify: {outcome}")
    return 0


# ------------------------------- nightly QA -------------------------------

NIGHTLY_TIMEOUT = 3600      # the browser suite can be long; still bounded so a hang can't wedge.


def _make_nightly_worktree(repo, wt, dev):
    """A fresh DETACHED checkout of origin/<dev> — the nightly runs against current dev, isolated
    from any in-flight lane. Cleans a leftover from a crashed run first. False on any git failure.
    (SL_NIGHTLY_WORKTREE bypasses this for tests/sim, the same way SL_FAKE_USAGE bypasses usage.)"""
    gitops.worktree_remove(repo, wt)
    if not gitops.fetch(repo):
        return False
    try:
        r = subprocess.run(["git", "-C", repo, "worktree", "add", "--detach", wt,
                            f"origin/{dev}"], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def _run_suite(cmd, worktree, results_glob):
    """Run qa.nightly_cmd in the worktree, then parse the JUnit it produced. Returns
    (cmd_rc, parse_result). A missing binary / timeout is a nonzero rc, never a raise."""
    try:
        subprocess.run(["bash", "-lc", cmd], cwd=worktree, capture_output=True,
                       text=True, timeout=NIGHTLY_TIMEOUT)
        rc = 0
    except subprocess.TimeoutExpired:
        rc = 124
    except OSError:
        rc = 127
    texts = []
    if isinstance(results_glob, str) and results_glob.strip():
        for p in sorted(glob.glob(os.path.join(worktree, results_glob))):
            t = _read(p)
            if t is not None:
                texts.append(t)
    return rc, nightly_lib.parse_junit(texts)


def _seed_nightly_provenance_label(operator, already):
    """Create-or-force `source:qa` once per nightly run, returning True so the caller does it once.

    Why the nightly needs its own seeding when the runner does not (issue #400, fresh-agent review
    2026-08-06): the runner heals its runner-managed labels in the #160 BOOT migration, and this
    command never boots the runner — it runs on its own schedule, against whatever vocabulary the
    repo happens to have. `gh issue create` is ALL-OR-NOTHING for labels, so on a repo adopted
    before this shipped the entire call would be refused and the red mainline would freeze with the
    fix issue that is meant to lift it never filed.

    Only the label this change INTRODUCED is seeded. The other four in the standing-rule set are
    §4.4 vocabulary that predates the loop's current shape and that every adopted repo already has;
    seeding those too would be a different (and much larger) claim about what this command may write.
    A failure is deliberately not fatal — the create below then fails honestly and the next nightly
    re-files (idempotent by fingerprint), which is the same posture this filer already takes on any
    gh failure."""
    if already:
        return True
    spec = labels_lib.label_spec(labels_lib.SOURCE_QA)
    if spec:
        color, desc = spec
        gh.create_label(labels_lib.SOURCE_QA, color, desc.replace("{operator}", operator))
    return True


def _file_fix_issues(home, failures, dev, operator):
    """File one standing-rule fix issue per DISTINCT persistent failure, deduped by fingerprint:
    skip a fp already tracked in state/fix_issues.json, and reconcile against an open
    auto-approved:nightly-red issue whose body already carries the fp marker (the same crash-window
    dedup the runner's _exec_file_fix_issue does — a nightly-filed and a runner-filed issue for one
    breakage stay one issue). Returns the issue numbers now tracking these failures."""
    path = os.path.join(home, "state", "fix_issues.json")
    filed_map = _read_json_file(path, {})
    filed_map = filed_map if isinstance(filed_map, dict) else {}
    open_bodies = [(it["number"], it["body"]) for it in gh.open_issues(gate.RESTORE_GREEN_LABEL)
                   if isinstance(it, dict) and isinstance(it.get("body"), str)
                   and type(it.get("number")) is int]
    tracking, seen, seeded = [], set(), False
    for f in failures:
        fp = f.get("fp")
        if not fp or fp in seen:
            continue
        seen.add(fp)
        if fp in filed_map:
            tracking.append(filed_map[fp])
            continue
        marker = f"Failure fingerprint: `{fp}`"
        hit = next((num for num, body in open_bodies if marker in body), None)
        if hit is not None:
            filed_map[fp] = hit
            tracking.append(hit)
            continue
        issue = nightly_lib.fix_issue(f, dev, operator)
        seeded = _seed_nightly_provenance_label(operator, seeded)
        num = gh.create_issue(issue["title"], issue["body"], labels=issue["labels"])
        if num is None:
            continue                     # gh failed; the next nightly re-files (idempotent by fp)
        filed_map[fp] = num
        tracking.append(num)
    loopstate.save(path, filed_map)
    return tracking


def cmd_nightly(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    os.makedirs(os.path.join(home, "state"), exist_ok=True)
    qa = cfg.get("qa") if isinstance(cfg.get("qa"), dict) else {}
    cmd = qa.get("nightly_cmd")
    date = time.strftime("%Y-%m-%d", time.localtime())
    now = time.time()
    if not (isinstance(cmd, str) and cmd.strip()):
        print("qa.nightly_cmd is null — the browser suite isn't wired for this repo yet; "
              "nothing to run. (It's built collaboratively first; the config then points at it.)")
        return 0
    dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"
    results_glob = qa.get("results_glob")

    injected = os.environ.get("SL_NIGHTLY_WORKTREE")
    wt = injected or os.path.join(home, "nightly-worktree")
    made = False
    if not injected:
        if not _make_nightly_worktree(args.repo, wt, dev):
            # can't even build the checkout: honest failure, journal + notify, never a green.
            journal.append(home, {"act": "nightly", "date": date, "parse_error": True,
                                  "green": False, "flakes": 0, "persistent": 0, "filed": [],
                                  "note": "could not create nightly worktree", "outcome": "ok"}, now)
            notify.send(cfg, f"superlooper nightly could not start ({date})",
                        f"failed to create a fresh worktree of origin/{dev} — see the nightly log.")
            print("nightly: could not create the worktree", file=sys.stderr)
            return 1
        made = True

    try:
        rc1, p1 = _run_suite(cmd, wt, results_glob)
        # Persist the parsed run so `promote-report --use-latest-nightly` can reuse it without
        # re-running the (long) suite. Written for BOTH the ok and the could-not-parse paths.
        loopstate.save(os.path.join(home, "state", "last_nightly.json"),
                       {"date": date, "ok": p1["ok"], "failures": p1["failures"]})
        if not p1["ok"]:
            # Broken/empty/missing results are NEVER a silent green: journal parse_error (the
            # morning report renders it honestly) + notify + nonzero exit. We do NOT touch the
            # shared ALERT or freeze marker here — those are the runner's to own (it would clear a
            # nightly-written ALERT within a tick); the durable signals are this journal record
            # and the immediate push.
            journal.append(home, {"act": "nightly", "date": date, "parse_error": True,
                                  "green": False, "flakes": 0, "persistent": 0, "filed": [],
                                  "cmd_rc": rc1, "outcome": "ok"}, now)
            notify.send(cfg, f"superlooper nightly — could not parse results ({date})",
                        f"qa.nightly_cmd exited {rc1}; no parseable JUnit at {results_glob!r}. "
                        "The nightly could not confirm dev is green — check the nightly log.")
            print(f"nightly: could not parse results (cmd rc={rc1})", file=sys.stderr)
            return 1

        run2 = None
        if qa.get("retry_once", True) and p1["failures"]:
            _, p2 = _run_suite(cmd, wt, results_glob)
            # An unparseable retry can't prove a flake, so treat run1's failures as persistent
            # (conservative): pass them as run2 so the intersection keeps them.
            run2 = p2["failures"] if p2["ok"] else p1["failures"]

        accepted = set(ledger_lib.load(home).keys())
        quarantine = qa.get("quarantine") if isinstance(qa.get("quarantine"), list) else []
        result = nightly_lib.classify(p1["failures"], run2, quarantine, accepted)
        to_file = result["to_file"]

        frozen_path = os.path.join(home, "state", "merges_frozen.json")
        filed = []
        if to_file:
            # Claim freeze OWNERSHIP with source="nightly" (Codex R2 C2), OVERWRITING any existing
            # marker: a red nightly is slow to recover (once a night), so it must be sticky against
            # the runner's dev-green unfreeze. If a dev-check freeze was the only cause and it
            # recovers first, the runner re-freezes within a tick — so overwriting is the safe
            # direction (stays frozen until the slow condition clears).
            loopstate.save(frozen_path,
                           {"reason": f"nightly red: {len(to_file)} persistent failure(s)",
                            "fingerprint": to_file[0]["fp"], "since": now,
                            "source": gate.NIGHTLY_FREEZE_SOURCE})
            filed = _file_fix_issues(home, to_file, dev, config_lib.operator(cfg))
        else:
            # A green nightly clears ONLY a nightly-owned freeze — never a runner dev-check freeze
            # (which the runner clears when dev checks go green).
            cur = _read_json_file(frozen_path, None)
            if gate.nightly_owned_freeze(cur):
                try:
                    os.remove(frozen_path)
                except OSError:
                    pass

        green = not to_file
        journal.append(home, {"act": "nightly", "date": date, "green": green,
                              "flakes": len(result["flakes"]), "persistent": len(to_file),
                              "accepted": len(result["accepted"]),
                              "quarantined": len(result["quarantined"]),
                              "filed": filed, "parse_error": False, "cmd_rc": rc1,
                              "outcome": "ok"}, now)

        if to_file:
            shown = ", ".join(f"#{n}" for n in filed) or "(dedup: already open)"
            notify.send(cfg, f"superlooper nightly RED ({date})",
                        f"{len(to_file)} persistent failure(s); merges frozen, fix issue(s): {shown}")
            print(f"nightly RED: {len(to_file)} persistent, filed {filed or '(deduped)'}, "
                  f"merges frozen ({len(result['flakes'])} flake(s), "
                  f"{len(result['accepted'])} accepted, {len(result['quarantined'])} quarantined)")
        else:
            print(f"nightly green ({len(result['flakes'])} flake(s), "
                  f"{len(result['accepted'])} accepted-ledger, "
                  f"{len(result['quarantined'])} quarantined)")
        return 0
    finally:
        if made:
            gitops.worktree_remove(args.repo, wt)


# ------------------------------- promotion evidence + accept-failure -------------------------------

def _open_issue_summary():
    """Open issues for the promotion report's open-issue section: the approved queue + everything
    in flight, deduped, oldest-first. gh fails closed to [] (a blip renders an honest empty list)."""
    seen, out = set(), []
    for label in ("agent-ready", "in-progress"):
        for raw in gh.open_issues(label):
            p = issues_lib.parse_issue(raw)
            num = p.get("num")
            if isinstance(num, int) and num not in seen:
                seen.add(num)
                out.append({"num": num, "title": p.get("title"), "labels": p.get("labels")})
    out.sort(key=lambda i: i["num"])
    return out


def cmd_promote_report(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    date = time.strftime("%Y-%m-%d", time.localtime())
    qa = cfg.get("qa") if isinstance(cfg.get("qa"), dict) else {}

    if args.use_latest_nightly:
        ln = _read_json_file(os.path.join(home, "state", "last_nightly.json"), None)
        if not isinstance(ln, dict):
            print("no stored nightly results (state/last_nightly.json) — run `superlooper nightly` "
                  "first, or omit --use-latest-nightly to run the suite now.", file=sys.stderr)
            return 1
        # ok must be EXACTLY True — a corrupt/hand-edited cache with a truthy wrong-typed value
        # ("false", {}, 1) must never render as parsed evidence (silent all-clear). Anything but
        # True falls to report.promotion's could-not-parse path (Codex R2 C3).
        suite = {"ok": ln.get("ok") is True,
                 "failures": ln.get("failures") if isinstance(ln.get("failures"), list) else [],
                 "source": f"latest nightly {ln.get('date')}"}
    else:
        cmd = qa.get("nightly_cmd")
        if not (isinstance(cmd, str) and cmd.strip()):
            print("qa.nightly_cmd is null — nothing to run. Use --use-latest-nightly, or wire the "
                  "suite in .superlooper/config.json.", file=sys.stderr)
            return 1
        dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"
        injected = os.environ.get("SL_NIGHTLY_WORKTREE")
        wt = injected or os.path.join(home, "promote-worktree")
        made = False
        if not injected:
            if not _make_nightly_worktree(args.repo, wt, dev):
                print("could not create the suite worktree", file=sys.stderr)
                return 1
            made = True
        try:
            _, p = _run_suite(cmd, wt, qa.get("results_glob"))
        finally:
            if made:
                gitops.worktree_remove(args.repo, wt)
        suite = {"ok": p["ok"], "failures": p["failures"], "source": "fresh suite"}

    prod = cfg.get("prod_branch")
    dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"
    result = gh.compare(prod, dev) if isinstance(prod, str) and prod.strip() else None
    compare = {"prod_branch": prod, "dev_branch": dev, "result": result}

    text = report.promotion(date, suite, ledger_lib.load(home), compare,
                            _open_issue_summary(), cfg)
    out_dir = os.path.join(home, "reports")
    os.makedirs(out_dir, exist_ok=True)
    out_path = os.path.join(out_dir, f"promotion-{date}.md")
    with open(out_path, "w") as f:
        f.write(text)
    outcome = notify.send(cfg, f"superlooper promotion evidence — {date}",
                          "promotion evidence ready — no verdict, your call (Gate 2).")
    print(f"wrote {out_path}\nnotify: {outcome}")
    return 0


def cmd_accept_failure(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    fp = args.fingerprint
    if not (isinstance(fp, str) and fp.strip()):
        print("accept-failure needs a fingerprint (copy it from a promotion report).",
              file=sys.stderr)
        return 2
    os.makedirs(home, exist_ok=True)             # a first-ever accept may precede any runner run
    ledger_lib.accept(home, fp.strip(), note=args.note)
    note = f' — "{args.note}"' if args.note else ""
    print(f"accepted failure {fp.strip()}{note}\n"
          "This acceptance persists (one approval, ever) and folds the failure away in future "
          "promotion reports.")
    return 0


# ------------------------------- tidy -------------------------------
# `superlooper tidy` closes the session windows of FINISHED sessions. It is William's explicit word,
# never automatic (V1 'nothing auto-closed' — DRYRUN 2026-07-03): a real claude worker idles at
# its prompt forever after finishing (D4) and never self-closes, so windows pile up. Safe to run
# while the runner is live — the pure selector (tidy.closable) never picks an in-flight or
# in-between-gate lane, so a close can only ever land on a finished, idle session.

def _recorded_windows(home):
    """The iids that have a recorded session window (state/panes/<iid>), narrowed to worker lanes.

    `lib/panes` owns the file format; the `i<N>` narrowing is tidy's own — a debugger seat is
    William's to close himself. Missing dir / unreadable -> empty set."""
    return {iid for iid in panes.recorded_ids(os.path.join(home, "state"))
            if re.fullmatch(r"i\d+", iid)}


def _snapshot(home, iid):
    """The recorded handle read from disk NOW, at LIST time — so the close targets exactly the
    window shown to William (Codex cross-review round 1: the never-close-in-flight property must
    survive a concurrent re-approval).

    The snapshot is no longer the whole guarantee. `_close_window` re-reads this immediately before
    the teardown and refuses on a mismatch, because the doorway's `kill` resolves the pid it signals
    from the lane NAME rather than from anything recorded here — see that function."""
    return panes.read(os.path.join(home, "state"), iid)


def _close_window(home, iid, handle, *, cleanup):
    """Best-effort close of the SNAPSHOTTED session, THROUGH THE DOORWAY (issue #334).

    Returns whether the teardown was VERIFIED — which is what the caller counts. A close the host
    could not confirm is not a closed window, and saying otherwise would be the very shape this
    verb was fixed for: reporting N closed while closing none.

    It used to be `cmux close-surface --surface <recorded>`. After #308 moved the spawn onto the
    five-verb wrapper, that recorded value is the session HOST's workspace and pane — identifiers
    cmux never issued — so the close silently no-opped: `superlooper tidy` would report closing N
    windows and close none, leaving every finished session standing. (#310 re-homed the DASHBOARD's
    Tidy button onto this verb and deliberately left the verb itself alone; its host coupling is
    here, and this is where it had to move.)

    `exit` then `kill`, the same ladder and the same reasoning as the runner's `_close_pane`: the
    doorway's `exit` is a positive allowlist that closes only a session it can NAME as finished,
    and the case tidy exists for — a worker that wrote its report and idles at its prompt — reads
    ALIVE. `close-surface` escalated unconditionally, so escalating preserves the behaviour rather
    than quietly becoming gentler. Every failure is swallowed: a close that cannot be verified must
    never wedge tidy, and the pure selector has already proved the lane is finished.

    THE SNAPSHOT ALONE NO LONGER PROTECTS A RELAUNCHED LANE, which is why the re-read below exists.
    Under cmux the guarantee was structural: `close-surface --surface <snapshot>` could not touch
    anything but that surface, so a relaunch during the y/N wait was closed-the-dead-one and done.
    The doorway is not shaped that way — `kill` derives the pid it signals FRESH from the lane NAME
    (session_host.state: "FRESH pane, every read"), and the recorded workspace pins only what gets
    closed. So a re-approval that relaunched this lane while the owner was reading the prompt would
    have its NEW worker SIGTERMed. Reachable exactly for `--all`, whose scope is `tidy.REAPPROVABLE`.

    So the handle is re-read immediately before the teardown and must still equal the snapshot. A
    relaunch rewrites both halves (every spawn creates a new workspace), so a mismatch is a positive
    "this is no longer the session you were shown" and nothing is touched. This is a NARROWER
    guarantee than cmux gave — it closes the y/N window, which is the whole window the original
    cross-review finding was about, not a structural impossibility — and saying so is better than
    repeating a promise this path can no longer keep.

    Why cleanup is gated (Codex cross-review rounds 1-2): pane markers/lock are NOT under any lock
    tidy can take (the runner writes them from the launch stack), so a read-then-remove can never
    be made atomic against a concurrent relaunch. The airtight fix is structural — `cleanup` is set
    ONLY for a status that can NEVER relaunch (merged; see tidy.REAPPROVABLE), so there is no
    concurrent writer and the removal is race-free. For a re-approvable status tidy closes the
    window but leaves the markers/lock to the runner, whose _close_stale_session frees them on the
    next relaunch (and _live_lock_ids ignores a dead-PID lock meanwhile) — so tidy never frees a
    live worker's singleton lock. Freeing a merged session's stale lock mirrors _close_stale_session
    (the finished-but-alive session held it — D4)."""
    # Imported here rather than at the top only to keep the doorway's name beside its one use in
    # this file. `lib/panes` already pulls it in at import time, so this costs nothing.
    import session_host
    fresh = panes.read(os.path.join(home, "state"), iid)
    if handle and (fresh.workspace, fresh.pane) != (handle.workspace, handle.pane):
        print(f"  {iid}: relaunched while you were deciding — leaving the new session alone.")
        return False
    session = handle.as_session(iid) if handle else None
    verified = False
    if session is not None:
        host = session_host.SessionHost(call_seconds=_CLOSE_TIMEOUT, teardown_reads=2,
                                        teardown_pause=0.5)
        try:
            host.exit(session)
            verified = True
        except session_host.TeardownRefused:
            try:
                host.kill(session)
                verified = True
            except session_host.HostError as e:
                print(f"  {iid}: could not be closed ({e}).")
        except session_host.HostError as e:
            print(f"  {iid}: could not be closed ({e}).")
    if cleanup:
        # Cleared even on an UNVERIFIED close, and deliberately: `cleanup` is set only for a status
        # that can never relaunch, so nothing will ever write these again and leaving them behind
        # would strand markers for a session nobody will look at. What must not happen is claiming
        # the WINDOW went — that is what `verified` carries out to the count.
        panes.forget(os.path.join(home, "state"), iid)
        try:
            os.remove(os.path.join(home, "state", f"worker.{iid}.lock"))
        except OSError:
            pass
    return verified


def cmd_tidy(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    try:
        st = loopstate.load(os.path.join(home, "state", "issues.json"))
    except (OSError, ValueError):
        st = {}
    # Guard st ITSELF: a corrupt issues.json can parse as a JSON list/str/number, so st.get would
    # raise before the selector's own guards — fail closed to no issues (nothing to close).
    st = st if isinstance(st, dict) else {}
    issues = st.get("issues") if isinstance(st.get("issues"), dict) else {}
    targets = tidy_lib.closable(issues, _recorded_windows(home), scope_all=args.all)
    scope = "terminal" if args.all else "merged"
    if not targets:
        print(f"tidy: no finished ({scope}) session windows to close.")
        return 0

    # Snapshot each target's surface/ws NOW, before the y/N wait, so the close targets exactly the
    # windows listed here — a relaunch during the wait can't redirect a close onto a live window.
    snaps = [{"id": t["id"], "status": t["status"], "handle": _snapshot(home, t["id"])}
             for t in targets]
    print(f"tidy will close {len(snaps)} finished ({scope}) session window(s):")
    for s in snaps:
        print(f"  {s['id']:5} {s['status']:13} {s['handle'].workspace or '(no window)'}")
    if args.dry_run:
        print("dry-run: nothing closed.")
        return 0
    if not args.yes:
        try:
            reply = input("close these windows? [y/N] ").strip().lower()
        except EOFError:
            reply = ""
        if reply not in ("y", "yes"):
            print("aborted — nothing closed.")
            return 0

    reconciled, closed = [], 0
    for s in snaps:
        # cleanup (remove markers+lock) ONLY for a status that can never relaunch — merged. A
        # re-approvable session's markers/lock stay the runner's to reconcile (race-free by
        # construction; see _close_window).
        cleanup = s["status"] not in tidy_lib.REAPPROVABLE
        if not _close_window(home, s["id"], s["handle"], cleanup=cleanup):
            continue           # skipped: the lane relaunched while the owner was deciding
        closed += 1
        if not cleanup:
            reconciled.append(s["id"])
    # The COUNT is what a teardown actually VERIFIED, not what was listed. Two things it must
    # therefore exclude: a lane that relaunched while the owner was deciding (skipped on purpose),
    # and a close the host would not confirm. Reporting the listed number instead would be the same
    # "reported N, closed none" shape this verb was fixed for in the first place.
    print(f"closed {closed} window(s)." + (
        f" {len(reconciled)} re-approvable session(s) left for the runner to reconcile "
        f"({', '.join(reconciled)})." if reconciled else ""))
    return 0


# ------------------------------- janitor -------------------------------
# `superlooper janitor` (issue #62, spec §8 V2) PROPOSES GitHub-side cleanup and executes ONLY
# what William approves — the same propose/approve word-discipline as tidy, pointed at GitHub
# instead of cmux windows. Four classes, each with a one-line why: stale sl/* remote branches
# whose PRs merged or were superseded, PRs labeled `superseded` left open by design (§C.4 6b),
# parked / needs-william issues gathering dust past janitor.aged_park_days, and — issue #229 —
# issues closed as COMPLETED by a bare commit-message keyword, which are proposed for REOPEN.
# The list / --dry-run changes NOTHING anywhere; approved actions run mechanically and are
# journaled; a refused/failed action is surfaced once and held back (state/janitor_refused.json),
# never silently retried — --retry-refused re-proposes it. There is no schedule wiring for the
# execute path and none may ever be added: proposals may be generated on a schedule, ACTIONS
# only ever on the owner's word.

_REFUSED_FILE = "janitor_refused.json"
_JANITOR_STAMP = "superlooper janitor — approved by the owner: "


def _janitor_loopstate(home):
    """loopstate['issues'] with the fail direction the janitor needs: a MISSING issues.json is
    an honest empty ({} — no lane has ever run, nothing to exclude), but a PRESENT-yet-unreadable
    or wrong-typed one is None — the caller must refuse to propose ANYTHING, because nothing is
    provably idle. (Compare tidy, where unreadable state fails closed to 'close nothing' the
    same way — here 'nothing' means 'propose nothing'.)"""
    path = os.path.join(home, "state", "issues.json")
    try:
        st = loopstate.load(path)
    except FileNotFoundError:
        return {}                # genuinely absent: no lane has ever run
    except (OSError, ValueError):
        return None              # present but unreadable (EPERM, corrupt, ...): refuse
    if not isinstance(st, dict) or not isinstance(st.get("issues"), dict):
        return None
    return st["issues"]


def _janitor_refused_read(path):
    """The hold-back map, strictly: a MISSING file -> {} (nothing ever refused), but PRESENT
    and unreadable / wrong-typed -> None — the caller must refuse to run. Reading corrupt or
    permission-blocked hold-back state as empty would silently re-propose every previously
    refused action (cross-review rounds 1-2, C2). Opened directly, not via _read(): _read
    collapses EVERY OSError to None, and only ENOENT may mean 'nothing ever refused' —
    an EPERM on a present file must refuse, not blank the map."""
    try:
        with open(path) as f:
            txt = f.read()
    except FileNotFoundError:
        return {}
    except OSError:
        return None
    try:
        v = json.loads(txt)
    except ValueError:
        return None
    return v if isinstance(v, dict) else None


def _janitor_fetch(ls_issues, cfg=None):
    """One fetched snapshot of everything janitor.propose selects from. Every gh read fails
    closed to empty, so a GitHub blip shrinks the sweep toward proposing NOTHING, never toward
    proposing more.

    `cfg` carries the repo's territory contract for the metadata sweep (issue #225). Omitted, the
    metadata kind stands down entirely — a fix menu built on an unread config would be a menu built
    on nothing."""
    sl = {b: tip for b, tip in gh.remote_branches().items()
          if isinstance(b, str) and b.startswith(janitor_lib.BRANCH_PREFIX)}
    parked = []
    for label in janitor_lib.PARK_LABELS:
        parked += gh.open_issues_activity(label)
    cfg = cfg if isinstance(cfg, dict) else {}
    return {"branches": sl,
            "branch_prs": {b: gh.pr_for_branch(b) for b in sl},
            "superseded_prs": gh.open_prs_labeled(janitor_lib.SUPERSEDED_LABEL),
            "parked_issues": parked,
            # the accidental-close audit (issue #229). ONE GraphQL read for the whole closed set,
            # on the sweep's own schedule — nothing on the runner's per-tick path reads it. A
            # refused read yields [] here, which proposes no reopens (fail closed); `doctor` is the
            # surface that distinguishes "read refused" from "nothing accidentally closed".
            "closed_issues": gh.closed_issue_closers().value,
            # the merged-PR-with-open-issue pairs (issue #404). ONE list read for the whole sl/*
            # PR history, on the sweep's own schedule — nothing on the runner's per-tick path reads
            # it. Its open-issue half is `lint_issues` below (the SAME read), so the class costs one
            # extra call, not two. A refused read yields [] and proposes nothing (fail closed).
            "sl_prs": gh.sl_head_prs().value,
            "lint_issues": gh.open_issues_all(),
            "areas": cfg.get("areas"),
            "touches_required": bool(cfg.get("touches_required")),
            "ls_issues": ls_issues}


def _janitor_what(p):
    """What one proposal WOULD do, in plain words."""
    if p["kind"] == "branch":
        return f"delete branch {p['target']}"
    if p["kind"] == "pr":
        head = f" ({p['head']})" if p.get("head") else ""
        return f"close PR #{p['target']}{head}"
    if p["kind"] == "metadata":
        if p["action"] == "add-label":
            return f"add {p['label']} to issue #{p['target']}"
        return f"declare `touches: {p['value']}` on issue #{p['target']}"
    title = p.get("title") or ""
    if p["kind"] == "issue-reopen":
        return f"REOPEN issue #{p['target']}" + (f" {title[:60]!r}" if title else "")
    if p["kind"] == "issue-merged-open":
        # name the merged PR in the VERB, not only in the why (issue #404): the owner is being
        # asked to close an open issue, and the merged work is the entire justification.
        return (f"close issue #{p['target']} (PR #{p.get('pr')} merged)"
                + (f" {title[:60]!r}" if title else ""))
    return f"close issue #{p['target']}" + (f" {title[:60]!r}" if title else "")


def _janitor_line(p):
    """One proposal, one line, why included — exactly what William approves."""
    return f"  {_janitor_what(p)} — {p['why']}"


def _janitor_menu_lines(menus):
    """The mutually-exclusive alternatives, one issue per block: what is wrong, then the choices
    with the exact key that executes each. These are NEVER part of the bulk y/N — applying two
    members of a `type:` menu would manufacture the `type_duplicate` defect the menu was fixing —
    so the key is the whole point of printing them."""
    lines = []
    for group in sorted(menus):
        items = menus[group]
        lines.append(f"  issue #{items[0]['target']} — {items[0]['why']}")
        lines.append("    choose ONE (nothing here runs from a bulk approve):")
        for p in items:
            lines.append(f"      {p.get('label') or p.get('value')}"
                         f"   →  --execute-keys {p['key']}")
    return lines


def _janitor_execute(p):
    """One approved action -> (ok, reason). Mechanical verbs only — delete ref / close PR /
    close issue / reopen issue / add a label / rewrite an issue body — each leaving an audit
    comment where a comment is possible (issue #225 Boundaries: every executed fix carries its
    audit comment)."""
    if p["action"] == "delete-branch":
        ok = gh.delete_branch(p["target"])
    elif p["action"] == "close-pr":
        ok = gh.close_pr(p["target"], comment=_JANITOR_STAMP + p["why"])
    elif p["action"] == "close-issue":
        ok = gh.close_issue(p["target"], comment=_JANITOR_STAMP + p["why"])
    elif p["action"] == "reopen-issue":
        # the audit comment carries the WHY, which names the closing commit — so the reopened
        # issue explains itself to the next reader without anyone re-deriving the forensics
        # (issue #229; the 2026-07-16 hand-reopen becomes this one tap).
        ok = gh.reopen_issue(p["target"], comment=_JANITOR_STAMP + p["why"])
    elif p["action"] == "add-label":
        ok = gh.set_labels(p["target"], add=[p["label"]])
        if ok:
            gh.comment(p["target"], _JANITOR_STAMP + f"added `{p['label']}` — {p['why']}")
    elif p["action"] == "set-body":
        ok = gh.set_issue_body(p["target"], p["body"])
        if ok:
            gh.comment(p["target"], _JANITOR_STAMP
                       + f"declared `touches: {p['value']}` in `## Loop metadata` — {p['why']}")
    else:
        return False, f"unknown action {p['action']!r}"      # unreachable; fail closed anyway
    return ok, ("" if ok else "gh refused the write (or was unreachable)")


def _janitor_split_menus(props):
    """(bulk-approvable proposals, {choose_group: [alternatives]}).

    The split IS the safety rule (issue #225): a proposal carrying a `choose_group` is one of
    several mutually-exclusive answers to the same defect, and the janitor never picks between
    them. It is offered by key and executes only on an explicit tap."""
    bulk, menus = [], {}
    for p in props:
        group = p.get("choose_group")
        if group:
            menus.setdefault(group, []).append(p)
        else:
            bulk.append(p)
    return bulk, menus


def _janitor_read_state(home, retry_refused):
    """The two fail-closed reads every janitor sweep depends on. Returns
    (ls_issues, refused_map, refused_keys, error) — `error` is None on success, else a
    human-readable string (the caller decides stderr vs a JSON envelope). Either read failing
    closed (present-but-unreadable) means nothing is provably safe, so the caller must refuse
    the whole sweep — exactly as the interactive path does."""
    ls = _janitor_loopstate(home)
    if ls is None:
        return None, None, None, ("state/issues.json exists but is unreadable — nothing is "
                                  "provably idle, so nothing will be proposed. Fix or remove "
                                  "it, then re-run.")
    refused_map = _janitor_refused_read(os.path.join(home, "state", _REFUSED_FILE))
    if refused_map is None:
        return None, None, None, (f"state/{_REFUSED_FILE} exists but is unreadable — running "
                                  "would silently drop every held-back refused action. Fix or "
                                  "remove it, then re-run.")
    refused_keys = set() if retry_refused else set(refused_map)
    return ls, refused_map, refused_keys, None


def _janitor_execute_subset(args, home, days, dev, cfg=None):
    """Execute EXACTLY the approved keys the command center tapped (comma-separated in
    --execute-keys), through the SAME reconcile → execute → journal → refused-holdback flow the
    interactive `--yes` path uses. Machine output only: one JSON result object. Nothing weakens
    a safety rule — a FRESH re-derivation still gates every action (act-time re-verification: a
    key that moved, went in-flight, or is no longer proposed is skipped, never forced), and a
    currently-refused key is held back unless --retry-refused is given (holdback parity).

    One rule is added rather than weakened (issue #225): at most ONE member of a `choose_group`
    may run per invocation. The alternatives are mutually exclusive by construction, so executing
    two `type:` labels would manufacture the very `type_duplicate` defect the menu was fixing —
    and a double-tap or a raced request must not be able to do it."""
    keys = [k for k in (args.execute_keys or "").split(",") if k]
    ls, refused_map, _refused_keys, err = _janitor_read_state(home, retry_refused=True)
    if err is not None:
        print(json.dumps({"ok": False, "error": err}))
        return 1
    now = time.time()
    # The holdback is decided HERE, before the re-derivation, rather than per-key after it. It used
    # to be applied afterwards with `refused=set()` passed to propose — harmless while every class
    # was selected independently of `refused`, but the accidental-close class is CAPPED per sweep
    # and skips refused keys when filling the cap (issue #229), so a propose() that disagrees with
    # the listing about `refused` selects a DIFFERENT set of reopens. The owner then approves ten,
    # six run, and four are reported "no longer eligible (state moved)" when nothing moved at all.
    # One refused set, used by both the listing and this re-derivation, and the divergence is gone.
    refused_now = set() if args.retry_refused else set(refused_map)
    held_keys = [k for k in keys if k in refused_now]
    fresh = janitor_lib.propose(**_janitor_fetch(ls, cfg), now=now, aged_park_days=days,
                                refused=refused_now, dev_branch=dev)
    to_run, skipped = janitor_lib.reconcile(
        [{"key": k} for k in keys if k not in refused_now], fresh["proposals"])
    # ...then the mutual-exclusion rule (issue #225), applied to what survived the re-derivation.
    # Order matters: this filter must see the SAME candidate set the reconcile produced, so that a
    # group member held back or dropped above cannot claim its group's one slot and lock out the
    # member that is actually eligible.
    claimed, exclusive = set(), []
    for p in to_run:
        group = p.get("choose_group")
        if group and group in claimed:
            skipped.append(dict(p, _exclusive=True))
            continue
        if group:
            claimed.add(group)
        exclusive.append(p)
    to_run = exclusive
    refused_path = os.path.join(home, "state", _REFUSED_FILE)
    results, executed, failed = [], 0, 0
    for p in skipped:
        results.append({"key": p["key"], "outcome": "skipped",
                        "reason": ("another answer to the same defect was already applied in this "
                                   "request — these are mutually exclusive, one may run"
                                   if p.get("_exclusive") else
                                   "no longer eligible (state moved, or not a current proposal)")})
    for k in held_keys:
        # held back from a prior failure — an explicit tap does not silently retry it; the owner
        # must ask for a retry (parity with the CLI's --retry-refused holdback).
        results.append({"key": k, "outcome": "held",
                        "reason": "held back from a prior failure — retry to act"})
    if getattr(args, "dry_run", False):
        # --dry-run wins over --execute-keys: report what WOULD run, write NOTHING (no gh write, no
        # journal, no refused-map save) — the CLI's documented "change nothing" contract holds even
        # when a subset was named. (Not a path the command center takes; a CLI-only safety net.)
        for p in to_run:
            results.append({"key": p["key"], "action": p["action"], "target": p["target"],
                            "outcome": "would-run"})
        print(json.dumps({"ok": True, "results": results, "executed": 0, "failed": 0,
                          "skipped": sum(1 for r in results if r["outcome"] == "skipped"),
                          "held": sum(1 for r in results if r["outcome"] == "held")}))
        return 0
    for p in to_run:
        ok, reason = _janitor_execute(p)
        journal.append(home, {"act": "janitor", "action": p["action"], "target": p["target"],
                              "why": p["why"], "outcome": "ok" if ok else "fail",
                              **({"reason": reason} if reason else {})}, now)
        if ok:
            refused_map.pop(p["key"], None)
            executed += 1
            results.append({"key": p["key"], "action": p["action"], "target": p["target"],
                            "outcome": "ok"})
        else:
            refused_map[p["key"]] = {"reason": reason, "ts": now}
            failed += 1
            results.append({"key": p["key"], "action": p["action"], "target": p["target"],
                            "outcome": "fail", "reason": reason})
    os.makedirs(os.path.dirname(refused_path), exist_ok=True)   # a first sweep may precede any run
    loopstate.save(refused_path, refused_map)
    print(json.dumps({"ok": True, "results": results, "executed": executed, "failed": failed,
                      "skipped": sum(1 for r in results if r["outcome"] == "skipped"),
                      "held": sum(1 for r in results if r["outcome"] == "held")}))
    return 1 if failed else 0


def cmd_janitor(args):
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    days = cfg["janitor"]["aged_park_days"]
    dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"

    if getattr(args, "execute_keys", None) is not None:
        return _janitor_execute_subset(args, home, days, dev, cfg)

    ls, refused_map, refused_keys, err = _janitor_read_state(home, args.retry_refused)
    if err is not None:
        if getattr(args, "json", False):
            print(json.dumps({"ok": False, "error": err}))
        else:
            print("janitor: " + err, file=sys.stderr)
        return 1
    refused_path = os.path.join(home, "state", _REFUSED_FILE)

    result = janitor_lib.propose(**_janitor_fetch(ls, cfg), now=time.time(), aged_park_days=days,
                                 refused=refused_keys, dev_branch=dev)
    props, held = result["proposals"], result["refused"]
    bulk, menus = _janitor_split_menus(props)
    withheld = result.get("reopen_withheld") or 0
    mo_withheld = result.get("merged_open_withheld") or 0

    if getattr(args, "json", False):
        # machine-readable propose: the full snapshot, one JSON object, and NOTHING is executed
        # or written. The command center renders this exactly the way `--dry-run` prints for a
        # human — same pure propose(), no re-derived safety anywhere.
        print(json.dumps({"ok": True, "proposals": props, "held": held,
                          "aged_park_days": days, "reopen_withheld": withheld,
                          "merged_open_withheld": mo_withheld}))
        return 0

    held_note = (f"({len(held)} previously refused action(s) held back — --retry-refused "
                 f"re-proposes them; see state/{_REFUSED_FILE})" if held else "")
    # A cap that is not SAID reads as "there was nothing else" — the same over-claim the
    # accidental-close audit exists to stop (issue #229). Say what was left out and why.
    withheld_note = (f"({withheld} more keyword-closed issue(s) were found and NOT proposed this "
                     f"sweep — at most {janitor_lib.REOPEN_SWEEP_CAP} reopens per sweep; "
                     f"`superlooper doctor` lists them all and a later sweep proposes the rest)"
                     if withheld else "")
    # Same discipline for the merged-PR/open-issue closes (issue #404). This cap is likelier to bite
    # than the reopen one: a repo whose dev_branch is not its DEFAULT branch never had a closing
    # keyword honoured at all, so its very first sweep finds one pair per merged issue.
    mo_note = (f"({mo_withheld} more merged-PR/still-open issue(s) were found and NOT proposed this "
               f"sweep — at most {janitor_lib.MERGED_OPEN_SWEEP_CAP} closes per sweep; later sweeps "
               "propose the rest)" if mo_withheld else "")

    if not props:
        print("janitor: nothing to propose — no GitHub-side debris found."
              + (" " + held_note if held_note else "")
              + (" " + withheld_note if withheld_note else "")
              + (" " + mo_note if mo_note else ""))
        return 0

    print(f"janitor proposals ({len(props)}) — nothing executes without your approval:")
    for p in bulk:
        print(_janitor_line(p))
    if menus:
        # The alternatives, printed apart from the y/N set they can never join (issue #225).
        print(f"\n{len(menus)} issue(s) need a value only you can choose — one tap each:")
        for line in _janitor_menu_lines(menus):
            print(line)
    if held_note:
        print(held_note)
    if withheld_note:
        print(withheld_note)
    if mo_note:
        print(mo_note)
    if args.dry_run:
        print("dry-run: nothing executed, nothing written.")
        return 0
    if not bulk:
        print("\nnothing to execute in bulk — every remaining proposal is a choice above.")
        return 0
    if not args.yes:
        try:
            reply = input(f"execute these {len(bulk)} action(s)? [y/N] ").strip().lower()
        except EOFError:
            reply = ""
        if reply not in ("y", "yes"):
            print("aborted — nothing executed.")
            return 0

    # William's word is given. Re-fetch and re-derive NOW — the y/N wait can be minutes, and
    # the world may have moved (a mid-wait re-approval must never get its branch deleted) — and
    # execute only what is STILL eligible. An item that dropped out is skipped, never forced.
    ls2 = _janitor_loopstate(home)
    if ls2 is None:
        print("janitor: state/issues.json became unreadable during the wait — refusing to "
              "execute (nothing is provably idle anymore).", file=sys.stderr)
        return 1
    # The SAME refused set the listing used. A key held back there was never proposed and so was
    # never approved, so nothing changes for the three tidy classes — but the accidental-close
    # class fills its per-sweep cap from the non-refused ones (issue #229), so a re-derivation that
    # disagreed about `refused` would select different reopens and then skip the owner's approved
    # ones as "state moved during the wait" when nothing moved.
    #
    # What is reconciled is `bulk`, NOT `props` (issue #225): the y/N above offered only the
    # bulk-approvable proposals, and the grouped alternatives were printed as choices requiring an
    # explicit `--execute-keys` tap. Passing the full `props` here would let one "y" execute every
    # member of a `type:` menu at once — manufacturing the `type_duplicate` defect the menu exists
    # to fix, off an approval the owner was never shown.
    fresh = janitor_lib.propose(**_janitor_fetch(ls2, cfg), now=time.time(), aged_park_days=days,
                                refused=refused_keys, dev_branch=dev)
    to_run, skipped = janitor_lib.reconcile(bulk, fresh["proposals"])
    now = time.time()
    executed = failed = 0
    for p in skipped:
        print(f"  skip  {p['key']} — no longer eligible (state moved during the wait)")
        journal.append(home, {"act": "janitor", "action": p["action"], "target": p["target"],
                              "outcome": "skipped",
                              "why": "no longer eligible at execution time"}, now)
    for p in to_run:
        ok, reason = _janitor_execute(p)
        journal.append(home, {"act": "janitor", "action": p["action"], "target": p["target"],
                              "why": p["why"], "outcome": "ok" if ok else "fail",
                              **({"reason": reason} if reason else {})}, now)
        if ok:
            refused_map.pop(p["key"], None)
            executed += 1
            print(f"  ok    {p['key']}")
        else:
            refused_map[p["key"]] = {"reason": reason, "ts": now}
            failed += 1
            print(f"  FAIL  {p['key']} — {reason}; held back from future sweeps "
                  f"(--retry-refused re-proposes)")
    # A refusal is NEVER pruned on a key's absence from a sweep: absence is not proof the
    # debris is gone — a transient gh blip produces the same absence (every read fails closed
    # to empty), and pruning on it would silently drop the hold-back and let a later sweep
    # retry a refused action without --retry-refused (cross-review round 1, C1). An entry
    # clears ONLY via a later successful execution (the pop above); a moot entry lingers
    # harmlessly (held-back keys that never re-propose never act). Only the execute path
    # writes state; list/--dry-run changes nothing anywhere.
    os.makedirs(os.path.dirname(refused_path), exist_ok=True)   # a first sweep may precede any runner run
    loopstate.save(refused_path, refused_map)
    print(f"janitor: {executed} executed, {failed} failed, {len(skipped)} skipped.")
    return 1 if failed else 0


# ------------------------------- upkeep (issue #200) -------------------------------
# `superlooper upkeep` is the weekly once-over as ONE read-only command: the routine glances that
# were previously remembered chores (doctor --stack, publish drift, the janitor's sweep, the ops-doc
# lint, branch/worktree sprawl, is-the-notify-channel-alive, the loop's own question/park rates)
# batched into one short page. Nothing here executes, and nothing here writes — not a state file,
# not a GitHub write, not even the notify test message `doctor --stack` sends on purpose. Every
# finding names the EXISTING approve path that acts on it (janitor's y/N, the gated bin/install.sh,
# a doc edit); adding an `--execute` is out of scope by the issue's Boundaries and stays out.
#
# Read-only is enforced by what this function CALLS, not by care: janitor.propose (the same pure
# selector `--dry-run` uses, with no execute path reachable from here), check_stack under the
# SKIP_SEND sentinel, gitops.worktree_reclaim_block (documented read-only and network-free), and
# journal.read. The layout and all the census arithmetic live in lib/upkeep.py, pure and
# unit-tested; this half only gathers.

_UPKEEP_WORKTREE_RE = re.compile(r"i\d+")


def _upkeep_janitor_view(home, cfg, dev):
    """(view, branches) — the janitor's PROPOSALS only, plus the remote-branch snapshot the census
    reuses. The same fail-closed reads the interactive sweep does: a present-but-unreadable
    issues.json or refused map means nothing is provably idle, so we propose NOTHING and SAY why
    rather than rendering a reassuring empty sweep."""
    ls, _refused_map, refused_keys, err = _janitor_read_state(home, retry_refused=False)
    if err is not None:
        return {"error": err, "proposals": [], "held": [], "reopen_withheld": 0,
                "merged_open_withheld": 0}, {}
    # `cfg` matters: without it the territory facts are unknown, so the touches menus can never be
    # proposed and this weekly glance would report a DIFFERENT count than `superlooper janitor` on
    # the same repo — while pointing at that very command as the remedy (fresh-agent review).
    fetched = _janitor_fetch(ls, cfg)
    days = cfg["janitor"]["aged_park_days"]
    result = janitor_lib.propose(**fetched, now=time.time(), aged_park_days=days,
                                 refused=refused_keys, dev_branch=dev)
    # BOTH withheld counts ride along because upkeep's whole job is "did I miss anything": a weekly
    # glance that showed the capped ten and never said N more were found would be the one surface
    # where a bounded list reads as the whole picture (issue #229; issue #404 added the second
    # capped class, and dropping ITS count here would have re-made the same hole one class over —
    # the likelier one, since a repo whose dev_branch is not its DEFAULT branch has never had a
    # closing keyword honoured and finds one pair per merged issue on its first sweep).
    return ({"error": None, "proposals": result["proposals"], "held": result["refused"],
             "reopen_withheld": result.get("reopen_withheld") or 0,
             "merged_open_withheld": result.get("merged_open_withheld") or 0},
            fetched["branches"])


def _upkeep_worktrees(home):
    """(worktree ids on disk, {iid: reclaim-block reason or None}).

    The block reason comes from gitops.worktree_reclaim_block — read-only and network-free by
    construction (a `git status` plus a local rev-list against refs already on disk), which is why
    a weekly report may call it. It is what turns "5 checkouts on disk" into the one fact worth
    acting on: which of them hold work that exists nowhere else (issue #190)."""
    wdir = os.path.join(home, "worktrees")
    try:
        names = sorted(os.listdir(wdir))
    except OSError:
        return [], {}
    ids = [n for n in names if _UPKEEP_WORKTREE_RE.fullmatch(n)
           and os.path.isdir(os.path.join(wdir, n))]
    return ids, {i: gitops.worktree_reclaim_block(os.path.join(wdir, i)) for i in ids}


def cmd_upkeep(args):
    try:
        cfg = _load_config(args.repo)
    except (FileNotFoundError, ValueError) as e:
        # No config means no state home, no repo slug and nothing to census — there is no honest
        # page to print. Refuse, naming the one command that fixes it (the doctor's own posture).
        print("upkeep: %s\n  Run `superlooper adopt --repo %s` first, then "
              "`superlooper doctor --repo %s`." % (e, args.repo, args.repo), file=sys.stderr)
        return 2

    home = str(config_lib.state_home(cfg))
    dev = cfg.get("dev_branch") if isinstance(cfg.get("dev_branch"), str) else "main"
    now = time.time()
    records = journal.read(home)

    # SKIP_SEND: doctor --stack proves the notify channel by SENDING one live message; upkeep must
    # not, so the block reports "configured, not sent" and the notify ROW below leans on the canary
    # the morning push already journaled. announce is silenced for the same reason — there is no
    # side effect to announce.
    stack = stack_doctor.check_stack(cfg, sender=stack_doctor.SKIP_SEND,
                                     announce=lambda *a, **k: None, repo_path=args.repo)

    # Probe GitHub ONCE, up front. The janitor and branch censuses read from gh, and gh reads fail
    # CLOSED to empty — correct for the acting verbs, but here it would render "nothing to propose,
    # 0 branches" for a repo that was simply unreachable, the exact reassuring page a weekly glance
    # should never fabricate. So when gh is down we mark both rows UNREAD rather than reading a
    # refusal as a clean result. (check_stack already surfaces the gh outage as its own FAIL.)
    if gh.probe():
        janitor_view, branches = _upkeep_janitor_view(home, cfg, dev)
        branches_view = upkeep_lib.branch_census(branches, janitor_view["proposals"])
    else:
        janitor_view = {"error": None, "proposals": [], "held": [], "unread": True}
        branches_view = {"unread": True}

    try:
        st = loopstate.load(os.path.join(home, "state", "issues.json"))
    except (OSError, ValueError):
        st = {}
    st = st if isinstance(st, dict) else {}
    issues = st.get("issues") if isinstance(st.get("issues"), dict) else {}
    wt_ids, wt_blocks = _upkeep_worktrees(home)

    view = {
        "repo": cfg.get("repo"),
        "repo_path": os.path.abspath(args.repo),
        "state_home": home,
        "date": time.strftime("%Y-%m-%d", time.localtime()),
        "stack": upkeep_lib.fold_stack(stack),
        # Same call the morning report makes (issue #39): git is impure, so it lives out here.
        "engine_drift": stack_doctor.engine_drift(repo_path=args.repo, dev_branch=dev),
        "janitor": janitor_view,
        # The ops-doc lint (issue #199) reads THIS repo's docs; for every adopted repo but the
        # engine's own monorepo there are none, and lint() skips cleanly rather than inventing a
        # verdict — the same posture engine_drift takes with no source checkout.
        "doc_lint": doc_lint.lint(args.repo),
        "branches": branches_view,
        "worktrees": upkeep_lib.worktree_census(wt_ids, issues, wt_blocks),
        # WEEK_SECONDS window: a delivered canary older than the report window is not "healthy",
        # it is unproven — the weekly cadence is what makes that freshness bound necessary (the
        # morning report's canary is minutes old, so it passes no window).
        "notify": report.notify_canary(records, now=now,
                                       max_age_seconds=upkeep_lib.WEEK_SECONDS),
        "week": upkeep_lib.week_counts(records, now),
    }
    for line in upkeep_lib.render(view):
        print(line)
    # Always 0 on an adopted repo: this is a REPORT, not a gate. A nonzero exit would make it
    # unusable in the one place it belongs — a routine weekly glance — by turning "there are two
    # things to look at" into "something is broken".
    return 0


# ------------------------------- watchdog (issue #66) -------------------------------
# `superlooper watchdog` is ONE mechanical health check — the unattended-debugger fallback.
# No LLM call exists anywhere on this path and it makes no repair decisions: it reads the
# engine's own signals (state/runner.heartbeat, state/ALERT, the no-progress shape), and per
# lib/watchdog.py's episode rules notifies -> waits the grace -> launches ONE sl-debugger
# session through the SAME launcher workers use (launch-session.py --cwd,
# never a headless `claude -p` — owner billing rule). Run it on an interval via
# templates/launchd.watchdog.plist (it may run under launchd: a check needs no cmux pane;
# the rare launch targets the RUNNER's recorded anchor and fails loudly when none resolves).
# state/WATCHDOG_OFF disables the whole path; every transition is journaled.

WATCHDOG_LAUNCH_TIMEOUT = 180   # the launcher verifies delivery within ~30s; generous

# THE launcher — the single spawn path (issue #308), shared with the runner (runner.LAUNCHER) so
# the exit-code contract evidence.py reads has one author. SL_LAUNCH_SESSION stays the test seam
# it always was; production resolves the engine's own copy beside this script.
LAUNCHER = "launch-session.py"


def _launcher():
    return os.environ.get("SL_LAUNCH_SESSION") or os.path.join(_HERE, LAUNCHER)


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True


def _live_lock(path):
    """A lock file naming a LIVE pid. Unreadable/garbage content reads as dead (reclaimable)."""
    pid = (_read(path) or "").strip()
    return pid.isdigit() and _pid_alive(int(pid))


def _watchdog_acquire_lock(lock_path):
    """Per-state-home singleton acquire — ported from start-session.sh's `ln`-of-temp worker lock.
    We write our pid into a temp file and then HARDLINK it onto the lock: `ln`/O_EXCL fails if the
    lock already exists, so ACQUIRING A FREE SLOT is atomic — of any number of checks racing for an
    absent lock, exactly ONE wins the link and the rest see its live pid and yield. This is the
    guarantee that closes the OLD check-then-write hole (its read-liveness → open(,"w") let a
    launchd firing and a hand-run check BOTH pass the check and BOTH write watchdog.json — the
    duplicate-episode / burned-launch race, issue #92). The pid is present BEFORE the file becomes
    the lock, so there is no empty-content window a racer could misread as stale (start-session.sh's
    codex P1-a lesson). Returns True iff we now hold the lock; False when a LIVE check owns it.

    A dead/garbage holder is reclaimed, GUARDED by a content re-check: remove the lock only if it
    still names that same dead holder, so we don't delete a fresh lock a concurrent claimer won
    between our read and our remove. This guard NARROWS but does not fully eliminate the reclaim
    race (a POSIX file op cannot atomically 'remove-if-content-is-X'); the residual is the same in
    kind as loopstate._acquire's stale-steal and start-session.sh's worker singleton, and it is
    reachable only when a check has already crashed leaving a stale lock AND two more checks race to
    reclaim it AND one is preempted mid-reclaim — a rare cube for a job that fires minutes apart. A
    duplicate episode text or a burned launch attempt (both self-limiting via the episode rails) is
    the worst case, never a corrupt state file."""
    me = str(os.getpid())
    state_dir = os.path.dirname(lock_path) or "."
    for _ in range(50):
        fd, tmp = tempfile.mkstemp(dir=state_dir, prefix="watchdog.", suffix=".lock.tmp")
        try:
            os.write(fd, me.encode())               # full content BEFORE it becomes the lock
        finally:
            os.close(fd)
        linked = False
        try:
            os.link(tmp, lock_path)                 # atomic create-with-content; fails if lock exists
            linked = True
        except FileExistsError:
            pass
        except OSError:
            _rm_quiet(tmp)
            return False                            # a fs that can't link -> yield, never double-run
        finally:
            _rm_quiet(tmp)
        if linked:
            return True
        holder = (_read(lock_path) or "").strip()
        if holder.isdigit() and _pid_alive(int(holder)):
            return False                            # a LIVE check owns it
        # dead/garbage holder -> reclaim, but only if the lock STILL names that same holder (content
        # re-check), so we never remove a fresh lock a concurrent claimer just won between our read
        # and our remove. Then loop: the atomic link above arbitrates the now-free slot.
        if (_read(lock_path) or "").strip() == holder:
            _rm_quiet(lock_path)
    return False


def _watchdog_release_lock(lock_path):
    """Ownership-checked release: remove the lock ONLY if it still names US (start-session.sh's
    release_worker) — after a reclaim race the file may name a different check, and an
    unconditional remove would break the singleton by deleting their lock."""
    if (_read(lock_path) or "").strip() == str(os.getpid()):
        _rm_quiet(lock_path)


def _rm_quiet(path):
    try:
        os.remove(path)
    except OSError:
        pass


def _watchdog_heartbeat(state_dir):
    """Epoch of the last COMPLETED runner tick, or None when the loop never ran here (an
    absent heartbeat is not a stale one) or the file is unreadable/garbage (fail toward
    no-signal: the ALERT/no-progress detectors still stand, and a corrupt heartbeat file
    would otherwise read as an eternal 3am trip)."""
    txt = _read(os.path.join(state_dir, "runner.heartbeat"))
    try:
        return int((txt or "").strip())
    except ValueError:
        return None


def _watchdog_stopped(state_dir):
    """True when the owner deliberately stopped this runner (issue #239) — state/runner.stopped is
    present. EXISTENCE is the signal, so a corrupt body still counts: the failure this guards
    against is a guardian reading the owner's own instruction as a crash and restarting the loop
    they turned off, and a stray byte in an audit field is no reason to do that."""
    from runner import read_stop_marker
    return read_stop_marker(state_dir) is not None


def _watchdog_runner_view(state_dir):
    """``(live, started_at, dead)`` for the recorded runner — ONE read, three facts.

    `live` and `dead` are not each other's negation, and that is the point: the third state — no
    pidfile at all, which is what a CLEAN exit leaves — is neither. Only a positive `live` read may
    decide that a stop did not take, because the unsafe direction is believing a runner is gone
    when it is up; and only a positive `dead` read may drive a restart, because the unsafe
    direction there is restarting a loop somebody stopped.

    `started_at` is when that runner took the singleton, from its pidfile's mtime: the file is
    written once, by the process that won the lock, and never refreshed (the re-exec path adopts it
    in place rather than rewriting it). None whenever the runner is not live, so it is never read
    about a corpse.

    `dead` is the third: the pidfile names a pid that is GONE (a crash leaves the file behind; a
    clean stop removes it). It rides here rather than in its own read because live and dead are
    consumed as a pair — read separately, a runner that exits between them can answer True to both,
    which skips the deliberate-stop stand-down and lets the resurrection path restart a loop the
    owner switched off.

    Answered TOGETHER because they are consumed together: derived from separate reads, a runner
    that booted in the gap yields live=True with started_at=None — which is exactly the spurious
    "wedged" episode the set exists to prevent (fresh-agent review)."""
    lock = os.path.join(state_dir, "runner.lock")
    txt = _read(lock)
    recorded = (txt or "").strip()
    # A garbage (non-numeric) or non-positive pidfile is NOT a clean recorded-dead-pid signal, so it
    # earns neither answer: a weird pidfile falls through to the debugger/notify path rather than
    # auto-restarting on a state nobody can read.
    pid = int(recorded) if recorded.isdigit() and int(recorded) > 0 else None
    if pid is None:
        return False, None, False
    if not _pid_alive(pid):
        return False, None, True
    try:
        return True, os.path.getmtime(lock), False
    except OSError:
        return True, None, False


def _watchdog_alert(state_dir):
    """The ALERT dict, {} when present-but-unreadable (existence IS the signal — fail
    closed, runner._read_json's posture), None when absent."""
    path = os.path.join(state_dir, "ALERT")
    if not os.path.exists(path):
        return None
    v = _read_json_file(path, {})
    return v if isinstance(v, dict) else {}


def _watchdog_loopstate(state_dir):
    """The persisted issue state (issues.json), or {} when absent/corrupt. Read ONCE per check and
    shared by the lane-occupancy and gh-eligibility views so they see the same disk truth."""
    try:
        return loopstate.load(os.path.join(state_dir, "issues.json"))
    except (OSError, ValueError):
        return {}


def _watchdog_lanes_busy(st, state_dir):
    """Any lane occupied, from DISK truth: an in-flight status in issues.json, or a live
    worker singleton lock for an issue id (a session the state file has not caught up with).
    NB gating/holding statuses hold a territory CLAIM but occupy no lane, so they are NOT
    lanes-busy — the no-progress view respects them through scheduler.launchable instead."""
    import actions
    if actions.lane_state_from(st):
        return True
    try:
        names = os.listdir(state_dir)
    except OSError:
        names = []
    return any(n.startswith("worker.i") and n.endswith(".lock")
               and _live_lock(os.path.join(state_dir, n)) for n in names)


def _watchdog_debugger_live(state_dir):
    """A live unattended sl-debugger session: any worker.d<N>.lock naming a live pid
    (start-session.sh's per-id singleton — the same file that keeps workers single)."""
    try:
        names = os.listdir(state_dir)
    except OSError:
        return False
    return any(n.startswith("worker.d") and n.endswith(".lock")
               and _live_lock(os.path.join(state_dir, n)) for n in names)


def _watchdog_gh_view(cfg, st):
    """(gh_ok, eligible_nums): the no-progress detector's eligibility read — the issues the
    SCHEDULER would launch RIGHT NOW, so every scheduler hold is respected and a designed-safe
    wait can never read as waiting work:
      * agent-ready issues from GitHub, run through the same issues.eligible rule the scheduler
        uses (blocked-by holds, in-progress, parked/needs-owner all excluded);
      * lane capacity + anti-affinity + TERRITORY CLAIMS from issues.json — the #92 fix: a
        gating/holding issue's claim occupies no lane but holds the eligible work behind it.
    gh_ok is False when the view is UNOBSERVABLE, so the caller FREEZES the clocks instead of
    reading a refusal as 'nothing eligible': the probe is down, OR (the #92 trap) the probe
    SUCCEEDS but a list read is REFUSED — read-health `ok` distinguishes that from a genuine
    empty answer (the #21/#61 contract). A clean answered-empty read is observable (gh_ok True)."""
    import actions
    import watchdog as watchdog_lib
    if not gh.probe():
        return False, []
    ready = gh.ready_issues_health()
    closed = gh.closed_issue_nums_health()
    if not ready.ok or not closed.ok:
        return False, []                    # probe ok but a read REFUSED -> unobservable
    parsed = [issues_lib.parse_issue(r) for r in ready.value]
    lane_state = actions.lane_state_from(st)
    claims = actions.territory_claims_from(st)
    return True, watchdog_lib.launchable_nums(parsed, lane_state, cfg, closed.value, claims)


def _watchdog_usage_exhausted():
    """True only when the meter SUCCESSFULLY reads strictly OVER a launch ceiling — the runner's
    designed fail-closed hold. A dark/unreadable meter is False (the #46/#76 asymmetry): it
    must never suppress the detector, especially under launchd where the Keychain read can
    fail. SL_FAKE_USAGE injects the read for tests/simulation, exactly like cmd_run."""
    import watchdog as watchdog_lib
    fake = os.environ.get("SL_FAKE_USAGE")
    try:
        if fake:
            usage = json.loads(fake)
        else:
            import usage as usage_mod
            usage = usage_mod.fetch_claude_usage()
    except Exception:
        return False
    return watchdog_lib.usage_reads_exhausted(usage)


def _watchdog_pane(state_dir):
    """The cmux pane the debugger tab is born in: an explicit $SL_PANE override, else the
    RUNNER's recorded anchor (state/runner.anchor.json — present while a runner is live or
    crashed; a clean stop clears it), else this process's own tab when run by hand inside
    cmux. "" when nothing resolves — the launch then fails loudly, never silently."""
    pane = os.environ.get("SL_PANE") or ""
    if pane.strip():
        return pane.strip()
    anchor = _read_json_file(os.path.join(state_dir, "runner.anchor.json"), None)
    if isinstance(anchor, dict):
        pane = anchor.get("pane")
        if isinstance(pane, str) and pane.strip():
            return pane.strip()
    from runner import detect_self_anchor
    return detect_self_anchor()["pane"]


def _debugger_shim_run(cfg, repo, home, pane, sid, attended=False):
    """Run ONE debugger session (``d<N>``) through the launcher — the single handshake shared by
    the watchdog's UNATTENDED launch and ``superlooper debug``'s owner tap (issue #144), which is
    also the dashboard Fixer's spawn (it shells ``superlooper debug``). Returns
    ``(rc, stdout, stderr, spawned)``; NEVER raises.

    Both ``d<N>`` spawners moved onto the session-host wrapper in the SAME wave as the worker
    (issue #308), through this one function. That is the whole point of it existing: had the runner
    been rewired alone, the two paths that repair an unattended loop would have been left calling a
    launcher that no longer exists — no unattended repair at exactly the moment repair is needed.

    ``pane`` is accepted and IGNORED. The host has no launch anchor: a session is created by the
    wrapper against the server, not born inside some tab whose id the caller had to find first. The
    parameter stays so the watchdog's own "can I launch at all?" reporting keeps its shape until
    the cmux retirement settles what replaces it.

    ``attended`` is the ONE thing the two callers genuinely disagree about: the owner tap has a
    person at the keyboard and its brief invites them to ask, the watchdog's does not. It rides in
    as ``SL_ATTENDED`` so the PreToolUse deny (issue #185) can stand its AskUserQuestion duty down
    for the tap instead of telling that session "no human is at this pane" — which its own brief
    contradicts. PINNED on both paths, never inherited: an ambient ``export SL_ATTENDED=1`` in
    whatever shell a watchdog check runs from would otherwise hand the unattended session a dialog
    nobody can answer — the exact all-night stall (i280) the deny exists to prevent.

    Sharing it is the point: the ``--cwd`` invocation form, the ``SL_RUN_ROOT``/``SL_PANE`` contract,
    the seat defaults and the pinned verify window are ONE fact with one place to change, so a second
    caller can never drift from the first (before #144 the command center held a hand-copied
    duplicate of all of it, outside the engine, with no stability contract).

    ``spawned`` is False ONLY when the process never started at all (an ``OSError`` from the exec):
    the caller uses it to clean up a brief that reached nobody. A TIMEOUT is spawned=True — the tab
    may yet deliver late, so its brief must stay."""
    models = cfg.get("models") if isinstance(cfg.get("models"), dict) else {}
    script = _launcher()
    env = {**os.environ,
           "SL_RUN_ROOT": home, "SL_PANE": pane,
           # The debugger is the loop's one remaining hired-judgment seat (diagnose-vs-escalate on a
           # stuck instance), so it runs on the strongest configuration by default. `models.debugger`
           # is the per-repo pin — the field was called `models.answerer` until #194 retired the
           # answerer and left the debugger its only reader.
           "SL_MODEL": models.get("debugger") or "opus[1m]", "SL_EFFORT": "",
           # PIN the launcher's verify window (review P1-1): the launcher inherits
           # SL_LAUNCH_VERIFY_SECONDS, and an ambient large value (a debugging export, a
           # LaunchAgent env) would let the launch outlive WATCHDOG_LAUNCH_TIMEOUT — rc=124
           # counts a FAILED attempt while the tab delivers late and a real session starts,
           # so a later check could launch a SECOND session for one episode. 30s is the
           # script's own default and sits far under the 180s timeout.
           "SL_LAUNCH_VERIFY_SECONDS": "30",
           "SL_ATTENDED": "1" if attended else "",
           # PINNED EMPTY (#298), same reasoning as SL_ATTENDED above: this env is merged over
           # os.environ, so an ambient SL_RESUME_SESSION_ID would silently turn a FRESH debugger
           # launch into a resume of some unrelated conversation. `superlooper resume` sets it
           # deliberately on its own launch; nothing else may inherit it.
           "SL_RESUME_SESSION_ID": "",
           # PINNED EMPTY (#299), same reasoning: `superlooper debug` is typically typed FROM a
           # session that already carries SL_EXPECT_GH_LOGIN, and inheriting it would let the
           # debugger launch skip the launcher's own identity read and trust a second-hand answer.
           "SL_EXPECT_GH_LOGIN": "",
           "SL_AGENT": cfg.get("agent") if cfg.get("agent") in ("claude", "codex") else "claude"}
    try:
        r = subprocess.run([script, "--cwd", os.path.abspath(repo), sid],
                           env=env, capture_output=True, text=True,
                           timeout=WATCHDOG_LAUNCH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124, "", "timed out", True
    except (OSError, ValueError):
        return 127, "", "could not run the launch shim", False
    return r.returncode, r.stdout, r.stderr, True


def _watchdog_launch(repo, cfg, home, state_dir, launch, state):
    """Execute one launch request through the SAME shim stack workers use. Returns the rc
    fed to watchdog.after_launch: 0 only when the launcher VERIFIED delivery."""
    import watchdog as watchdog_lib
    ep = state.get("episode") if isinstance(state.get("episode"), dict) else {}
    wd = cfg.get("watchdog") if isinstance(cfg.get("watchdog"), dict) else {}
    template = _read(os.path.join(_TEMPLATES, "debugger-brief.md")) or ""
    brief = watchdog_lib.render_brief(template, {
        "signals": ", ".join(launch.get("signals") or []),
        "detail": ep.get("detail") or ", ".join(launch.get("signals") or []),
        "authority": launch.get("authority"),
        "allowlist": ", ".join(launch.get("allowlist") or []) or "(none)",
        "state_home": home,
        "repo_path": os.path.abspath(repo),
        "repo_slug": cfg.get("repo"),
        "grace_minutes": wd.get("grace_minutes", 30),
    })
    os.makedirs(os.path.join(home, "briefs"), exist_ok=True)
    with open(os.path.join(home, "briefs", f"{launch['id']}.md"), "w") as f:
        f.write(brief)
    # NO PANE GATE ANY MORE (issue #308). The old launcher had to be told which cmux pane to open
    # a tab in, so a watchdog check that could not resolve one refused up front — and under a
    # login-item runner (issue #306) none resolves, which would have made every unattended repair
    # a `no_pane` refusal at exactly the moment repair is needed. The wrapper creates a workspace
    # against the session host's server; there is no anchor to find and nothing to place. The
    # resolver survives for the RESURRECT path below, which still needs a pane of its own.
    rc, out, err, _spawned = _debugger_shim_run(cfg, repo, home, _watchdog_pane(state_dir),
                                                launch["id"])
    combined = (out or "") + (err or "")
    if combined.strip():
        print(combined.strip())
    return rc


def _watchdog_kickstart(cfg, resurrect):
    """Restart a provably-gone LOGIN-ITEM runner: ``launchctl kickstart -k`` on its own job
    (issue #306's half of issue #208).

    This is the same act as the pane path below and a far simpler one — there is no tab to place,
    no keystroke delivery to work around, and nothing to verify by polling a pidfile, because the
    supervisor either accepted the request or refused it. ``-k`` is load-bearing: the case this
    exists for includes a job that is still loaded around a wedged or dead process, and a plain
    kickstart would leave that exactly where it was.

    Returns the rc ``watchdog.after_resurrect`` reads — nonzero is journaled and notified as a
    FAILED restart, never as a recovery.
    """
    try:
        job = runner_home.label(cfg["repo"])
    except (KeyError, TypeError, ValueError):
        print("watchdog: cannot derive the runner's job label from `repo` — cannot restart it; "
              "notifying instead.", file=sys.stderr)
        return "no_job"
    argv = runner_home.kickstart_argv(_launchctl_bin(), _home_uid(), job)
    try:
        proc = subprocess.run(argv, capture_output=True, text=True,
                              timeout=WATCHDOG_LAUNCH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124
    except OSError:
        return 127
    out = ((proc.stdout or "") + (proc.stderr or "")).strip()
    if out:
        print(out)
    return proc.returncode


def _watchdog_resurrect(repo, cfg, home, state_dir, resurrect):
    """Execute one resurrect request (issue #208): RESTART the provably-gone runner — a
    deterministic zero-token process, never an LLM, never a worker tab. Returns the rc fed to
    watchdog.after_resurrect: nonzero is a FAILED restart, never a recovery.

    HOW it restarts is the runner's process home (issue #306), and getting this branch wrong is the
    adoption plan's named migration landmine: a watchdog left calling a launcher that cannot work
    means no unattended repair at exactly the moment repair is needed.

    * **login-item** → kickstart the job. No anchor, no tab, no pane to resolve.
    * **pane** → a fresh tab in the dead runner's recorded anchor pane, via resurrect-runner.sh (the
      keystroke-free shim, running `superlooper run`), verified by its pidfile naming a live pid. A
      gone/unresolvable pane returns "no_pane" — a new tab cannot be placed without the owner.

    The pane launcher is fully overridable via SL_RESURRECT_RUNNER (tests inject a fake, like the
    debugger path's SL_LAUNCH_SESSION). `cfg` was accepted for call-site symmetry with
    _watchdog_launch and is now read for exactly one thing — which home this runner lives in. The
    runner still re-reads the repo's config itself on boot, so nothing else from this process's view
    of it rides into the restart.
    """
    if runner_home.kind(cfg) == runner_home.LOGIN_ITEM:
        return _watchdog_kickstart(cfg, resurrect)
    pane = _watchdog_pane(state_dir)
    if not pane:
        print("watchdog: no cmux pane resolves for the dead runner (no recorded anchor / not inside "
              "cmux) — cannot resurrect; notifying instead.", file=sys.stderr)
        return "no_pane"
    script = os.environ.get("SL_RESURRECT_RUNNER") or os.path.join(_HERE, "resurrect-runner.sh")
    # The reborn runner's fresh tab shell inherits NONE of this process's env, so NAME the CLI to
    # (re)start explicitly — our own resolved bin path, so it reloads the exact installed engine.
    bin_path = os.environ.get("SL_SUPERLOOPER_BIN") or os.path.abspath(sys.argv[0])
    env = {**os.environ, "SL_RUN_ROOT": home, "SL_PANE": pane, "SL_SUPERLOOPER_BIN": bin_path,
           # PIN the verify window (HARDCODE, exactly like _watchdog_launch's P1-1 — do NOT pass the
           # ambient value through): an ambient SL_LAUNCH_VERIFY_SECONDS > WATCHDOG_LAUNCH_TIMEOUT (a
           # debugging export, a LaunchAgent env) would let resurrect-runner.sh's poll outlive the
           # subprocess timeout below, so subprocess.run kills the child MID-POLL — its failure
           # cleanup (close the orphan tab, remove the dropped .cmd time-bomb) never runs, and a
           # slow-but-successful restart records a false resurrect_failed. 30s sits far under 180s.
           "SL_LAUNCH_VERIFY_SECONDS": "30"}
    try:
        r = subprocess.run([script, "--cwd", os.path.abspath(repo), resurrect["id"]],
                           env=env, capture_output=True, text=True, timeout=WATCHDOG_LAUNCH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124
    except OSError:
        return 127
    out = (r.stdout or "") + (r.stderr or "")
    if out.strip():
        print(out.strip())
    return r.returncode


def cmd_watchdog(args):
    import watchdog as watchdog_lib
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    state_dir = os.path.join(home, "state")
    os.makedirs(state_dir, exist_ok=True)
    now = time.time()

    # Per-state-home singleton: a hand-run check and the launchd firing must not interleave their
    # read-evaluate-write on watchdog.json. Acquired ATOMICALLY (create-with-content via os.link,
    # not the old check-then-write) so two overlapping checks racing to acquire a FREE slot can
    # never both proceed; a dead holder's lock is reclaimed via an atomic os.rename steal (one
    # winner per rename).
    lock = os.path.join(state_dir, "watchdog.lock")
    if not _watchdog_acquire_lock(lock):
        print("another watchdog check is live for this state home — exiting")
        return 0
    try:
        st = _watchdog_loopstate(state_dir)
        runner_live, runner_started_at, runner_dead = _watchdog_runner_view(state_dir)
        heartbeat = _watchdog_heartbeat(state_dir)
        alert = _watchdog_alert(state_dir)
        lanes_busy = _watchdog_lanes_busy(st, state_dir)
        wd = cfg.get("watchdog") if isinstance(cfg.get("watchdog"), dict) else {}
        stale_secs = wd.get("heartbeat_stale_minutes",
                            watchdog_lib.HEARTBEAT_STALE_MINUTES_DEFAULT) * 60
        hb_fresh = isinstance(heartbeat, int) and now - heartbeat <= stale_secs
        # The gh eligibility read + usage read are spent only when they can matter: a stale
        # heartbeat is already the louder signal, and a busy lane is progress by definition.
        gh_ok, eligible = (False, [])
        if hb_fresh and not lanes_busy:
            gh_ok, eligible = _watchdog_gh_view(cfg, st)
        usage_exhausted = bool(eligible) and _watchdog_usage_exhausted()

        view = {"heartbeat": heartbeat, "alert": alert, "lanes_busy": lanes_busy,
                "gh_ok": gh_ok, "eligible_nums": eligible,
                "usage_exhausted": usage_exhausted,
                "kill_switch": os.path.exists(
                    os.path.join(state_dir, watchdog_lib.KILL_SWITCH_FILENAME)),
                "debugger_live": _watchdog_debugger_live(state_dir),
                # The owner's own off switch (issue #239). Read HERE, in the view, so there is
                # exactly ONE place the decision is made — the pure evaluate() — rather than a
                # second guard down in the executor that could disagree with it. The read sits as
                # late as the view is built and evaluate() is pure, so the window between "the
                # marker lands" and "we act" is arithmetic, not I/O.
                "stopped_by_owner": _watchdog_stopped(state_dir),
                # WHEN this runner started, so a heartbeat it inherited from the previous process
                # is not read as its own silence. Nothing stamps the heartbeat at boot.
                "runner_started_at": runner_started_at,
                # A stop that was REQUESTED is not a stop that TOOK (fresh-agent review): the pure
                # core honours the marker only when this is False, so a runner still up — because
                # the stop timed out on a long tick, or the bootout failed — is still watched.
                "runner_live": runner_live,
                "runner_dead": runner_dead}
        state_path = os.path.join(state_dir, watchdog_lib.STATE_FILENAME)
        prior = watchdog_lib.coerce_state(_read_json_file(state_path, None))

        res = watchdog_lib.evaluate(now, cfg, view, prior)
        for rec in res["journal"]:
            journal.append(home, rec, now)
        for title, body in res["notify"]:
            print(f"notify: {notify.send(cfg, title, body)}")

        final = res["state"]
        resurrect_rc = None
        # Runner resurrection (issue #208): a provably-gone runner is RESTARTED before any debugger
        # is hired for a wedge — a corpse needs restarting, not diagnosing. The attempt was already
        # recorded in evaluate() (so it counts toward the crash-loop cap even if delivery fails).
        if res.get("resurrect") is not None:
            # Persist the recorded attempt BEFORE the launcher runs. That subprocess can take up to
            # WATCHDOG_LAUNCH_TIMEOUT, and a watchdog killed inside that window would otherwise lose
            # the attempt entirely — leaving the cap slot un-burned and the next check free to
            # restart again. The cap is the ONLY anti-storm guard, so bias it to OVER-count: a lost
            # restart that still burned a slot is recoverable, a storm is not.
            loopstate.save(state_path, final)
            resurrect_rc = _watchdog_resurrect(args.repo, cfg, home, state_dir, res["resurrect"])
            done = watchdog_lib.after_resurrect(now, cfg, final, res["resurrect"], resurrect_rc)
            for rec in done["journal"]:
                journal.append(home, rec, now)
            for title, body in done["notify"]:
                print(f"notify: {notify.send(cfg, title, body)}")
            final = done["state"]
        # A provably-gone runner past the rolling-hour cap: no resurrect emitted. Read the RAW
        # provably-gone fact from evaluate(), NOT the journal: the escalation record is deduped to
        # once per capped streak, so every later capped check journals nothing and the summary read
        # "healthy — no signal" while the loop was down (fresh-review P1-1).
        capped = bool(res.get("runner_down")) and res.get("resurrect") is None
        if res["launch"] is not None:
            rc = _watchdog_launch(args.repo, cfg, home, state_dir, res["launch"], final)
            done = watchdog_lib.after_launch(now, cfg, final, res["launch"], rc)
            for rec in done["journal"]:
                journal.append(home, rec, now)
            for title, body in done["notify"]:
                print(f"notify: {notify.send(cfg, title, body)}")
            final = done["state"]

        loopstate.save(state_path, final)
        ep = final.get("episode")
        # An honest one-line summary for a hand-run check. The notify/journal already carry the
        # authoritative record; this must not contradict them (a capped/failed restart is NOT
        # "healthy", and a FAILED restart is not "resurrected").
        # Read the STATE, not the journal: the `disabled` record is deduped on the observed signal
        # set (one line per distinct observation, not one per check), so every later check journals
        # nothing while still observing the SAME signals — and reading the empty journal printed
        # "observed: no signal" over a corpse. evaluate() writes the current sigs to
        # disabled_observed on both kill-switch returns, so state is the honest source. Same defect
        # as the capped summary above (fresh-review P1-1); it lived two lines apart and was missed.
        disabled_sigs = (final.get("disabled_observed") or []) if view["kill_switch"] else []
        print("watchdog: " + ("DISABLED (state/WATCHDOG_OFF) — observed: "
                              + (", ".join(disabled_sigs) or "no signal")
                              if view["kill_switch"] else
                              # Never the word DOWN for a loop that is off on purpose: that word is
                              # what sends someone to a keyboard at 3am (issue #239). The liveness
                              # half is the same conjunction evaluate() uses, and it has to be
                              # repeated here rather than inferred from the absence of an episode:
                              # a marker over a LIVE runner is a stop that did not take, and this
                              # line saying "standing down" over a loop that is still merging is
                              # the fabrication the verb was built to avoid.
                              "runner STOPPED BY OWNER (state/runner.stopped) — standing down; "
                              "`superlooper start` re-arms this"
                              if view["stopped_by_owner"] and not view["runner_live"] else
                              "resurrected the runner" if resurrect_rc == 0 else
                              "runner is DOWN — restart FAILED" if resurrect_rc is not None else
                              # cap==0 was never a crash loop — nothing was ever attempted; saying
                              # "cap hit" there would misname a deliberate config choice.
                              ("runner is DOWN — auto-restart DISABLED "
                               "(watchdog.resurrection_max_per_hour = 0)"
                               if cfg["watchdog"]["resurrection_max_per_hour"] == 0 else
                               "runner is DOWN — auto-restart PAUSED (crash-loop cap hit)") if capped else
                              f"episode open ({', '.join(ep['signals'])})" if ep else
                              # A runner that has not stamped its first tick is not healthy — it is
                              # unproven, and saying so is the difference between a summary a
                              # person can act on and one that reads the same either way.
                              "runner booting — it has not completed a tick yet"
                              if final.get("resurrection", {}).get("booting_since") else
                              "healthy — no signal"))
        if view["stopped_by_owner"] and view["runner_live"] and not view["kill_switch"]:
            # Named rather than left to be inferred from the line above: the owner asked for this
            # loop to be off and it is not, and the only place that fact surfaces unprompted is a
            # check they may not be reading. `superlooper status` says the same thing.
            print("  NOTE: a stop was requested (state/runner.stopped) but the runner is still "
                  "running — the stop did not take, so this runner is still watched.")
        return 0
    finally:
        _watchdog_release_lock(lock)


# ------------------------------- debug (issue #144) -------------------------------
#
# The OWNER-TAP debugger launch — the attended sibling of `watchdog`'s unattended, episode-gated
# fallback. `watchdog` is a timer's verb: grace windows, authority tiers, once-per-incident. None of
# that fits a human standing at the keyboard who can see the trouble and answer questions, so the
# engine grew a second door rather than bending the first.
#
# It exists as an ENGINE verb (not as five conventions re-implemented by whoever wants a debugger)
# because two of the things a launch must get right are only reachable from in here:
#
#   * the d<N> allocator. It lives in state/watchdog.json ▸ next_debugger. A caller outside the
#     engine can READ that counter but must not write it — the watchdog's anti-storm rails live in
#     the same document behind this lock — so it could only ever step AROUND the watchdog's next id,
#     never claim it. A later watchdog launch would then reuse the id and overwrite the brief.
#   * single flight. Both sides can look for a live worker.d<N>.lock, but start-session.sh creates
#     that lock a beat AFTER the launch begins, so two checks landing in the same few seconds both
#     see "nobody home" and both launch. Holding state/watchdog.lock across the whole
#     check-allocate-launch — exactly as cmd_watchdog holds it across its entire check, launch
#     subprocess included — is what makes the two mutually exclusive rather than merely polite.
#
# Everything the CALLER knows stays the caller's: it passes the owner's note verbatim and whatever
# context it alone can assemble (the command center knows what the board is showing). The engine
# frames that into the brief, allocates, launches, and journals one line.

# The owner's note is his words, not a manuscript; the caller's context is a board readout, not a
# corpus. Both are BOUNDED so a stray paste can never drown the machine context it rides with —
# start-session.sh cats the whole brief in as the session's opening message.
_DEBUG_NOTE_MAX = 4000
_DEBUG_CONTEXT_MAX = 8000

_DEBUG_ID_RE = re.compile(r"^d([0-9]+)$")

_DEBUG_PLACEHOLDER_RE = re.compile(r"\{([a-z_]+)\}")


def _debug_render(template, mapping):
    """SINGLE-PASS ``{name}`` substitution over the ORIGINAL template (fresh-agent review).

    Deliberately NOT watchdog.render_brief's sequential ``str.replace`` chain. That chain
    substitutes each key in turn over the OUTPUT of the last, so a placeholder appearing inside an
    earlier value gets expanded: an owner note containing the literal text ``{context}`` would be
    rewritten into the board readout. The one promise this brief makes about the note is that it is
    VERBATIM — and only one pass over the original template can keep it. (The watchdog's own brief
    is rendered from engine-generated values, so its chain is safe; this one takes caller text.)

    An unknown ``{name}`` is left exactly as written — prose braces are ordinary text here."""
    return _DEBUG_PLACEHOLDER_RE.sub(
        lambda m: str(mapping[m.group(1)]) if m.group(1) in mapping else m.group(0), template)


def _debug_journal(home, record):
    """Journal one debug record, swallowing any write failure. journal.append normally fails LOUD
    (a record we cannot write is a bug) — but this call sits AFTER a launch that already happened.
    A bookkeeping failure that turned a real, delivered session into a traceback with no ``--json``
    body would tell the caller nothing launched; that belief is exactly what invites a second tap,
    and a second debugger on one patient is the thing this verb exists to prevent."""
    try:
        journal.append(home, record)
    except (OSError, ValueError):
        print("debug: could not write the journal record (the session still launched)",
              file=sys.stderr)


def _emit_debug(args, result):
    """Print a debug result: one JSON object when ``--json`` (for a local ops UI to parse), else a
    plain human line for a terminal operator."""
    if getattr(args, "json", False):
        sys.stdout.write(json.dumps(result) + "\n")
        return
    if result.get("ok") and result.get("verb") == "debug":
        sys.stdout.write("launched sl-debugger session %s — brief: %s\n"
                         % (result.get("id"), result.get("brief")))
    elif result.get("verb") == "debug-check":
        sys.stdout.write(("a debugger session (%s) is already live for this repo.\n"
                          % result.get("live_id")) if result.get("live")
                         else "no debugger session is live for this repo.\n")
    else:
        sys.stdout.write("no debugger launched: %s\n" % result.get("error"))


def _debug_live_id(state_dir):
    """The id of a LIVE debugger session, or None — any ``worker.d<N>.lock`` naming a live pid
    (start-session.sh's per-id singleton, the SAME file _watchdog_debugger_live reads, so a tapped
    session blocks the watchdog and a watchdog session blocks a tap)."""
    try:
        names = sorted(os.listdir(state_dir))
    except OSError:
        return None
    for n in names:
        if n.startswith("worker.d") and n.endswith(".lock") \
                and _live_lock(os.path.join(state_dir, n)):
            return n[len("worker."):-len(".lock")]
    return None


def _debug_seen_ids(home, state_dir):
    """Every ``d<N>`` this state home has already handed out, from the two places a launch leaves
    one behind: a composed brief and a session lock (live or stale)."""
    out = []
    for directory, prefix, suffix in ((os.path.join(home, "briefs"), "", ".md"),
                                      (state_dir, "worker.", ".lock")):
        try:
            names = os.listdir(directory)
        except OSError:
            continue
        out += [n[len(prefix):len(n) - len(suffix)] for n in names
                if n.startswith(prefix) and n.endswith(suffix)]
    return out


def _debug_allocate(state_path, home, state_dir):
    """Take the next debugger id and write the counter FORWARD — the co-authorship a caller outside
    the engine could not have. Must be called while HOLDING state/watchdog.lock: that is what keeps
    this read-modify-write and the watchdog's own from interleaving.

    The counter is authoritative, but a brief or lock sitting ABOVE it also bars its number: ids
    allocated out of band before this verb existed (the command center's own allocator, issue #141)
    can sit higher than next_debugger, and handing one out again would overwrite that session's
    brief. So allocate past whichever is greater, and leave the counter above BOTH.

    The whole watchdog document is round-tripped through coerce_state, never rewritten from scratch:
    the episode state machine and its anti-storm rails live in the same file, and this verb is a
    co-author of exactly one field."""
    import watchdog as watchdog_lib
    st = watchdog_lib.coerce_state(_read_json_file(state_path, None))
    n = st.get("next_debugger", 1)
    for name in _debug_seen_ids(home, state_dir):
        m = _DEBUG_ID_RE.match(name)
        if m:
            n = max(n, int(m.group(1)) + 1)
    st["next_debugger"] = n + 1
    loopstate.save(state_path, st)          # DURABLE before anything launches — see cmd_debug
    return "d%d" % n


def _debug_bounded(text, limit, what):
    """A caller-supplied string, trimmed and BOUNDED — truncation is STATED in the text so the
    session reads a visible cut rather than silently losing the end of an instruction."""
    text = (text or "").strip()
    if len(text) > limit:
        text = text[:limit].rstrip() + ("\n\n[%s truncated at %d characters]" % (what, limit))
    return text


def _debug_context(args):
    """``(context, error)`` — the caller's composed context, read from ``--context-file`` (``-`` is
    stdin, so a large board readout can never hit an argv limit). Absent ⇒ empty, which is a normal
    hand-run invocation, not an error. An unreadable file IS an error: a launch that silently
    dropped the context it was handed would send the session in half-informed."""
    src = getattr(args, "context_file", None)
    if not src:
        return "", None
    # Read at most ONE character past the bound (fresh-agent review): the value is truncated to
    # _DEBUG_CONTEXT_MAX anyway, and reading a whole file first only means a stray `--context-file
    # /var/log/something-huge` is pulled into memory before being thrown away. The extra character
    # is what lets _debug_bounded still SEE that it overflowed and say so.
    cap = _DEBUG_CONTEXT_MAX + 1
    if src == "-":
        return sys.stdin.read(cap), None
    try:
        with open(src) as f:
            return f.read(cap), None
    except OSError as e:
        return None, "could not read the context file %s: %s" % (src, e)


def _debug_brief(cfg, home, repo, operator, source, note, context):
    """The launched session's ENTIRE opening message. Rendered by :func:`_debug_render` — literal,
    SINGLE-PASS ``{name}`` substitution (never str.format, which chokes on the prose braces a note
    may carry; and never a sequential replace chain, which would expand a placeholder the caller's
    own text contained).

    Deliberately does NOT tell the debugger how to work: its authority, its ladder and its
    exclusions are the sl-debugger skill's own contract. The one thing this brief must assert is the
    MODE — a person is at the keyboard, so the skill's human-present contract applies and the
    watchdog's unattended one does not."""
    template = _read(os.path.join(_TEMPLATES, "debugger-brief-owner.md")) or ""
    note = _debug_bounded(note, _DEBUG_NOTE_MAX, "note")
    context = _debug_bounded(context, _DEBUG_CONTEXT_MAX, "context")
    return _debug_render(template, {
        "operator": operator,
        "source": source,
        "note": note or ("*(no note — they launched the fixer without typing one, so whatever "
                         "follows is the whole of what they handed you.)*"),
        "context": context or ("## Context from the caller\n\n*(none — nothing rode in beyond the "
                               "note above. Start from the state home's own truth.)*"),
        "repo_slug": cfg.get("repo") or "?",
        "repo_path": os.path.abspath(repo),
        "state_home": home,
    })


def _debug_error(rc, stderr, stdout):
    """A plain, honest failure message for a launch that did not land — what a caller shows instead
    of a fake success. Never a bare exit code: the operator can act on words."""
    msg = (stderr or "").strip() or (stdout or "").strip()
    if rc == 124:
        return "the launch timed out — no session was confirmed"
    if rc == 127:
        return "could not run the engine's launcher — is superlooper installed?"
    return msg or ("the launch failed (exit %d) — no session was confirmed" % rc)


def cmd_debug(args):
    """Launch ONE interactive sl-debugger session on this repo, because a person asked for it.

    Refuses — changing nothing, launching nothing — when a debugger is already live, when a watchdog
    check holds the lock. ``ok`` is the shim's real verdict on
    delivery, never a pretend one. ``--check`` is the read-only preflight (writes NOTHING), so a
    confirm dialog can decide what to show before the owner commits."""
    import watchdog as watchdog_lib
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    state_dir = os.path.join(home, "state")
    operator = (args.operator or "").strip() or "the owner"
    source = (args.source or "").strip() or "cli"

    if getattr(args, "check", False):
        live = _debug_live_id(state_dir)
        _emit_debug(args, {"ok": True, "verb": "debug-check", "id": None,
                           "live": live is not None, "live_id": live})
        return 0

    context, ctx_err = _debug_context(args)
    if ctx_err is not None:
        _emit_debug(args, {"ok": False, "verb": "debug", "id": None, "live": None,
                           "live_id": None, "error": ctx_err})
        return 1

    def refuse(error, **extra):
        out = {"ok": False, "verb": "debug", "id": None, "live": False, "live_id": None,
               "error": error}
        out.update(extra)
        _emit_debug(args, out)
        return 1

    # Every failure below must reach the caller as the --json CONTRACT, never as a traceback: a UI
    # that gets an empty stdout and a stack trace on stderr cannot tell a refusal from a crash, and
    # this is the one endpoint where guessing wrong means a second agent on the owner's machine.
    try:
        os.makedirs(state_dir, exist_ok=True)
    except OSError as e:
        return refuse("could not open this loop's state home (%s): %s" % (state_dir, e))

    # The watchdog's OWN lock, held across the whole check-allocate-launch. A live watchdog check
    # owns it for its entire run (its launch subprocess included), so we do not queue behind it —
    # we say so plainly and change nothing. A tap is cheap to repeat; a second debugger is not.
    lock = os.path.join(state_dir, "watchdog.lock")
    try:
        acquired = _watchdog_acquire_lock(lock)
    except OSError as e:
        # The lock is taken by hardlinking a temp file INTO state/, so an existing-but-unwritable
        # state dir raises here — before a single byte of the --json contract has been printed
        # (fresh-agent review round 2). Wrapped at THIS call site, not inside the helper: the
        # watchdog's own acquire is a background job whose loud failure is the right behavior.
        return refuse("could not take this loop's watchdog lock (%s is unwritable): %s"
                      % (state_dir, e))
    if not acquired:
        return refuse("a watchdog check is running for this state home right now — nothing was "
                      "launched; try again in a moment", live=None)
    brief_path = None
    try:
        live = _debug_live_id(state_dir)
        if live is not None:
            return refuse("a debugger session (%s) is already running for this repo — never two "
                          "debuggers on one patient" % live, live=True, live_id=live)

        # NO PANE GATE (issue #308), for the reason the watchdog's identical gate went: the
        # launcher creates a workspace against the session host's server, so there is no anchor to
        # find and nothing to place. Under a login-item runner (#306) none resolves at all — this
        # gate would have made the owner's Debug tap permanently dead on exactly the machine the
        # migration is for, and the dashboard shells this verb from its own non-cmux process.

        try:
            sid = _debug_allocate(os.path.join(state_dir, watchdog_lib.STATE_FILENAME),
                                  home, state_dir)
        except (OSError, ValueError) as e:
            # The counter could not be advanced, so we do NOT hold an id we can prove is ours —
            # launching on one anyway is exactly the reuse this verb exists to prevent.
            return refuse("could not allocate a debugger id (%s is unwritable): %s"
                          % (watchdog_lib.STATE_FILENAME, e))

        brief_path = os.path.join(home, "briefs", "%s.md" % sid)
        try:
            os.makedirs(os.path.join(home, "briefs"), exist_ok=True)
            with open(brief_path, "w") as f:
                f.write(_debug_brief(cfg, home, args.repo, operator, source, args.note, context))
        except OSError as e:
            # open(,"w") CREATES/TRUNCATES before write() runs, so a failure mid-write leaves a
            # partial brief for a session that never launched — which a later reader would read as
            # one that existed (fresh-agent review round 2). Remove it; a no-such-file is fine.
            _rm_quiet(brief_path)
            brief_path = None
            return refuse("could not write the session brief: %s" % e, id=sid)

        # attended=True: a person typed this. It is the only launch in the whole engine that says so.
        rc, out, err, spawned = _debugger_shim_run(cfg, args.repo, home,
                                                   _watchdog_pane(state_dir), sid, attended=True)
        if not spawned:
            # Nothing ever ran: the brief reached no one, so it must not linger (it would read to a
            # later reader as a session that existed). The BURNED id stands — never re-handed out.
            _rm_quiet(brief_path)
    finally:
        _watchdog_release_lock(lock)

    if rc == 0:
        _debug_journal(home, {"act": "debug_launch", "outcome": "launched", "id": sid,
                              "operator": operator, "source": source,
                              "note": _debug_bounded(args.note, _DEBUG_NOTE_MAX, "note")})
        _emit_debug(args, {"ok": True, "verb": "debug", "id": sid, "live": True,
                           "live_id": sid, "brief": brief_path})
        return 0

    error = _debug_error(rc, err, out)
    _debug_journal(home, {"act": "debug_launch", "outcome": "launch_failed", "id": sid,
                          "operator": operator, "source": source, "error": error})
    _emit_debug(args, {"ok": False, "verb": "debug", "id": sid, "live": False, "live_id": None,
                       "error": error})
    return 1


# ------------------------------- resume (issue #298) -------------------------------
#
# Re-enter an interrupted session's CONVERSATION instead of restarting it cold from zero.
#
# The launch stack mints each flight's session id at spawn and records it in lane state
# (state/sessions/<id>) — identity assigned by the runner, never self-asserted. This verb is the
# door that spends that record: it hands the id back to the SAME launch stack as
# SL_RESUME_SESSION_ID, which turns `--session-id <new>` into `--resume <recorded>`.
#
# Deliberately MINIMAL and owner-driven (issue #298 Boundaries): a person decides that a lane is
# worth reviving and types this. Automatic revive policy — who watches for a dead pane, how often,
# with what anti-storm rails — is the herdr epic's territory and is not smuggled in here.
#
# It goes through the launcher rather than around it for the same reason `debug` does: the
# tab, the folder pre-trust, the keystroke-free delivery handshake, the delivery VERIFICATION, the
# worker singleton and the pane/activity records are one contract with one implementation. A
# revive that re-implemented any of them would be a second launch stack with no tests.

_LANE_ID_RE = re.compile(r"^[id][0-9]+$")
# The recorded id is disk state, and disk state is never trusted on shape (the fail-closed rule the
# rest of the engine applies to a wrong-typed status or a numberless PR). claude REFUSES a
# non-UUID, so a corrupt record must be caught here — where the operator gets a sentence — rather
# than inside the launcher where it dies with the tab.
_SESSION_ID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                            r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def _git_read(cwd, *args):
    """`git -C cwd <args>` -> stripped stdout, or None if git could not answer. Fail closed: the
    preamble prints a NAMED unknown rather than a guess, because a revived session that is told
    nothing assumes its stale memory still holds."""
    try:
        r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def _resume_facts(home, iid, session_id, worktree, note):
    """Everything the re-orientation preamble states, RE-READ now (never remembered). Each fact is
    independently optional: a missing worktree, a detached HEAD or a refused GitHub read degrades
    that one line to a named unknown instead of failing the revive — a session resumed with a
    partial map is strictly better than a session not resumed at all."""
    branch = _git_read(worktree, "rev-parse", "--abbrev-ref", "HEAD") if worktree else None
    if branch == "HEAD":                      # detached: not a branch name, do not print one
        branch = None
    head = _git_read(worktree, "rev-parse", "HEAD") if worktree else None
    porcelain = _git_read(worktree, "status", "--porcelain") if worktree else None
    dirty = None if porcelain is None else len([l for l in porcelain.splitlines() if l.strip()])
    facts = {"id": iid, "session_id": session_id, "branch": branch, "worktree": worktree,
             "head": head, "dirty": dirty, "pr": {}, "pr_ok": False, "note": note}
    if branch:
        read = gh.pr_for_branch(branch)
        facts["pr"], facts["pr_ok"] = read.pr, read.ok
    else:
        # No branch to look one up BY. That is an unknown, not a clean "no PR" — same fail-closed
        # rule as a refused lookup: emptiness must never read as an answer.
        facts["pr_ok"] = False
    st = _read_json_file(os.path.join(home, "state", "issues.json"), None)
    if isinstance(st, dict):
        issue = (st.get("issues") or {}).get(iid)
        if isinstance(issue, dict) and issue.get("status"):
            facts["lane_status"] = "%s (as the runner last recorded it)" % issue["status"]
    return facts


def _resume_launch(cfg, repo, home, pane, iid, session_id, worktree):
    """Run the revive through the SAME launcher every other session uses. Returns
    ``(rc, stdout, stderr, spawned)``; never raises. Mirrors _debugger_shim_run's contract.

    This is the FOURTH spawner, and it did not exist when the adoption plan inventoried three
    (#298 added it after that audit). It moved onto the wrapper in the same wave for exactly the
    reason the plan gave for the other two: a spawn path left behind calls a launcher that is no
    longer there, and this one is the operator's own recovery verb."""
    models = cfg.get("models") if isinstance(cfg.get("models"), dict) else {}
    script = _launcher()
    is_worker = iid.startswith("i")
    env = {**os.environ,
           "SL_RUN_ROOT": home, "SL_PANE": pane, "SL_REPO": os.path.abspath(repo),
           "SL_DEV_BRANCH": str(cfg.get("dev_branch", "main")),
           # The model still applies to a resumed conversation. A hand-run revive uses the repo
           # default for the seat — a per-issue `model:*` label is the RUNNER's resolution and is
           # not re-derived here (that precedence ladder has one owner, runner._worker_env).
           "SL_MODEL": str((models.get("worker") if is_worker else models.get("debugger"))
                           or ("" if is_worker else "opus[1m]")),
           "SL_EFFORT": "",
           # THE seam: the launcher passes this straight through as `--resume <id>` instead of
           # minting a fresh `--session-id`. Without it the launch is an ordinary cold start.
           "SL_RESUME_SESSION_ID": session_id,
           "SL_LAUNCH_VERIFY_SECONDS": "30",     # pinned, exactly as _debugger_shim_run pins it
           # PINNED EMPTY (#299) — and this is the call site that needs it MOST. `superlooper
           # resume` is BY DESIGN typed from inside a session, which is precisely the environment
           # that carries a stale SL_EXPECT_GH_LOGIN; inheriting it would let the revive skip the
           # launcher's own identity read and accept that session's second-hand answer as proof of
           # who this machine is now.
           "SL_EXPECT_GH_LOGIN": "",
           # A PERSON typed this, so the PreToolUse deny (#185) must not tell the revived session
           # that nobody is at the pane — the same reasoning as `debug`'s owner tap.
           "SL_ATTENDED": "1",
           "SL_AGENT": cfg.get("agent") if cfg.get("agent") in ("claude", "codex") else "claude"}
    argv = [script, iid] if is_worker else [script, "--cwd", worktree or os.path.abspath(repo), iid]
    try:
        r = subprocess.run(argv, env=env, capture_output=True, text=True,
                           timeout=WATCHDOG_LAUNCH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124, "", "timed out", True
    except (OSError, ValueError):
        return 127, "", "could not run the launch shim", False
    return r.returncode, r.stdout, r.stderr, True


def _emit_resume(args, result):
    if getattr(args, "json", False):
        sys.stdout.write(json.dumps(result) + "\n")
        return
    if result.get("verb") == "resume-check":
        sys.stdout.write("%s can be resumed — session %s\n" % (result.get("id"),
                                                               result.get("session_id"))
                         if result.get("resumable")
                         else "%s cannot be resumed: %s\n" % (result.get("id"),
                                                              result.get("error")))
    elif not result.get("ok"):
        sys.stdout.write("nothing was resumed: %s\n" % result.get("error"))
    else:
        # "launched" and not "resumed": rc=0 from the shim means DELIVERY was verified, which is
        # not the same as the conversation having been re-entered. If the recorded id names no
        # transcript (recorded at spawn, launch never delivered) claude says so in the tab, and
        # this line must not have already claimed otherwise.
        sys.stdout.write("launched %s to resume session %s — watch the tab to confirm it "
                         "re-entered. brief: %s\n"
                         % (result.get("id"), result.get("session_id"), result.get("brief")))


def cmd_resume(args):
    """Re-enter lane <id>'s recorded session after an interruption, with a re-orientation preamble.

    Refuses — launching nothing, writing nothing — when the lane has no recorded session id (it
    predates #298, or never launched), or when a LIVE worker still holds the lane. It used to
    refuse on "no cmux pane resolves" too; issue #308 moved the launch onto the session host, which
    is asked for a workspace rather than told which pane to open a tab in. ``--check`` is the
    read-only preflight."""
    # The FOURTH spawner, and the only one besides the runner that can put an `i<N>` worker on the
    # host (issue #355; `debug` and the watchdog's relaunch are `d<N>`, which `_fence_preflight`
    # exempts by design). It builds its launcher env from `os.environ` — an operator's shell, or
    # the dashboard's — so without this a hand-typed revive on a built fleet machine would fly the
    # one launch class the fence exists to contain, past a gate the machine had already armed.
    _arm_machine_env(announce=False)
    cfg = _load_config(args.repo)
    home = str(config_lib.state_home(cfg))
    state_dir = os.path.join(home, "state")

    def refuse(error, **extra):
        out = {"ok": False, "verb": "resume", "id": getattr(args, "id", None),
               "session_id": None, "error": error}
        out.update(extra)
        _emit_resume(args, out)
        return 1

    iid = (args.id or "").strip()
    # Shape-checked BEFORE the id reaches a path join or the shell: the same fail-closed contract
    # the launcher applies to its own argument, applied here so a bad id is refused before a
    # byte is written rather than deep inside the launcher.
    if not _LANE_ID_RE.match(iid):
        return refuse("'%s' is not a lane id — expected i<N> (an issue worker) or d<N> "
                      "(a debugger session)" % iid)

    # Resume is a Claude Code capability (`--session-id`/`--resume`). Codex has its own
    # `codex resume`, which this engine does not drive, and start-session.sh deliberately does not
    # thread the id into that branch — so on a codex repo a "resume" would silently start a COLD
    # session while telling it that its conversation survived. Refusing is the only honest answer
    # (fresh-agent review P0-2).
    agent = cfg.get("agent") if cfg.get("agent") in ("claude", "codex") else "claude"
    if agent != "claude":
        return refuse("this repo runs the '%s' agent, and resume is a Claude Code capability — a "
                      "'%s' session cannot be re-entered by this engine." % (agent, agent))

    session_id = (_read(os.path.join(state_dir, "sessions", iid)) or "").strip()
    if not session_id:
        return refuse("no recorded session id for %s — it was launched before session identity "
                      "existed, or it never launched. There is no conversation to re-enter; start "
                      "a fresh session instead." % iid)
    if not _SESSION_ID_RE.match(session_id):
        return refuse("the recorded session id for %s is not a UUID (%r) — the record is corrupt, "
                      "and claude would refuse it. Start a fresh session instead."
                      % (iid, session_id[:60]))

    live = _live_lock(os.path.join(state_dir, "worker.%s.lock" % iid))
    if live:
        return refuse("a session is already live for %s — never two agents on one lane. Resume is "
                      "for a lane whose session is GONE." % iid, session_id=session_id)
    worktree = os.path.join(home, "worktrees", iid) if iid.startswith("i") \
        else os.path.abspath(args.repo)
    if not os.path.isdir(worktree):
        # A worker whose worktree was reclaimed has nowhere to be revived: the conversation would
        # resume in a directory that no longer holds its branch.
        return refuse("%s has no working directory at %s — its worktree is gone, so there is "
                      "nothing to resume into." % (iid, worktree), session_id=session_id)

    # NO PANE GATE (issue #308), same reason as `debug` above: the launcher asks the session host
    # for a workspace, so a revive needs no anchor to be born in. It used to gate `--check` too,
    # which meant `resumable` answered a cmux question about a launch that no longer asks one.
    if getattr(args, "check", False):
        # Returns here, ABOVE the debugger lock: --check writes nothing anywhere, and taking a
        # lock is a write (cmd_debug's --check returns above its lock for the same reason).
        _emit_resume(args, {"ok": True, "verb": "resume-check", "id": iid,
                            "session_id": session_id, "resumable": True,
                            "worktree": worktree, "error": None})
        return 0

    # A DEBUGGER lane answers to a second singleton: never two debuggers on one patient, whichever
    # ids they carry (the rule `superlooper debug` enforces). Reviving d3 while d7 is live would
    # put two permissions-bypassed agents in one checkout — the shared-checkout bright line. The
    # `_debug_live_id` read ALONE is not enough, for the reason cmd_debug documents: a just-
    # launched debugger does not hold its worker.d<N>.lock until start-session.sh acquires it in
    # the new tab, up to 30s later, so a resume landing inside a watchdog's launch window would see
    # "nobody home" and launch anyway. Holding the watchdog's OWN lock across the whole
    # check-and-launch is what makes the two mutually exclusive rather than merely polite.
    debug_lock = os.path.join(state_dir, "watchdog.lock") if iid.startswith("d") else None
    if debug_lock:
        try:
            acquired = _watchdog_acquire_lock(debug_lock)
        except OSError as e:
            return refuse("could not take this loop's watchdog lock (%s is unwritable): %s"
                          % (state_dir, e), session_id=session_id)
        if not acquired:
            return refuse("a watchdog check is running for this state home right now — nothing "
                          "was resumed; try again in a moment", session_id=session_id)

    brief_path = os.path.join(home, "briefs", "%s.resume.md" % iid)
    try:
        if debug_lock:
            other = _debug_live_id(state_dir)
            if other is not None:
                return refuse("a debugger session (%s) is already running for this repo — never "
                              "two debuggers on one patient" % other, session_id=session_id)

        note = _debug_bounded(getattr(args, "note", None), _DEBUG_NOTE_MAX, "note")
        facts = _resume_facts(home, iid, session_id, worktree, note)
        # A SEPARATE file from the lane's own brief, never over it: the runner's crash-recovery
        # relaunch re-runs the launcher without rebuilding the brief, so a preamble written to
        # briefs/<id>.md would later open a brand-new, empty session on "your conversation above
        # survived intact" with no work instruction anywhere (fresh-agent review P0-1). Both
        # launchers select this file, and only when SL_RESUME is set.
        try:
            os.makedirs(os.path.join(home, "briefs"), exist_ok=True)
            with open(brief_path, "w") as f:
                f.write(reorient.render(facts))
        except OSError as e:
            # open(,"w") truncates before write(), so a failure mid-write would leave the revived
            # session opening on a half-written preamble — worse than none (as in cmd_debug).
            _rm_quiet(brief_path)
            return refuse("could not write the re-orientation preamble: %s" % e,
                          session_id=session_id)

        rc, out, err, spawned = _resume_launch(cfg, args.repo, home, _watchdog_pane(state_dir),
                                               iid, session_id,
                                               worktree)
    finally:
        if debug_lock:
            _watchdog_release_lock(debug_lock)
    # Remove the preamble only where it PROVABLY reached nobody: `not spawned` (the exec itself
    # failed, as in cmd_debug), or rc=2, which the launcher returns exactly when no worker
    # started within the verify window — and start-session.sh stamps its start sentinel BEFORE it
    # reads the brief, so a missing sentinel proves the brief was never read WITHIN THAT WINDOW.
    # The remainder — a straggler shell that boots after the window, stamps late and then reads —
    # is covered not by the sentinel ordering but by the FAIL-CLOSED brief selection in both
    # launchers: it finds no preamble, exits cleanly, and the runner recovers the lane. Those two
    # changes are load-bearing together; relax the selection back to a fallback and this cleanup
    # silently becomes unsafe again.
    # Deliberately NOT a blanket `rc != 0`: a TIMEOUT (rc=124) is spawned=True precisely because
    # the tab may yet deliver late, and pulling the preamble out from under it would abort that
    # session at the now fail-closed brief selection.
    if not spawned or rc == 2:
        _rm_quiet(brief_path)
    if rc == 0:
        _debug_journal(home, {"act": "resume", "outcome": "resumed", "id": iid,
                              "session_id": session_id,
                              "operator": (args.operator or "").strip() or "the owner",
                              "source": (args.source or "").strip() or "cli"})
        _emit_resume(args, {"ok": True, "verb": "resume", "id": iid, "session_id": session_id,
                            "brief": brief_path})
        return 0
    error = _debug_error(rc, err, out)
    _debug_journal(home, {"act": "resume", "outcome": "resume_failed", "id": iid,
                          "session_id": session_id, "error": error})
    return refuse(error, session_id=session_id)


# ------------------------------- focus-session -------------------------------
# `superlooper focus-session --repo <path> --id i<N>` brings that lane's session window to the
# front. It is the ENGINE's door onto a capability a caller must not hold itself (issue #339, on
# the owner's #310 ruling): the dashboard's open-session-window button rides this verb, and the
# dashboard never names the session host. Reaching the host from a caller would take the binary,
# the control-socket token (#305) and the repo→lane map — the three things
# tests/test_one_session_host_door.py exists to keep in one place.
#
# The decision core is lib/focus (the id→window resolution and the four outcomes); everything here
# is the command line around it: which repo, and how the answer is printed.

def _emit_focus(args, result, repo=None):
    """One JSON object for a UI, or one honest line for a person.

    The split between stdout and stderr is the whole rendering contract in miniature: `no_window`
    prints on STDOUT beside a success, because "that session's window is closed" is an ordinary
    fact about a lane and not a fault. Only a machinery problem — a host that would not answer, a
    repo or id we do not know — goes to stderr.
    """
    if getattr(args, "json", False):
        sys.stdout.write(json.dumps(result.as_dict(repo=repo)) + "\n")
        return
    if result.outcome == focus_lib.FOCUSED:
        # "the host moved its focus", not "it is on your screen": a screen shows it only where a
        # viewer is attached to the session, which is a fact about the machine rather than the lane
        # (fresh-agent review). Over-claiming here is what would send the owner looking for a
        # window on a fleet host nobody is watching.
        sys.stdout.write("%s: the session host moved its focus to that window (%s).\n"
                         % (result.id, result.workspace))
    elif result.outcome == focus_lib.NO_WINDOW:
        sys.stdout.write("%s: nothing to focus — %s\n" % (result.id, result.detail))
    else:
        sys.stderr.write("%s\n" % result.detail)


def cmd_focus_session(args):
    """Bring lane <id>'s session window to the front, and change nothing else anywhere.

    The exit code names the outcome (lib/focus.EXIT_CODES): 0 focused, 3 no window, 4 the host
    could not be reached, 5 unknown repo/id. NOT 2, which stays argparse's — it is also what an
    installed engine too old for this verb exits with on `invalid choice`, and an outcome sharing
    it would hide exactly that diagnosis. A caller that can parse JSON should branch on the
    `outcome` field instead; the codes exist so a shell script does not have to.
    """
    try:
        cfg = _load_config(args.repo)
        home = str(config_lib.state_home(cfg))
    except (OSError, ValueError, KeyError) as e:
        # "That repo is not one we know" — the same class of answer as an unrecognised lane id, and
        # deliberately NOT a traceback: the caller is a UI, and an unadopted directory is a thing an
        # owner can point one at by accident. OSError rather than FileNotFoundError because an
        # unreadable config (a permission bit, a state home on a volume that went away) is the same
        # answer to a caller as an absent one. Deliberately NOT AttributeError, which here would
        # only ever be one of THIS engine's own bugs wearing a repo's costume (fresh-agent review).
        result = focus_lib.Result(focus_lib.UNKNOWN_LANE, (getattr(args, "id", "") or "").strip(),
                                  detail="no loop state for %s: %s" % (args.repo, e))
        _emit_focus(args, result)
        return result.exit_code

    result = focus_lib.focus_lane(home, getattr(args, "id", ""))
    _emit_focus(args, result, repo=cfg.get("repo"))
    return result.exit_code


# ------------------------------- stubs -------------------------------

def _stub(which, wave):
    def run(args):
        print(f"`superlooper {which}` is not implemented yet — it lands in {wave}.",
              file=sys.stderr)
        return 2
    return run


def main(argv=None):
    ap = argparse.ArgumentParser(prog="superlooper", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, description=None, **extra):
        # `description` is what `superlooper <verb> --help` prints above the flags. Optional and
        # None by default, so the verbs that carry their paragraph in the module docstring above
        # are unchanged.
        p = sub.add_parser(name, description=description,
                           formatter_class=argparse.RawDescriptionHelpFormatter)
        p.add_argument("--repo", default=os.getcwd(),
                       help="target repo working copy (default: cwd)")
        for flag, kw in extra.items():
            p.add_argument(flag, **kw)
        p.set_defaults(fn=fn)

    add("run", cmd_run,
        **{"--pane": dict(default=None, help="OVERRIDE the cmux pane that hosts the loop's tabs "
                                             "(default: $SL_PANE, else the pane of the cmux tab "
                                             "this command runs in — no need to set it)"),
           "--agent": dict(default=None, choices=("claude", "codex"),
                           help="coding agent for launched sessions "
                                "(default: config agent, else claude)"),
           "--ticks": dict(type=int, default=None,
                           help="stop after N ticks (testing/simulation)")})
    add("runner-home", cmd_runner_home,
        **{"--install": dict(action="store_true",
                             help="render + place the login-item LaunchAgent (gui/$UID) and print "
                                  "the command that activates it"),
           "--load": dict(action="store_true",
                          help="with --install, also bootstrap the job now"),
           "--verify": dict(action="store_true",
                            help="run the boot preflight and exit — Aqua session, PATH, gh login, "
                                 "session host. Run it INSIDE the job to read the context the "
                                 "runner will actually get")})
    add("fleet", cmd_fleet,
        **{"--install": dict(action="store_true",
                             help="write the fleet's token, runner environment (the file that arms "
                                  "the launch pre-flight), host config, screen-state override, "
                                  "server LaunchAgent and viewer script, then judge the result"),
           "--load": dict(action="store_true",
                          help="with --install, also bootstrap the server job into gui/$UID now"),
           "--agent": dict(default="claude",
                           help="which agent's screen-detection manifest to override "
                                "(default: claude)")})
    add("stop", cmd_stop,
        description=(
            "Stop this repo's runner ON PURPOSE, and make it stay stopped.\n"
            "\n"
            "In the login-item home an exit is not a stop: launchd's KeepAlive restarts a runner\n"
            "that exits cleanly, and the watchdog restarts one that slips past launchd. So this\n"
            "records the stop as deliberate FIRST, then boots the job out of gui/$UID (launchd\n"
            "cannot restart a job it no longer has), then stops the process by its recorded pid.\n"
            "\n"
            "The marker it leaves is the fact both guardians read: the watchdog declines to\n"
            "resurrect, and `superlooper status` says 'stopped by owner' rather than 'crashed'.\n"
            "It is cleared by `superlooper start` — and by any runner that boots, so one stop can\n"
            "never silently disable resurrection forever.\n"
            "\n"
            "Bounded: the job is bootstrapped again at your next LOGIN. This is an off switch for\n"
            "the night, not a way to uninstall the loop."),
        **{"--json": dict(action="store_true",
                          help="emit a single JSON object (for a UI over the loop to parse)"),
           "--operator": dict(default=None,
                              help="who stopped it — recorded in the marker and the journal (audit)"),
           "--source": dict(default=None, help="what asked (audit only; default 'cli')")})
    add("start", cmd_start,
        description=(
            "Clear a deliberate stop and start this repo's runner again — the other half of\n"
            "`superlooper stop`.\n"
            "\n"
            "login-item: the job is bootstrapped back into gui/$UID and this waits for it to\n"
            "report a pid, and only a runner that is provably up clears the stop.\n"
            "\n"
            "pane: a runner there must live in a visible tab a human opened, so this can only hand\n"
            "back the one line to type — and it deliberately leaves the stop STANDING, because it\n"
            "is still true until a runner boots. That runner clears it itself.\n"
            "\n"
            "It refuses BEFORE changing anything when there is no job installed, so a failed start\n"
            "leaves the loop exactly as off as it was."),
        **{"--json": dict(action="store_true",
                          help="emit a single JSON object (for a UI over the loop to parse)"),
           "--operator": dict(default=None, help="who started it — journaled (audit)"),
           "--source": dict(default=None, help="what asked (audit only; default 'cli')")})
    add("status", cmd_status)
    add("adopt", cmd_adopt)
    add("doctor", cmd_doctor,
        **{"--stack": dict(action="store_true",
                           help="check machine-level loop stack prerequisites instead of "
                                "repo-level adoption state")})
    add("nightly", cmd_nightly)
    add("morning-report", cmd_morning_report)
    add("promote-report", cmd_promote_report,
        **{"--use-latest-nightly": dict(action="store_true",
           help="reuse the latest nightly's results instead of running the suite now")})
    add("accept-failure", cmd_accept_failure,
        **{"fingerprint": dict(help="the failure fingerprint from a promotion report"),
           "--note": dict(default=None, help="why this failure is non-blocking (audit note)")})
    add("tidy", cmd_tidy,
        **{"--all": dict(action="store_true",
                         help="also close parked / needs-william / bounced session windows "
                              "(default: only merged — the truly-done sessions)"),
           "--yes": dict(action="store_true", help="skip the y/N confirmation"),
           "--dry-run": dict(action="store_true",
                             help="list the windows tidy would close, then close nothing")})
    add("focus-session", cmd_focus_session,
        description=(
            "Bring ONE lane's session window to the front — the real, live, interactive terminal,\n"
            "so you can watch it and type into it. It is read-only about the FLEET: it never\n"
            "spawns, sends to, exits or kills a session, and it is not a viewer.\n"
            "\n"
            "The lane id selects a window recorded for THIS repo and no other, so an i<N> from one\n"
            "repo can never focus another repo's session.\n"
            "\n"
            "`focused` means the HOST moved its focus to that window; a screen shows it wherever a\n"
            "viewer is attached to the session (see `superlooper fleet`).\n"
            "\n"
            "Outcomes (the `outcome` field with --json; the exit code otherwise):\n"
            "  focused           0  the host brought that window to the front\n"
            "  no_window         3  that lane has no window to raise — its window was closed, or\n"
            "                       it never opened one. An ordinary answer: render it as a fact\n"
            "                       about the lane, never as a failure\n"
            "  host_unreachable  4  the session host could not be reached, or answered in words\n"
            "                       that say nothing about the window (never read as 'the\n"
            "                       session is gone')\n"
            "  unknown_lane      5  that repo is not one we know, or that is not a lane id\n"
            "\n"
            "2 is left to argparse (a usage error, and what an engine too old for this verb exits\n"
            "with) so it can never be mistaken for one of the four above."),
        **{"--id": dict(default=None, metavar="i<N>",
                        help="the lane whose window to raise: i<N> (an issue worker) or d<N> "
                             "(a debugger session)"),
           "--json": dict(action="store_true",
                          help="emit a single JSON object (for a UI over the loop to parse) — "
                               "branch on its `outcome` field, which carries all four answers")})
    add("request-restart", cmd_request_restart,
        **{"--check": dict(action="store_true",
                           help="report whether a live runner exists and write nothing "
                                "(a read-only preflight)"),
           "--json": dict(action="store_true",
                          help="emit a single JSON object (for a UI over the loop to parse)"),
           "--operator": dict(default=None,
                              help="operator name recorded in the request marker (audit)"),
           "--source": dict(default=None,
                            help="who asked (audit only)")})
    # No flags at all, deliberately: `upkeep` is read-only by contract (issue #200 Boundaries), and
    # the shortest way to keep it that way is to give it nothing to turn on. --repo comes from add().
    add("upkeep", cmd_upkeep)
    add("watchdog", cmd_watchdog)
    add("debug", cmd_debug,
        **{"--note": dict(default=None,
                          help="the owner's own words, carried into the session's brief VERBATIM"),
           "--context-file": dict(default=None, metavar="PATH",
                                  help="a file of caller-composed context to frame into the brief "
                                       "('-' reads stdin — a local ops UI pipes what it is showing)"),
           "--check": dict(action="store_true",
                           help="report whether a debugger session is already live and write "
                                "nothing (a read-only preflight)"),
           "--json": dict(action="store_true",
                          help="emit a single JSON object (for a UI over the loop to parse)"),
           "--operator": dict(default=None,
                              help="who tapped — named in the brief and the journal line (audit)"),
           "--source": dict(default=None,
                            help="what asked (audit only; default 'cli')")})
    add("resume", cmd_resume,
        **{"id": dict(help="the lane to revive: i<N> (an issue worker) or d<N> (a debugger)"),
           "--note": dict(default=None,
                          help="a new instruction, placed AFTER the re-orientation so the session "
                               "re-reads the world before acting on it"),
           "--check": dict(action="store_true",
                           help="report whether this lane can be resumed and write nothing "
                                "(a read-only preflight)"),
           "--json": dict(action="store_true",
                          help="emit a single JSON object (for a UI over the loop to parse)"),
           "--operator": dict(default=None, help="who asked — named in the journal line (audit)"),
           "--source": dict(default=None,
                            help="what asked (audit only; default 'cli')")})
    add("janitor", cmd_janitor,
        **{"--dry-run": dict(action="store_true",
                             help="list the proposals and change NOTHING anywhere"),
           "--yes": dict(action="store_true",
                         help="skip the y/N confirmation (still your word — never wire this "
                              "into a schedule)"),
           "--retry-refused": dict(action="store_true",
                                   help="re-propose actions a previous sweep recorded as "
                                        "refused/failed (state/janitor_refused.json)"),
           "--json": dict(action="store_true",
                          help="machine-readable output: print the proposal snapshot as JSON "
                               "and change nothing (the command center drives this)"),
           "--execute-keys": dict(default=None, metavar="k1,k2",
                                  help="execute EXACTLY these approved proposal keys "
                                       "(comma-separated) — the command center's tapped subset; "
                                       "implies --json output")})

    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
