#!/usr/bin/env python3
"""A stand-in for the `superlooper` CLI, driven by a fixture directory — the test harness the
dashboard's local-command adapter (``lib/tidy.py``) runs against so no test ever reaches the REAL
``superlooper`` binary (which closes cmux windows — a stray real call would touch William's live
sessions). The conftest guard already points ``SL_SUPERLOOPER`` at an absent path by default; a
tidy test overrides it in-body to THIS executable.

Point the adapter at it with ``SL_SUPERLOOPER=<path>/fake-superlooper`` and a fixtures dir env —
``SL_TIDY_FIXTURES`` (Tidy) or ``SL_JANITOR_FIXTURES`` (Janitor, issue #121). This models the
subcommand shapes the two local-command buttons drive:

    superlooper tidy --repo <path> --dry-run              → LISTS windows tidy would close
    superlooper tidy --repo <path> --yes                  → CLOSES them (skips the y/N)
    superlooper janitor --repo <path> --json              → PROPOSES GitHub debris as JSON
    superlooper janitor --repo <path> --json --execute-keys k1,k2  → executes that tapped subset

The janitor path prints ``$FIX/propose.json`` / ``$FIX/execute.json`` when present (a test can
inject a fail-closed ``{"ok": false, ...}`` envelope), else a default 3-proposal snapshot / an
ok-per-key result echoing the requested keys, and records a ``janitor_execute`` mutation carrying
the exact keys so a test proves ONLY the tapped subset was sent.

And the Open-session-window button's shell (issue #340; see ``route_focus_session``):

    superlooper focus-session --repo <path> --id i<N> --json   → one of the engine's four outcomes

It also models the Restart button's shell (issue #116; see ``route_request_restart``):

    superlooper request-restart --repo <path> --check --json   → reports live-runner liveness (JSON)
    superlooper request-restart --repo <path> --json           → 'drops the marker' (records a call)

And the Stop/Start button's shell (issue #365 over the engine's #239 verbs; see ``route_stop`` /
``route_start``):

    superlooper stop  --repo <path> --json   → the deliberate off switch's own result body
    superlooper start --repo <path> --json   → the way back on

- ``--dry-run`` prints the contents of ``$SL_TIDY_FIXTURES/dry_run.txt`` when present, else a
  default two-window listing in the REAL CLI's exact print format (``  {id:5} {status:13}
  {surface}``), so ``lib/tidy.parse_windows`` is exercised against the true shape.
- ``--yes`` prints ``$SL_TIDY_FIXTURES/execute.txt`` when present, else a default ``closed N
  window(s).`` line, and records a ``close`` mutation so a test can assert the execute path ran.

Every invocation's full argv (and cwd) is logged to ``$SL_TIDY_FIXTURES/calls.jsonl`` BEFORE any
sleep/fail, so a test can pin the exact contract the adapter produced — that ``--repo`` was the
right checkout, that ``--dry-run`` vs ``--yes`` was chosen correctly, and CRUCIALLY that ``--all``
was NEVER passed (issue #41: merged-only scope; the dashboard never exposes ``--all``).

Fail injection (exercises the adapter's fail-closed paths):
- ``SL_TIDY_SLEEP=<secs>``  makes the call sleep, so a short adapter timeout trips (rc 124 path).
- ``SL_TIDY_FAIL=1``        makes the call exit nonzero with a stderr message (the missing-binary /
                            command-error path — must surface plainly, never a silent success).

Mirrors ``tests/fakes/fake-gh``.
"""
import json
import os
import sys
import time

ARGS = sys.argv[1:]
# One fixtures dir, whichever local-command button set it (Tidy or Janitor). calls.jsonl and
# mutations.jsonl land here for either verb.
FIX = (os.environ.get("SL_TIDY_FIXTURES") or os.environ.get("SL_JANITOR_FIXTURES")
       or os.environ.get("SL_FIXER_FIXTURES") or os.environ.get("SL_FOCUS_FIXTURES") or "")

_DEFAULT_DRY_RUN = (
    "tidy will close 2 finished (merged) session window(s):\n"
    "  i23   merged        cmux:surface-23\n"
    "  i16   merged        (no surface)\n"
    "dry-run: nothing closed.\n"
)
_DEFAULT_EXECUTE = "tidy will close 2 finished (merged) session window(s):\n" \
                   "  i23   merged        cmux:surface-23\n" \
                   "  i16   merged        (no surface)\n" \
                   "closed 2 window(s).\n"

# The default `janitor --json` snapshot: one proposal per debris class, in the CLI's exact
# envelope shape ({"ok", "proposals":[{kind,key,action,target,why(,head|title)}], "held",
# "aged_park_days"}), so lib/janitor.parse_propose / group_proposals run against the true format.
_DEFAULT_PROPOSE = {
    "ok": True,
    "proposals": [
        {"kind": "branch", "key": "branch:sl/i23-old-thing", "action": "delete-branch",
         "target": "sl/i23-old-thing", "why": "PR #40 merged — the work is on the mainline"},
        {"kind": "pr", "key": "pr:41", "action": "close-pr", "target": 41, "head": "sl/i18-x",
         "why": "open but superseded — replaced by a rebuild; the branch stays"},
        {"kind": "issue", "key": "issue:9", "action": "close-issue", "target": 9,
         "title": "flaky retry logic",
         "why": "parked and untouched for 30d (threshold 14d)"},
    ],
    "held": [],
    "aged_park_days": 14,
}


def die(msg, code=1):
    sys.stderr.write("fake-superlooper: %s\n" % msg)
    sys.exit(code)


def fixture(name, default):
    """The contents of ``$SL_TIDY_FIXTURES/<name>`` if present, else ``default``."""
    path = os.path.join(FIX, name)
    if FIX and os.path.isfile(path):
        with open(path) as f:
            return f.read()
    return default


def record(kind, **extra):
    rec = {"kind": kind}
    rec.update(extra)
    with open(os.path.join(FIX, "mutations.jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")


def opt(flag):
    if flag in ARGS:
        i = ARGS.index(flag)
        if i + 1 < len(ARGS):
            return ARGS[i + 1]
    return None


def _janitor():
    """`superlooper janitor --json [--execute-keys k1,k2]`. --execute-keys → the subset executor
    (records a mutation carrying the exact keys, echoes one ok result per key); otherwise the
    machine-readable propose. Exit code tracks the real CLI: nonzero when the envelope is a
    fail-closed refusal (``ok: false``) or when an executed action failed (``failed > 0``)."""
    keys_arg = opt("--execute-keys")
    if keys_arg is not None:
        keys = [k for k in keys_arg.split(",") if k]
        record("janitor_execute", repo=opt("--repo"), keys=keys)
        default = {"ok": True,
                   "results": [{"key": k, "outcome": "ok"} for k in keys],
                   "executed": len(keys), "failed": 0, "skipped": 0, "held": 0}
        out = fixture("execute.json", json.dumps(default))
    else:
        out = fixture("propose.json", json.dumps(_DEFAULT_PROPOSE))
    sys.stdout.write(out)
    try:
        doc = json.loads(out)
    except ValueError:
        doc = {}
    sys.exit(0 if (doc.get("ok") and not doc.get("failed")) else 1)


def route():
    if ARGS[:1] == ["janitor"]:
        _janitor()
        return
    if ARGS[:1] == ["request-restart"]:
        route_request_restart()
        return
    if ARGS[:1] == ["stop"]:
        route_stop()
        return
    if ARGS[:1] == ["start"]:
        route_start()
        return
    if ARGS[:1] == ["debug"]:
        route_debug()
        return
    if ARGS[:1] == ["focus-session"]:
        route_focus_session()
        return
    if ARGS[:1] != ["tidy"]:
        die("unhandled command: %s" % " ".join(ARGS))
    if "--dry-run" in ARGS:
        sys.stdout.write(fixture("dry_run.txt", _DEFAULT_DRY_RUN))
        sys.exit(0)
    # --yes (or a bare tidy) → the execute path. Record it so a test can assert the close ran.
    record("tidy_execute", repo=opt("--repo"), yes=("--yes" in ARGS), all=("--all" in ARGS))
    sys.stdout.write(fixture("execute.txt", _DEFAULT_EXECUTE))
    sys.exit(0)


def route_request_restart():
    """Model the real `superlooper request-restart --json` contract the dashboard's ``lib/restart``
    parses (issue #116). ``SL_RESTART_RUNNING=0`` simulates no live runner (the dead-runner refuse);
    ``SL_RESTART_GARBAGE=1`` prints non-JSON so a test can exercise the adapter's unparseable path.
    ``--check`` reports liveness and writes nothing; the plain form 'writes the marker' (recorded as
    a mutation so a test can assert the request landed, with its audit fields).

    ``SL_RESTART_HOME`` (``pane``, the default, or ``login-item``) selects which runner home the
    engine is answering for (issue #306). The real CLI branches on the repo's ``runner_home`` config
    key and emits a home-correct ``how`` (what a restart DOES) and ``manual`` (the remedy when
    nothing is live) — the two fields that let the dashboard's dialog tell the truth without knowing
    which home it is looking at. Both spellings are modelled verbatim from ``cmd_request_restart``
    so the dashboard's dependency on them is pinned by a test rather than assumed."""
    if os.environ.get("SL_RESTART_GARBAGE"):
        sys.stdout.write("not json — the CLI misbehaved\n")
        sys.exit(0)
    running = os.environ.get("SL_RESTART_RUNNING", "1") != "0"
    repo = opt("--repo") or ""
    if os.environ.get("SL_RESTART_HOME") == "login-item":
        manual = ("restart the login-item job: kickstart -k gui/501/"
                  "com.superlooper.runner.will-titan-command-center")
        how = "exit cleanly and be restarted by its supervisor"
    else:
        manual = "open a cmux tab and run: superlooper run --repo %s" % repo
        how = "restart itself in its own cmux tab"
    pid = 4242 if running else None
    if "--check" in ARGS:
        out = {"ok": True, "verb": "request-restart", "running": running, "pid": pid,
               "requested": False, "manual": manual, "how": how}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.exit(0)
    if not running:
        out = {"ok": False, "verb": "request-restart", "running": False, "pid": None,
               "requested": False, "manual": manual, "how": how,
               "error": "no runner is live for this repo — nothing to restart"}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.exit(1)
    record("restart_request", repo=repo, operator=opt("--operator"), source=opt("--source"))
    out = {"ok": True, "verb": "request-restart", "running": True, "pid": pid,
           "requested": True, "manual": manual, "how": how}
    sys.stdout.write(json.dumps(out) + "\n")
    sys.exit(0)


# ------------------------- the Stop/Start verbs (issues #239 / #365) -------------------------
# The engine's deliberate off switch and the way back on. Every field below is copied from
# `cmd_stop` / `cmd_start`'s own result dicts so the dashboard's adapter is exercised against the
# TRUE contract — including the property the whole button rests on: a stop that did NOT take is a
# well-formed body at a nonzero exit, never a crash, and it must never render as an all-clear.
_JOB = "com.superlooper.runner.will-titan-command-center"
_DOMAIN = "gui/501"
_MARKER = "/nonexistent/state-home/state/runner.stopped"


def _stop_base(repo, home):
    return {"ok": True, "verb": "stop", "home": home, "was_running": True, "pid": 4242,
            "job": _JOB if home == "login-item" else None,
            "domain": _DOMAIN if home == "login-item" else None,
            "held": True, "job_state": "gone" if home == "login-item" else None,
            "job_pid": None, "process_gone": True, "signal_refused": None, "marker": _MARKER,
            "start": "superlooper start --repo %s" % repo}


def route_stop():
    """Model `superlooper stop --repo <path> --json` (issue #239). ``SL_STOP_HOME`` picks the runner
    home (``login-item`` default, ``pane``); ``SL_STOP_OUTCOME`` picks which of the verb's real
    outcomes is answered; ``SL_STOP_GARBAGE=1`` prints non-JSON for the adapter's unparseable path.

    Recorded as a mutation so a test can prove the tap reached the CLI with its audit fields — and,
    on the failure outcomes, that it reached it and STILL did not claim success."""
    if os.environ.get("SL_STOP_GARBAGE"):
        sys.stdout.write("not json — the CLI misbehaved\n")
        sys.exit(0)
    repo = opt("--repo") or ""
    home = os.environ.get("SL_STOP_HOME") or "login-item"
    outcome = os.environ.get("SL_STOP_OUTCOME") or "stopped"
    out = _stop_base(repo, home)
    if outcome == "recorded":
        # The DESIGNED clean stop in the long-tick case: the job is gone, the process is finishing
        # its tick. The engine exits 0 — this is a success that is not yet a completed one.
        out.update(process_gone=False)
    elif outcome == "no_runner":
        out.update(was_running=False, pid=None, process_gone=True)
    elif outcome == "not_held":
        # launchd still HAS the job → it can restart it → this is not a stop, and it exits 1.
        out.update(ok=False, held=False, job_state="loaded", process_gone=False,
                   error="%s is still loaded in %s, so launchd can restart it, so this is not a stop"
                         % (_JOB, _DOMAIN),
                   remedy="run it again, or boot the job out by hand")
    elif outcome == "marker_failed":
        # Refused BEFORE taking anything down: nothing stopped and nothing recorded.
        out.update(ok=False, held=False, process_gone=False, marker=None, job_state=None,
                   error="the deliberate-stop marker could not be written (read-only file system), "
                         "so nothing was taken down — a stop the guardians cannot read is a crash "
                         "to them",
                   remedy="fix the state home at /nonexistent/state-home/state, then re-run")
    record("runner_stop", repo=repo, operator=opt("--operator"), source=opt("--source"))
    sys.stdout.write(json.dumps(out) + "\n")
    sys.exit(0 if out["ok"] else 1)


def route_start():
    """Model `superlooper start --repo <path> --json` (issue #239) — the other half. ``started`` is
    the field a UI branches on: True only when something is PROVABLY running, which is why the pane
    home answers ok/started:false with a ``manual`` line and a stop that deliberately still stands.
    ``SL_START_OUTCOME`` picks the outcome; ``SL_START_GARBAGE=1`` exercises the unparseable path."""
    if os.environ.get("SL_START_GARBAGE"):
        sys.stdout.write("not json — the CLI misbehaved\n")
        sys.exit(0)
    repo = opt("--repo") or ""
    outcome = os.environ.get("SL_START_OUTCOME") or "started"
    home = "pane" if outcome in ("manual", "pane_live") else "login-item"
    out = {"ok": True, "verb": "start", "home": home, "cleared": True, "started": True,
           "job": _JOB, "domain": _DOMAIN, "pid": 4242, "job_loaded": True,
           "already_running": False, "manual": None}
    if outcome == "already_running":
        out.update(already_running=True)
    elif outcome == "manual":
        # The pane home cannot start anything (automated tab placement is owner-ruled out), so it
        # hands back the one line to type and LEAVES the recorded stop standing.
        out.update(cleared=False, started=False, job=None, domain=None, pid=None, job_loaded=None,
                   manual="now start the runner in a visible cmux tab: superlooper run --repo %s"
                          " — the stop clears when it boots" % repo)
    elif outcome == "live_unconfirmed":
        # A runner IS live, but launchd could not be asked whether its job is loaded — so `start`
        # acts on nothing, because the only way to act on that guess is a `kickstart -k` that would
        # kill the running runner. `started` is false and the loop is nonetheless UP: the one
        # outcome where those two facts come apart.
        out.update(started=False, already_running=True, job_loaded=None,
                   manual="a runner is live (pid 4242), but launchd could not be asked whether its "
                          "job is loaded — nothing was started, because the only way to act on that "
                          "guess is to restart the job, and `kickstart -k` would kill this runner.")
    elif outcome == "no_job":
        out.update(ok=False, cleared=False, started=False, pid=None, job_loaded=None,
                   error="no LaunchAgent is installed for this repo at "
                         "/nonexistent/LaunchAgents/%s.plist" % _JOB,
                   remedy="install it first: superlooper runner-home --repo %s --install --load"
                          % repo)
    elif outcome == "latched":
        # The one bookkeeping failure that must reach the caller: the runner is up but the off
        # switch will not come off, so the watchdog stays stood down over a live runner.
        out.update(ok=False, started=False, cleared=False,
                   error="the runner is up, but the deliberate-stop marker could not be removed "
                         "(read-only file system) — while it is there the watchdog will not "
                         "restart this runner",
                   remedy="delete it by hand: %s" % _MARKER)
    record("runner_start", repo=repo, operator=opt("--operator"), source=opt("--source"))
    sys.stdout.write(json.dumps(out) + "\n")
    sys.exit(0 if out["ok"] else 1)


def route_debug():
    """Model the real `superlooper debug --json` contract ``lib/fixer`` parses (issue #144) — the
    ENGINE's owner-tap debugger launch, which owns the id allocation, the single-flight lock, the
    brief and the launch handshake. The dashboard only shells it, so this fake is the whole of what
    a fixer test may see of a launch.

    ``SL_DEBUG_LIVE=d3`` simulates a debugger already on this patient (the engine's refusal);
    ``SL_DEBUG_FAIL=1`` simulates a launch that did not land; ``SL_DEBUG_GARBAGE=1`` prints non-JSON
    so a test can exercise the adapter's unparseable path. ``--check`` reports liveness and writes
    nothing; the plain form records a mutation carrying the note, the audit fields and the CONTEXT
    the dashboard piped in, so a test can prove the owner's words reached the engine verbatim."""
    if os.environ.get("SL_DEBUG_GARBAGE"):
        sys.stdout.write("not json — the CLI misbehaved\n")
        sys.exit(0)
    live = os.environ.get("SL_DEBUG_LIVE") or ""
    if "--check" in ARGS:
        out = {"ok": True, "verb": "debug-check", "id": None,
               "live": bool(live), "live_id": live or None}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.exit(0)
    # Drain stdin exactly as the real verb does for `--context-file -`, so a test can assert what
    # the dashboard piped over (and so a large context can never deadlock the adapter).
    context = sys.stdin.read() if opt("--context-file") == "-" else ""
    if live:
        out = {"ok": False, "verb": "debug", "id": None, "live": True, "live_id": live,
               "error": "a debugger session (%s) is already running for this repo — never two "
                        "debuggers on one patient" % live}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.exit(1)
    record("debug_launch", repo=opt("--repo"), note=opt("--note"), context=context,
           operator=opt("--operator"), source=opt("--source"))
    if os.environ.get("SL_DEBUG_FAIL"):
        out = {"ok": False, "verb": "debug", "id": "d4", "live": False, "live_id": None,
               "error": "the launch timed out — no session was confirmed"}
        sys.stdout.write(json.dumps(out) + "\n")
        sys.exit(1)
    out = {"ok": True, "verb": "debug", "id": "d4", "live": True, "live_id": "d4",
           "brief": "/nonexistent/home/briefs/d4.md"}
    sys.stdout.write(json.dumps(out) + "\n")
    sys.exit(0)


# The engine's four outcomes, each with the REAL detail sentence `superlooper focus-session --json`
# prints for it (skill/lib/focus.py + skill/lib/session_host.py) and the REAL exit code
# (focus.EXIT_CODES). Copied verbatim so lib/session_window is exercised against the true contract
# — including the property the dashboard leans on hardest: `no_window` is an ordinary answer with an
# explanatory sentence, not an error string.
_FOCUS_DETAIL = {
    "focused": "the host moved its focus to workspace ws-340; a viewer attached to this session "
               "follows it",
    "no_window": "no session window is recorded for %s — it has not launched, its session ended, "
                 "or `superlooper tidy` closed the window",
    "host_unreachable": "could not ask the host to focus workspace ws-340 (rc=1; unauthorized)",
    "unknown_lane": "no loop state for %s: [Errno 2] no such file or directory",
}
_FOCUS_EXIT = {"focused": 0, "no_window": 3, "host_unreachable": 4, "unknown_lane": 5}


def route_focus_session():
    """Model the real `superlooper focus-session --repo <path> --id i<N> --json` contract
    ``lib/session_window`` parses (issue #340) — the ENGINE's read-only door onto one lane's session
    window (issue #339). The dashboard only shells it and never names a session host, so this fake
    is the whole of what a session-window test may see of a window.

    ``SL_FOCUS_OUTCOME`` picks which of the four the engine answers (default ``focused``);
    ``SL_FOCUS_GARBAGE=1`` prints non-JSON so a test can exercise the unparseable path; and
    ``SL_FOCUS_UNKNOWN_VERB=1`` models an INSTALLED engine that predates the verb — argparse's
    `invalid choice` on stderr, rc 2, and no JSON at all, which is the publish-drift case the
    dashboard has to name rather than mistake for an unknown lane.
    """
    if os.environ.get("SL_FOCUS_UNKNOWN_VERB"):
        sys.stderr.write("usage: superlooper [-h] {run,adopt,tidy,janitor} ...\n"
                         "superlooper: error: argument cmd: invalid choice: 'focus-session'\n")
        sys.exit(2)
    if os.environ.get("SL_FOCUS_GARBAGE"):
        sys.stdout.write("not json — the CLI misbehaved\n")
        sys.exit(0)
    outcome = os.environ.get("SL_FOCUS_OUTCOME") or "focused"
    iid = opt("--id") or ""
    detail = _FOCUS_DETAIL.get(outcome, "")
    if "%s" in detail:
        detail = detail % (opt("--repo") if outcome == "unknown_lane" else iid)
    out = {"ok": outcome == "focused", "verb": "focus-session", "id": iid, "outcome": outcome,
           "workspace": "ws-340" if outcome in ("focused", "host_unreachable") else None,
           "repo": "will-titan/command-center", "detail": detail}
    sys.stdout.write(json.dumps(out) + "\n")
    sys.exit(_FOCUS_EXIT.get(outcome, 1))


def main():
    if FIX:
        with open(os.path.join(FIX, "calls.jsonl"), "a") as f:
            f.write(json.dumps({"argv": ARGS, "cwd": os.getcwd()}) + "\n")
    sleep = (os.environ.get("SL_TIDY_SLEEP") or os.environ.get("SL_JANITOR_SLEEP")
             or os.environ.get("SL_FOCUS_SLEEP"))
    if sleep:
        time.sleep(float(sleep))
    if (os.environ.get("SL_TIDY_FAIL") or os.environ.get("SL_JANITOR_FAIL")
            or os.environ.get("SL_FOCUS_FAIL")):
        die("forced failure")
    route()


if __name__ == "__main__":
    main()
