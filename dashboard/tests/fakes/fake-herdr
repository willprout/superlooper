#!/usr/bin/env python3
"""A stand-in for the `herdr` CLI — the session host the Open-session-window button drives
(issue #310).

No test may reach the REAL `herdr`: it drives William's own live herd (focusing a window, and
every other verb behind the same socket), so a stray call would reach across from the test suite
into the machine he is working on. The conftest guard points ``SL_HERDR`` at an absent path by
default; a session-window test overrides it in-body to THIS executable.

It models exactly the one verb the dashboard's host doorway spells:

    herdr agent focus <name>     → focus that agent's window (rc 0), or a named error (rc 1)

Behaviour, chosen so the adapter's honest-failure paths are all reachable:

- ``agent focus i999`` exits 1 with ``error: agent_not_found: i999`` on stderr — exactly the
  shape herdr answers with for a name that no longer resolves (an agent that exited, or a
  session that was never launched). This is the case the button hits most often, so it is the
  one the fake makes easy to drive.
- ``agent focus i1`` sleeps for ``SL_HERDR_SLEEP`` seconds (default 5) so a short adapter
  timeout trips its rc-124 path.
- anything else exits 0 and echoes its own argv on stdout, so a test can pin the exact verb
  spelling the adapter produced rather than trusting a comment.

Every invocation's full argv is echoed, never logged to a file: this fake has no fixture
directory because the verb has no output to fixture — the argv IS the contract.
"""
import os
import sys
import time


def main(argv):
    args = argv[1:]
    if args[:2] == ["agent", "focus"]:
        name = args[2] if len(args) > 2 else ""
        if name == "i1":
            time.sleep(float(os.environ.get("SL_HERDR_SLEEP", "5")))
        if name == "i999":
            sys.stderr.write("error: agent_not_found: %s\n" % name)
            return 1
    sys.stdout.write(" ".join(args) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
